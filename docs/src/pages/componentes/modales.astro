<script>
  // Surface switcher
  const switcher = document.getElementById('surfaceSwitcher');
  if (switcher) {
    switcher.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-surface]');
      if (!btn) return;
      const surface = btn.dataset.surface;
      document.querySelectorAll('.dg-modal').forEach(modal => {
        modal.classList.remove('is-solid');
        if (surface === 'solid') modal.classList.add('is-solid');
      });
    });
  }

  // Positioned modal
  const mdPos = document.getElementById('mdPos');
  if (mdPos && window.dgarz) {
    document.querySelectorAll('[data-pos]').forEach(btn => {
      btn.addEventListener('click', () => {
        const pos = btn.getAttribute('data-pos');
        mdPos.className = 'dg-modal-backdrop' + (pos !== 'center' ? ' dg-pos-' + pos : '');
        document.getElementById('mdPosTitle').textContent =
          'Modal ' + ({center:'centrado',top:'superior',bottom:'inferior',left:'a la izquierda',right:'a la derecha'}[pos]);
        window.dgarz.openOverlay(mdPos);
      });
    });
  }

  // Status modal
  const statusMap = {
    success: { title: 'Operación exitosa', body: 'Todo salió bien. Puedes continuar.',          use: '#dg-check' },
    warning: { title: 'Revisa esto',       body: 'Hay algo que requiere tu atención.',           use: '#dg-alert-tri' },
    danger:  { title: 'Algo falló',        body: 'No pudimos completar la acción.',              use: '#dg-x' },
    info:    { title: 'Buenas noticias',   body: 'Una actualización con mejoras está disponible.',use: '#dg-info' }
  };
  const mdStatus = document.getElementById('mdStatus');
  const glowEffectSeg = document.getElementById('glowEffectSeg');
  let glowEffect = 'dg-modal-glow';
  if (glowEffectSeg) {
    glowEffectSeg.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-effect]');
      if (!btn) return;
      glowEffectSeg.querySelectorAll('button').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      glowEffect = btn.getAttribute('data-effect');
    });
  }
  if (mdStatus && window.dgarz) {
    document.querySelectorAll('[data-status]').forEach(btn => {
      btn.addEventListener('click', () => {
        const s = btn.getAttribute('data-status'), c = statusMap[s];
        document.getElementById('mdStatusCard').className = 'dg-modal dg-modal-sm dg-modal-accent ' + glowEffect + ' is-' + s;
        document.getElementById('mdStatusAccept').className = 'dg-btn dg-btn-' + s;
        const ic = document.getElementById('mdStatusIcon');
        ic.className = 'dg-modal-icon is-' + s;
        ic.querySelector('use').setAttribute('href', c.use);
        document.getElementById('mdStatusTitle').textContent = c.title;
        document.getElementById('mdStatusBody').textContent = c.body;
        window.dgarz.openOverlay(mdStatus);
      });
    });
  }

  // Onboarding stepper
  const steps = [
    { icon: '#dg-star',   step: 'Paso 1 de 3', title: 'Te damos la bienvenida',  text: 'dgarz design te ayuda a construir interfaces sobrias y consistentes en minutos.' },
    { icon: '#dg-folder', step: 'Paso 2 de 3', title: 'Organiza tu trabajo',     text: 'Agrupa componentes y reutiliza tus tokens en cualquier proyecto.' },
    { icon: '#dg-check',  step: 'Paso 3 de 3', title: 'Todo listo',              text: 'Ya puedes empezar a crear. Encuentra todo en la documentación.' }
  ];
  let idx = 0;
  const obNext = document.getElementById('onboardNext');
  function renderOnboard() {
    const s = steps[idx];
    document.querySelector('#onboardIcon use').setAttribute('href', s.icon);
    document.getElementById('onboardStep').textContent = s.step;
    document.getElementById('onboardTitle').textContent = s.title;
    document.getElementById('onboardText').textContent = s.text;
    document.querySelectorAll('#onboardDots i').forEach((d, i) => d.classList.toggle('is-active', i === idx));
    obNext.textContent = idx === steps.length - 1 ? 'Finalizar' : 'Siguiente';
  }
  if (obNext && window.dgarz) {
    document.querySelector('[data-dg-open="#mdOnboard"]')
      ?.addEventListener('click', () => { idx = 0; renderOnboard(); });
    obNext.addEventListener('click', () => {
      if (idx < steps.length - 1) { idx++; renderOnboard(); }
      else window.dgarz.closeOverlay(document.getElementById('mdOnboard'));
    });
  }

  // dgConfirm / dgAlert / dgPrompt
  const jsOut = document.getElementById('jsConfirmOut');
  if (jsOut && window.dgarz) {
    document.getElementById('jsConfirmBtn')?.addEventListener('click', async () => {
      const ok = await window.dgarz.dgConfirm({
        title: '¿Eliminar proyecto?',
        text: 'Esta acción es permanente y no se puede deshacer.',
        icon: 'danger',
        confirmText: 'Eliminar',
      });
      jsOut.textContent = 'Resultado: ' + ok;
    });
    document.getElementById('jsAlertBtn')?.addEventListener('click', async () => {
      await window.dgarz.dgAlert({ title: 'Guardado', text: 'Los cambios se guardaron correctamente.', icon: 'success' });
      jsOut.textContent = 'Resultado: cerrado';
    });
    document.getElementById('jsPromptBtn')?.addEventListener('click', async () => {
      const nombre = await window.dgarz.dgPrompt({ title: 'Renombrar', inputValue: 'Proyecto actual', inputPlaceholder: 'Nuevo nombre' });
      jsOut.textContent = 'Resultado: ' + JSON.stringify(nombre);
    });
    document.getElementById('jsPreConfirmBtn')?.addEventListener('click', async () => {
      const ok = await window.dgarz.dgConfirm({
        title: 'Guardar cambios',
        text: 'Simula una llamada al servidor (900ms).',
        confirmText: 'Guardar',
        preConfirm: () => new Promise((resolve) => setTimeout(resolve, 900)),
      });
      jsOut.textContent = 'Resultado: ' + ok;
    });
  }
</script>
