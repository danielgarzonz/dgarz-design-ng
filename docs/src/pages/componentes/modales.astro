---
import Layout from "../../layouts/DocsLayout.astro";
---

<!--
  NOTE FOR MAINTAINERS:
  The modal backdrop HTML lives at the bottom of this file (below <Layout>),
  outside the content slot. Add new modals there, not inside pageContent.
-->

<Layout
  title="Modales"
  lead="Diálogos accesibles con header, body y footer. Variantes, posiciones y estados."
  currentHref="/componentes/modales"
>
  <Fragment set:html={`
      <div class="dg-flex dg-items-center dg-gap-4 dg-mb-6">
        <span class="dg-text-sm dg-fw-medium">Estilo de superficie</span>
        <div class="dg-segmented" id="surfaceSwitcher" data-dg-segmented>
          <button class="is-active" data-surface="glass">Glass</button>
          <button data-surface="solid">Sólido</button>
        </div>
      </div>

      <div class="dg-callout dg-callout-info dg-measure-md dg-mb-5">
        <p class="dg-callout-title">Cómo funciona</p>
        El modal tiene dos partes HTML necesarias:<br><br>
        <strong>1. <code class="dg-code">.dg-modal-backdrop</code></strong> — el overlay oscuro que cubre la pantalla (lleva el <code class="dg-code">id</code>).<br>
        <strong>2. <code class="dg-code">.dg-modal</code></strong> — el diálogo en sí, hijo del backdrop.<br><br>
        Para abrir el modal, cualquier elemento con <code class="dg-code">data-dg-open="#id"</code> lo hace funcionar sin escribir JavaScript.
        Para cerrarlo, usa <code class="dg-code">data-dg-close</code> en el botón cancelar o la X.
      </div>

      <div class="doc-sub">1. Modal básico</div>
      <div class="doc-demo is-plain">
        <div class="dg-cluster">
          <button class="dg-btn" data-dg-open="#jsModal">Abrir modal</button>
          <button class="dg-btn dg-btn-ghost" data-dg-open="#mdForm">Con formulario</button>
        </div>
      </div>
      <div class="doc-code" data-code-source="manual"><button class="cp">Copiar</button><pre>&lt;button class="dg-btn" data-dg-open="#mi-modal"&gt;Abrir modal&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost" data-dg-open="#mi-form"&gt;Con formulario&lt;/button&gt;

&lt;!-- Modal básico --&gt;
&lt;div class="dg-modal-backdrop" id="mi-modal" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;div class="dg-modal-header"&gt;
      &lt;h3 class="dg-modal-title"&gt;Título&lt;/h3&gt;
    &lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Contenido aquí.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn" data-dg-close&gt;Confirmar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Modal con formulario --&gt;
&lt;div class="dg-modal-backdrop" id="mi-form" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal dg-modal-xl" role="dialog" aria-modal="true"&gt;
    &lt;div class="dg-modal-header dg-modal-header-row"&gt;
      &lt;h3 class="dg-modal-title"&gt;Nuevo cliente&lt;/h3&gt;
      &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;
      &lt;div class="dg-row"&gt;
        &lt;div class="dg-col-12 dg-col-md-6"&gt;
          &lt;div class="dg-field dg-mb-4"&gt;
            &lt;label class="dg-label" for="nombre"&gt;Nombre&lt;/label&gt;
            &lt;input id="nombre" class="dg-input" placeholder="Ana Rivas" /&gt;
          &lt;/div&gt;
          &lt;div class="dg-field dg-mb-4"&gt;
            &lt;label class="dg-label" for="correo"&gt;Correo&lt;/label&gt;
            &lt;input id="correo" class="dg-input" type="email" placeholder="ana@correo.com" /&gt;
          &lt;/div&gt;
          &lt;div class="dg-field"&gt;
            &lt;label class="dg-label" for="plan"&gt;Plan&lt;/label&gt;
            &lt;select id="plan" class="dg-select"&gt;
              &lt;option&gt;Free&lt;/option&gt;
              &lt;option&gt;Pro&lt;/option&gt;
              &lt;option&gt;Studio&lt;/option&gt;
            &lt;/select&gt;
          &lt;/div&gt;
        &lt;/div&gt;
        &lt;div class="dg-col-12 dg-col-md-6"&gt;
          &lt;div class="dg-field dg-mb-4"&gt;
            &lt;label class="dg-label" for="tel"&gt;Teléfono&lt;/label&gt;
            &lt;input id="tel" class="dg-input" placeholder="+52 55 1234 5678" /&gt;
          &lt;/div&gt;
          &lt;div class="dg-field"&gt;
            &lt;label class="dg-label" for="notas"&gt;Notas&lt;/label&gt;
            &lt;textarea id="notas" class="dg-textarea" placeholder="Observaciones…"&gt;&lt;/textarea&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn" data-dg-close&gt;Crear cliente&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>

      <div class="doc-sub">2. Tamaños</div>
      <div class="doc-demo is-plain">
        <div class="dg-cluster">
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#mdSm">Pequeño (360px)</button>
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#jsModal">Estándar (460px)</button>
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#mdLg">Grande (640px)</button>
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#mdForm">Extra (840px)</button>
        </div>
      </div>
      <div class="doc-code" data-code-source="manual"><button class="cp">Copiar</button><pre>&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-sm"&gt;Pequeño (360px)&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-md"&gt;Estándar (460px)&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-lg"&gt;Grande (640px)&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-xl"&gt;Extra (840px)&lt;/button&gt;

&lt;!-- Pequeño: 360px --&gt;
&lt;div class="dg-modal-backdrop" id="modal-sm" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal dg-modal-sm" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;div class="dg-modal-header"&gt;&lt;h3 class="dg-modal-title"&gt;Modal pequeño&lt;/h3&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Ideal para mensajes breves.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;&lt;button class="dg-btn" data-dg-close&gt;Entendido&lt;/button&gt;&lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Estándar: 460px (default, sin clase extra) --&gt;
&lt;div class="dg-modal-backdrop" id="modal-md" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;div class="dg-modal-header"&gt;&lt;h3 class="dg-modal-title"&gt;Modal estándar&lt;/h3&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Tamaño por defecto.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn" data-dg-close&gt;Aceptar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Grande: 640px --&gt;
&lt;div class="dg-modal-backdrop" id="modal-lg" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal dg-modal-lg" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;div class="dg-modal-header"&gt;&lt;h3 class="dg-modal-title"&gt;Modal grande&lt;/h3&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Más espacio para contenido extenso.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn" data-dg-close&gt;Guardar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Extra: 840px --&gt;
&lt;div class="dg-modal-backdrop" id="modal-xl" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal dg-modal-xl" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;div class="dg-modal-header"&gt;&lt;h3 class="dg-modal-title"&gt;Modal extra&lt;/h3&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Ideal para formularios o tablas amplias.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn" data-dg-close&gt;Guardar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>

      <div class="doc-sub">3. Confirmación con icono</div>
      <div class="doc-demo is-plain">
        <button class="dg-btn dg-btn-danger" data-dg-open="#mdConfirm">Eliminar proyecto</button>
      </div>
      <div class="doc-code" data-code-source="manual"><button class="cp">Copiar</button><pre>&lt;button class="dg-btn dg-btn-danger" data-dg-open="#mi-confirm"&gt;Eliminar proyecto&lt;/button&gt;

&lt;div class="dg-modal-backdrop" id="mi-confirm" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal dg-modal-sm dg-modal-confirm" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;…&lt;/button&gt;
    &lt;span class="dg-modal-icon is-danger"&gt;…&lt;/span&gt;
    &lt;div class="dg-modal-header"&gt;
      &lt;h3 class="dg-modal-title"&gt;¿Eliminar proyecto?&lt;/h3&gt;
    &lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Esta acción es permanente y no se puede deshacer.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn dg-btn-danger" data-dg-close&gt;Eliminar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>

      <div class="doc-sub">4. Modal posicionado</div>
      <div class="doc-demo is-plain">
        <div class="dg-cluster">
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-pos="center">Centro</button>
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-pos="top">Superior</button>
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-pos="bottom">Inferior</button>
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-pos="left">Izquierda</button>
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-pos="right">Derecha</button>
        </div>
      </div>
      <div class="doc-code" data-code-source="manual"><button class="cp">Copiar</button><pre>&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-center"&gt;Centro&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-top"&gt;Superior&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-bottom"&gt;Inferior&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-left"&gt;Izquierda&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-right"&gt;Derecha&lt;/button&gt;

&lt;!-- Centro (por defecto) --&gt;
&lt;div class="dg-modal-backdrop" id="modal-center" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;div class="dg-modal-header"&gt;&lt;h3 class="dg-modal-title"&gt;Modal centrado&lt;/h3&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Aparece en el centro de la pantalla.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn" data-dg-close&gt;Aceptar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Superior --&gt;
&lt;div class="dg-modal-backdrop dg-pos-top" id="modal-top" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal dg-modal-bar" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;div class="dg-modal-header"&gt;&lt;h3 class="dg-modal-title"&gt;Modal superior&lt;/h3&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Aparece en la parte superior.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn" data-dg-close&gt;Aceptar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Inferior --&gt;
&lt;div class="dg-modal-backdrop dg-pos-bottom" id="modal-bottom" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal dg-modal-bar" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;div class="dg-modal-header"&gt;&lt;h3 class="dg-modal-title"&gt;Modal inferior&lt;/h3&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Aparece en la parte inferior.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn" data-dg-close&gt;Aceptar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Izquierda --&gt;
&lt;div class="dg-modal-backdrop dg-pos-left" id="modal-left" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal dg-modal-bar" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;div class="dg-modal-header"&gt;&lt;h3 class="dg-modal-title"&gt;Modal izquierda&lt;/h3&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Aparece en el lateral izquierdo.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn" data-dg-close&gt;Aceptar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Derecha --&gt;
&lt;div class="dg-modal-backdrop dg-pos-right" id="modal-right" data-dg-backdrop="" hidden&gt;
  &lt;div class="dg-modal dg-modal-bar" role="dialog" aria-modal="true"&gt;
    &lt;button class="dg-modal-close" data-dg-close aria-label="Cerrar"&gt;&lt;/button&gt;
    &lt;div class="dg-modal-header"&gt;&lt;h3 class="dg-modal-title"&gt;Modal derecha&lt;/h3&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;Aparece en el lateral derecho.&lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-cancel" data-dg-close&gt;Cancelar&lt;/button&gt;
      &lt;button class="dg-btn" data-dg-close&gt;Aceptar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>

      <div class="doc-sub">5. Modal de estado (accent)</div>
      <p class="dg-muted dg-text-sm dg-mb-4">
        Dos efectos opcionales para que un resultado (éxito/error) llame la atención mientras está en pantalla
        — independientes, usa el que prefieras:<br /><br />
        <code class="dg-code">.dg-modal-glow</code> — un halo que respira lentamente hacia adentro del modal
        (sube y baja de intensidad todo el borde a la vez). Suma <code class="dg-code">.is-duotone</code> para
        un segundo tono apilado.<br />
        <code class="dg-code">.dg-modal-glow-spin</code> — un trazo fino que recorre el borde girando, en vez
        de pulsar.<br /><br />
        Ambas leen el mismo <code class="dg-code">.is-success/.is-warning/.is-danger/.is-info</code> que
        <code class="dg-code">.dg-modal-accent</code>, y respetan <code class="dg-code">prefers-reduced-motion</code>
        (quedan fijas, sin animar).
      </p>
      <div class="doc-demo is-plain">
        <div class="dg-flex dg-items-center dg-gap-4 dg-mb-4">
          <span class="dg-text-sm dg-fw-medium">Efecto</span>
          <div class="dg-segmented" id="glowEffectSeg" data-dg-segmented>
            <button class="is-active" data-effect="dg-modal-glow">Pulso</button>
            <button data-effect="dg-modal-glow-spin">Giro</button>
          </div>
        </div>
        <div class="dg-cluster">
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-status="success">✓ Éxito</button>
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-status="warning">⚠ Aviso</button>
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-status="danger">✕ Error</button>
          <button class="dg-btn dg-btn-ghost dg-btn-sm" data-status="info">ℹ Info</button>
        </div>
      </div>
      <div class="doc-code" data-code-source="manual"><button class="cp">Copiar</button><pre>&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-success"&gt;✓ Éxito&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-warning"&gt;⚠ Aviso&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-danger"&gt;✕ Error&lt;/button&gt;
&lt;button class="dg-btn dg-btn-ghost dg-btn-sm" data-dg-open="#modal-info"&gt;ℹ Info&lt;/button&gt;

&lt;!-- data-dg-static: sin X, sin Escape, sin clic fuera — solo se cierra con el botón --&gt;

&lt;!-- Éxito --&gt;
&lt;div class="dg-modal-backdrop" id="modal-success" data-dg-backdrop="" data-dg-static hidden&gt;
  &lt;div class="dg-modal dg-modal-sm dg-modal-accent dg-modal-glow is-success" role="dialog" aria-modal="true"&gt;
    &lt;div class="dg-modal-status-hero"&gt;&lt;span class="dg-modal-icon is-success"&gt;&lt;/span&gt;&lt;/div&gt;
    &lt;!-- Título y mensaje van juntos dentro de .dg-modal-body, sin header aparte --&gt;
    &lt;div class="dg-modal-body"&gt;
      &lt;h3 class="dg-modal-title"&gt;Operación exitosa&lt;/h3&gt;
      &lt;p&gt;Todo salió bien. Puedes continuar.&lt;/p&gt;
    &lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-success" data-dg-close&gt;Aceptar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Aviso --&gt;
&lt;div class="dg-modal-backdrop" id="modal-warning" data-dg-backdrop="" data-dg-static hidden&gt;
  &lt;div class="dg-modal dg-modal-sm dg-modal-accent dg-modal-glow is-warning" role="dialog" aria-modal="true"&gt;
    &lt;div class="dg-modal-status-hero"&gt;&lt;span class="dg-modal-icon is-warning"&gt;&lt;/span&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;
      &lt;h3 class="dg-modal-title"&gt;Atención requerida&lt;/h3&gt;
      &lt;p&gt;Revisa los datos antes de continuar.&lt;/p&gt;
    &lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-warning" data-dg-close&gt;Continuar&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Error --&gt;
&lt;div class="dg-modal-backdrop" id="modal-danger" data-dg-backdrop="" data-dg-static hidden&gt;
  &lt;div class="dg-modal dg-modal-sm dg-modal-accent dg-modal-glow is-duotone is-danger" role="dialog" aria-modal="true"&gt;
    &lt;div class="dg-modal-status-hero"&gt;&lt;span class="dg-modal-icon is-danger"&gt;&lt;/span&gt;&lt;/div&gt;
    &lt;div class="dg-modal-body"&gt;
      &lt;h3 class="dg-modal-title"&gt;Error inesperado&lt;/h3&gt;
      &lt;p&gt;Algo salió mal. Intenta de nuevo.&lt;/p&gt;
    &lt;/div&gt;
    &lt;div class="dg-modal-footer"&gt;
      &lt;button class="dg-btn dg-btn-danger" data-dg-close&gt;Reintentar&lt;/button&gt;
