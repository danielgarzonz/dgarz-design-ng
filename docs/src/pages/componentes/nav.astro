    <button class="dg-tab" role="tab" aria-selected="false">Álbumes</button>
  </div>
  <div class="dg-segmented is-glass">
    <button type="button" class="is-active">Día</button>
    <button type="button">Semana</button>
    <button type="button">Mes</button>
  </div>
</div>
</div>
      <div class="doc-code"><button class="cp">Copiar</button><pre>&lt;div class=&quot;dg-stack dg-gap-4&quot;&gt;
  &lt;div class=&quot;dg-tabs dg-tabs-pill is-glass&quot; role=&quot;tablist&quot;&gt;
    &lt;button class=&quot;dg-tab is-active&quot; role=&quot;tab&quot; aria-selected=&quot;true&quot;&gt;Fotos&lt;/button&gt;
    &lt;button class=&quot;dg-tab&quot; role=&quot;tab&quot; aria-selected=&quot;false&quot;&gt;Videos&lt;/button&gt;
    &lt;button class=&quot;dg-tab&quot; role=&quot;tab&quot; aria-selected=&quot;false&quot;&gt;Álbumes&lt;/button&gt;
  &lt;/div&gt;
  &lt;div class=&quot;dg-segmented is-glass&quot;&gt;
