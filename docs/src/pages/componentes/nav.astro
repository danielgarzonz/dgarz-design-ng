  &lt;button type=&quot;button&quot; class=&quot;dg-dock-item&quot;&gt;&lt;svg class=&quot;dg-icon&quot;&gt;&lt;use href=&quot;dgarz-icons.svg#dg-user&quot;/&gt;&lt;/svg&gt;&lt;span class=&quot;dg-dock-label&quot;&gt;Perfil&lt;/span&gt;&lt;/button&gt;
