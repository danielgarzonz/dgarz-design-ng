  <button type="button" class="dg-dock-item"><svg class="dg-icon"><use href="#dg-search"/></svg><span class="dg-dock-label">Buscar</span></button>
  <button type="button" class="dg-dock-item"><svg class="dg-icon"><use href="#dg-bell"/></svg><span class="dg-dock-label">Avisos</span></button>
  <button type="button" class="dg-dock-item"><svg class="dg-icon"><use href="#dg-user"/></svg><span class="dg-dock-label">Perfil</span></button>
</nav>
</div>
