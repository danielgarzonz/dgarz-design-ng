    <button type="button" class="dg-dock-item"><svg class="dg-icon"><use href="#dg-user"/></svg><span class="dg-dock-label">Perfil</span></button>
  </nav>
  <span class="dock-phone-home" aria-hidden="true"></span>
</div></div>
</div>
<div class="doc-code">
<button class="cp">Copiar</button>
<pre>&lt;nav class=&quot;dg-dock dg-dock-bar&quot; data-dg-dock aria-label=&quot;Principal&quot;&gt;
