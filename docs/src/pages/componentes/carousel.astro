  &lt;button type="button" class="dg-carousel-prev" aria-label="Anterior"&gt;‹&lt;/button&gt;
  &lt;button type="button" class="dg-carousel-next" aria-label="Siguiente"&gt;›&lt;/button&gt;
  &lt;div class="dg-carousel-indicators"&gt;
    &lt;button type="button" data-dg-carousel-go="0" aria-label="Diapositiva 1"&gt;&lt;/button&gt;
    &lt;button type="button" data-dg-carousel-go="1" aria-label="Diapositiva 2"&gt;&lt;/button&gt;
