---
import Layout from "../../layouts/DocsLayout.astro";
const pageContent = `<div class="doc-sub">Estilos base</div>
      <p class="dg-muted dg-text-sm dg-mb-4"><code class="dg-code">.dg-badge</code> es la etiqueta neutra. Usa <code class="dg-code">.dg-badge-solid</code> para darle más peso o <code class="dg-code">.dg-badge-outline</code> para aligerarla.</p>
      <div class="doc-example">
<div class="doc-demo is-plain">
        <div class="dg-cluster">
          <span class="dg-badge">Default</span>
          <span class="dg-badge dg-badge-solid">Sólido</span>
          <span class="dg-badge dg-badge-outline">Outline</span>
        </div>
      </div>
      <div class="doc-code"><button class="cp">Copiar</button><pre>&lt;span class="dg-badge"&gt;Default&lt;/span&gt;
&lt;span class="dg-badge dg-badge-solid"&gt;Sólido&lt;/span&gt;
&lt;span class="dg-badge dg-badge-outline"&gt;Outline&lt;/span&gt;</pre></div>
</div>

      <div class="doc-sub">Variantes semánticas</div>
      <p class="dg-muted dg-text-sm dg-mb-4">Comunica un estado con <code class="dg-code">.dg-badge-success</code>, <code class="dg-code">.dg-badge-warning</code>, <code class="dg-code">.dg-badge-danger</code> o <code class="dg-code">.dg-badge-info</code>.</p>
      <div class="doc-example">
<div class="doc-demo is-plain">
        <div class="dg-cluster">
          <span class="dg-badge dg-badge-success">Completado</span>
          <span class="dg-badge dg-badge-warning">Pendiente</span>
          <span class="dg-badge dg-badge-danger">Error</span>
          <span class="dg-badge dg-badge-info">Info</span>
        </div>
      </div>
      <div class="doc-code"><button class="cp">Copiar</button><pre>&lt;span class="dg-badge dg-badge-success"&gt;Completado&lt;/span&gt;
&lt;span class="dg-badge dg-badge-warning"&gt;Pendiente&lt;/span&gt;
&lt;span class="dg-badge dg-badge-danger"&gt;Error&lt;/span&gt;
&lt;span class="dg-badge dg-badge-info"&gt;Info&lt;/span&gt;</pre></div>
</div>

      <div class="doc-sub">Semánticas sólidas</div>
      <p class="dg-muted dg-text-sm dg-mb-4">Combina <code class="dg-code">.dg-badge</code> con utilidades como <code class="dg-code">.dg-bg-success</code> y <code class="dg-code">.dg-border-transparent</code> para un fondo de color pleno.</p>
      <div class="doc-example">
<div class="doc-demo is-plain">
        <div class="dg-cluster">
          <span class="dg-badge dg-bg-success dg-border-transparent">Completado</span>
          <span class="dg-badge dg-bg-warning dg-border-transparent">Pendiente</span>
          <span class="dg-badge dg-bg-danger dg-border-transparent">Error</span>
          <span class="dg-badge dg-bg-info dg-border-transparent">Info</span>
        </div>
      </div>
      <div class="doc-code"><button class="cp">Copiar</button><pre>&lt;!-- .dg-bg-* aplica fondo sólido + color de texto con contraste --&gt;
&lt;span class="dg-badge dg-bg-success dg-border-transparent"&gt;Completado&lt;/span&gt;
&lt;span class="dg-badge dg-bg-warning dg-border-transparent"&gt;Pendiente&lt;/span&gt;
&lt;span class="dg-badge dg-bg-danger dg-border-transparent"&gt;Error&lt;/span&gt;
&lt;span class="dg-badge dg-bg-info dg-border-transparent"&gt;Info&lt;/span&gt;</pre></div>
</div>

      <div class="doc-sub">Con punto de estado (.dg-badge-dot)</div>
      <p class="dg-muted dg-text-sm dg-mb-4">Añade <code class="dg-code">.dg-badge-dot</code> para mostrar un punto de color junto al texto. Es útil para indicar estados en tablas y listas.</p>
      <div class="doc-example">
<div class="doc-demo is-plain">
        <div class="dg-cluster">
          <span class="dg-badge dg-badge-dot dg-badge-success">Activo</span>
          <span class="dg-badge dg-badge-dot dg-badge-warning">Revisión</span>
          <span class="dg-badge dg-badge-dot dg-badge-danger">Bloqueado</span>
          <span class="dg-badge dg-badge-dot dg-badge-info">Procesando</span>
          <span class="dg-badge dg-badge-dot">Sin estado</span>
        </div>
      </div>
      <div class="doc-code"><button class="cp">Copiar</button><pre>&lt;!-- Combina cualquier variante con .dg-badge-dot --&gt;
&lt;span class="dg-badge dg-badge-dot dg-badge-success"&gt;Activo&lt;/span&gt;
&lt;span class="dg-badge dg-badge-dot dg-badge-warning"&gt;Revisión&lt;/span&gt;
&lt;span class="dg-badge dg-badge-dot dg-badge-danger"&gt;Bloqueado&lt;/span&gt;
&lt;span class="dg-badge dg-badge-dot dg-badge-info"&gt;Procesando&lt;/span&gt;
&lt;span class="dg-badge dg-badge-dot"&gt;Sin estado&lt;/span&gt;</pre></div>
</div>

      <div class="doc-sub">Uso combinado con otros componentes</div>
      <p class="dg-muted dg-text-sm dg-mb-4">Los badges se integran dentro de botones y junto a avatares para mostrar contadores o estados.</p>
      <div class="doc-example">
<div class="doc-demo is-plain">
        <div class="dg-cluster">
          <button class="dg-btn dg-btn-outline dg-btn-sm">
            Notificaciones <span class="dg-badge dg-badge-solid dg-ml-1">3</span>
          </button>
          <div class="dg-flex dg-items-center dg-gap-3">
            <span class="dg-avatar">AR</span>
            <div>
              <div class="dg-fw-medium dg-text-sm">Ana Rivas</div>
              <span class="dg-badge dg-badge-dot dg-badge-success dg-mt-px-2">Activo</span>
            </div>
          </div>
        </div>
      </div>
      <div class="doc-code"><button class="cp">Copiar</button><pre>&lt;!-- Badge dentro de un botón --&gt;
&lt;button class="dg-btn dg-btn-outline dg-btn-sm"&gt;
  Notificaciones &lt;span class="dg-badge dg-badge-solid dg-ml-1"&gt;3&lt;/span&gt;
&lt;/button&gt;

&lt;!-- Badge de estado junto a un avatar --&gt;
&lt;div class="dg-flex dg-items-center dg-gap-3"&gt;
  &lt;span class="dg-avatar"&gt;AR&lt;/span&gt;
  &lt;div&gt;
    &lt;div class="dg-fw-medium dg-text-sm"&gt;Ana Rivas&lt;/div&gt;
    &lt;span class="dg-badge dg-badge-dot dg-badge-success dg-mt-px-2"&gt;Activo&lt;/span&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>
</div>`;
---

<Layout title="Badges" lead="Etiquetas de estado en variantes sólidas, outline y semánticas." currentHref="/componentes/badges">
  <Fragment set:html={pageContent} />
</Layout>
