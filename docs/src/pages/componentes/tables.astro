<Layout title="Tablas" lead="Tablas básicas, con bordes, filas alternadas, scroll horizontal y tarjetas en móvil. Ejemplos y código en una sola sección." currentHref="/componentes/tables">
  <section class="dg-mb-5" aria-labelledby="table-corners-label">
    <h2 class="doc-sub" id="table-corners-label">Esquinas de las tablas</h2>
    <p class="dg-muted dg-mb-3">Elige un acabado para probarlo en las tablas de esta página.</p>
    <div class="dg-segmented" id="tableCorners" role="group" aria-labelledby="table-corners-label">
      <button type="button" data-corners="default" class="is-active" aria-pressed="true">Original</button>
      <button type="button" data-corners="rounded" aria-pressed="false">Redondeadas</button>
      <button type="button" data-corners="square" aria-pressed="false">Rectas · sin radius</button>
    </div>
    <p class="dg-text-sm dg-mt-3" id="tableCornersHint" aria-live="polite">Cada ejemplo conserva su acabado original.</p>
  </section>
  <div id="tableExamples" data-corners="default">
    <Fragment set:html={pageContent} />
  </div>
</Layout>

<style is:global>
  .table-width-stage { overflow-x: hidden; }
  #tablePreviewFrame { position: relative; flex-shrink: 0; margin-right: 56px; max-width: calc(100% - 56px); }
  #tableMobilePreview { width: 100%; }
  #tablePreviewHandle {
    position: absolute; right: -48px; top: 50%; transform: translateY(-50%);
    width: 32px; height: 44px; padding: 0; border: 0; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    background: #0b0b0c; color: #fff; cursor: ew-resize;
    touch-action: none; user-select: none; z-index: 2;
  }
  #tablePreviewHandle:hover, #tablePreviewHandle:active { background: #3f3f46; }
  #tableExamples[data-corners="square"] .doc-demo :is(.dg-table-card, .dg-table-rowcard) { border-radius: 0; }
  #tableExamples[data-corners="rounded"] .doc-demo :is(.dg-table-card, .dg-table-rowcard) { border-radius: var(--dg-radius-lg); }
</style>
<script>
  const widthHandle = document.querySelector<HTMLButtonElement>('#tablePreviewHandle');
  const previewFrame = document.getElementById('tablePreviewFrame');
  const widthOutput = document.getElementById('tablePreviewOutput');
  const stage = previewFrame?.closest<HTMLElement>('.table-width-stage');
  function maximumPreviewWidth() {
    if (!stage) return 1000;
    const style = getComputedStyle(stage);
    return Math.max(1, Math.min(1000, Math.floor(stage.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight) - 56)));
  }
  function updateTableWidth(value: number) {
    const maximum = maximumPreviewWidth();
    const minimum = Math.min(320, maximum);
    const width = Math.round(Math.max(minimum, Math.min(maximum, value)));
    if (!widthHandle || !previewFrame || !widthOutput) return;
    previewFrame.style.width = width + 'px';
    widthHandle.setAttribute('aria-valuemin', String(minimum));
    widthHandle.setAttribute('aria-valuemax', String(maximum));
    widthHandle.setAttribute('aria-valuenow', String(width));
    const direction = maximum === minimum ? 'fixed' : width >= maximum ? 'shrink' : width <= minimum ? 'grow' : 'both';
    const icon = widthHandle.querySelector('[data-table-resize-icon]');
    const paths = {
      shrink: 'm8 8-4 4 4 4M4 12h16',
      grow: 'm16 8 4 4-4 4M4 12h16',
      both: 'm8 8-4 4 4 4m8-8 4 4-4 4M4 12h16'
    };
    icon?.setAttribute('d', paths[direction === 'fixed' ? 'both' : direction]);
    const label = direction === 'shrink' ? 'Reducir ancho de la tabla'
      : direction === 'grow' ? 'Ampliar ancho de la tabla'
      : direction === 'fixed' ? 'Sin espacio disponible para cambiar el ancho'
      : 'Ampliar o reducir ancho de la tabla';
    widthHandle.setAttribute('aria-label', label);
    widthHandle.title = label;
    widthHandle.disabled = direction === 'fixed';

    widthHandle.setAttribute('aria-valuetext', width + ' píxeles, ' + (width <= 768 ? 'tarjetas' : 'tabla'));
    widthOutput.textContent = width + 'px · ' + (width <= 768 ? 'Vista de tarjetas' : 'Vista de tabla');
    document.querySelectorAll<HTMLButtonElement>('[data-table-width]').forEach(button => {
      const selected = Number(button.dataset.tableWidth) === width;
      button.classList.toggle('is-active', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
  }
  let dragStart: { pointer: number; x: number; width: number } | null = null;
  widthHandle?.addEventListener('pointerdown', event => {
    if (!event.isPrimary || event.button !== 0) return;
    dragStart = { pointer: event.pointerId, x: event.clientX, width: previewFrame!.getBoundingClientRect().width };
    widthHandle.setPointerCapture(event.pointerId);
  });
  widthHandle?.addEventListener('pointermove', event => {
    if (!dragStart || event.pointerId !== dragStart.pointer) return;
    updateTableWidth(dragStart.width + event.clientX - dragStart.x);
  });
  widthHandle?.addEventListener('pointerup', () => { dragStart = null; });
  widthHandle?.addEventListener('pointercancel', () => { dragStart = null; });
  widthHandle?.addEventListener('lostpointercapture', () => { dragStart = null; });
  widthHandle?.addEventListener('keydown', event => {
    const width = Number(widthHandle.getAttribute('aria-valuenow'));
    const step = event.shiftKey ? 50 : 10;
    let next = width;
    if (event.key === 'ArrowLeft') next -= step;
    else if (event.key === 'ArrowRight') next += step;
    else if (event.key === 'Home') next = 320;
    else if (event.key === 'End') next = 1000;
    else return;
    event.preventDefault();
    updateTableWidth(next);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-table-width]').forEach(button => {
    button.addEventListener('click', () => updateTableWidth(Number(button.dataset.tableWidth)));
  });
  updateTableWidth(Math.min(960, maximumPreviewWidth()));
  if (stage) {
    let previousMaximum = maximumPreviewWidth();
    new ResizeObserver(() => {
      const maximum = maximumPreviewWidth();
      if (maximum === previousMaximum) return;
      previousMaximum = maximum;
      updateTableWidth(Number(widthHandle?.getAttribute('aria-valuenow') ?? maximum));
    }).observe(stage);
  }
  const corners = document.getElementById('tableCorners');
  const examples = document.getElementById('tableExamples');
  const hint = document.getElementById('tableCornersHint');
  corners?.querySelectorAll<HTMLButtonElement>('button[data-corners]').forEach(button => {
    button.addEventListener('click', () => {
      const value = button.dataset.corners!;
      examples!.dataset.corners = value;
      corners.querySelectorAll('button').forEach(option => {
        option.classList.toggle('is-active', option === button);
        option.setAttribute('aria-pressed', String(option === button));
      });
      hint!.textContent = value === 'square'
        ? 'Esquinas rectas. Para usarlas en tu proyecto, agrega dg-table-square al contenedor.'
        : value === 'rounded' ? 'Esquinas redondeadas con el radio del tema.'
        : 'Cada ejemplo conserva su acabado original.';
    });
  });
</script>
