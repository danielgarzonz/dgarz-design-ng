  <caption class="dg-table-caption">Inventario de productos</caption>
  <thead><tr><th scope="col">Producto</th><th scope="col">Categoría</th><th scope="col" class="dg-cell-num">Stock</th><th scope="col" class="dg-cell-num">Precio</th></tr></thead>
  <tbody>
    <tr><td>Cuaderno editorial</td><td>Papelería</td><td class="dg-cell-num">24</td><td class="dg-cell-num">$180.00</td></tr>
