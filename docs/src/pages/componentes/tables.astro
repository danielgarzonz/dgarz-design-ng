    <tr><td>Organizador modular</td><td>Accesorios</td><td class="dg-cell-num">16</td><td class="dg-cell-num">$420.00</td></tr>
  </tbody>
</table>
</div></div>
<div class="doc-code"><button class="cp">Copiar</button><pre>&lt;div class="dg-table-card" role="region" aria-label="Tabla con bordes" tabindex="0"&gt;
