---
import Layout from "../../layouts/DocsLayout.astro";

// ── Demo item class strings ────────────────────────────────────────────────
const item  = "dg-bg-dark dg-p-2";
const itemS = "dg-bg-dark dg-p-1";
const itemX = "dg-bg-dark dg-px-2";

// Padding variants for center vs baseline demos
const itemA = "dg-bg-dark dg-px-2 dg-py-2 dg-pb-6";
const itemB = "dg-bg-dark dg-px-2 dg-py-5";
const itemC = "dg-bg-dark dg-px-2 dg-py-2 dg-pt-6";

// ── Track (flex container) base ────────────────────────────────────────────
const track = "dg-flex dg-gap-2 dg-py-3 dg-px-4 dg-bg-surface-2 dg-border dg-rounded-sm dg-w-full";

// ── Data ───────────────────────────────────────────────────────────────────
const justifyValues = [
  ["dg-justify-start",   "flex-start"],
  ["dg-justify-end",     "flex-end"],
  ["dg-justify-center",  "center"],
  ["dg-justify-between", "space-between"],
  ["dg-justify-around",  "space-around"],
];

const alignContentValues = [
  ["dg-content-start",   "flex-start"],
  ["dg-content-end",     "flex-end"],
  ["dg-content-center",  "center"],
  ["dg-content-between", "space-between"],
  ["dg-content-around",  "space-around"],
  ["dg-content-stretch", "stretch"],
];
---

<Layout title="Flex" lead="Utilidades completas de flexbox: dirección, alineación, wrap, orden y más." currentHref="/fundamentos/flex">

  <!-- ══ 1. ENABLE FLEX ══════════════════════════════════════════════════── -->
  <div class="doc-sub">Activar flex</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Convierte cualquier elemento en un contenedor flex o inline-flex. Sus hijos directos pasan a ser flex items.
  </p>

  <div class="doc-demo is-plain">
    <div>
      <div class="doc-flex-label"><code>.dg-flex</code></div>
      <div class={track}>
        <div class={item}>Logo</div>
        <div class={item}>Navegación</div>
        <div class={item}>Acción</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label"><code>.dg-inline-flex</code></div>
      <div class="dg-py-3 dg-px-4">
        <div class="dg-inline-flex dg-gap-2 dg-py-3 dg-px-4 dg-bg-surface-2 dg-border dg-rounded-sm">
          <div class={item}>Icono</div>
          <div class={item}>Etiqueta</div>
        </div>
      </div>
    </div>
  </div>
  <div class="doc-code" data-lang="html"><button class="cp">Copiar</button><pre>&lt;div class="dg-flex"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Logo&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Navegación&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Acción&lt;/div&gt;
&lt;/div&gt;

&lt;span class="dg-inline-flex"&gt;
  &lt;span class="dg-bg-dark dg-p-2"&gt;Icono&lt;/span&gt;
  &lt;span class="dg-bg-dark dg-p-2"&gt;Etiqueta&lt;/span&gt;
&lt;/span&gt;</pre></div>

  <!-- ══ 2. DIRECTION ════════════════════════════════════════════════════── -->
  <div class="doc-sub">Dirección</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Establece la dirección del eje principal con <code class="dg-code">flex-direction</code>.
  </p>

  <div class="doc-demo is-plain">
    <div>
      <div class="doc-flex-label">row (default)</div>
      <div class={`${track} dg-flex-row`}>
        <div class={item}>Logo</div>
        <div class={item}>Navegación</div>
        <div class={item}>Acción</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">row-reverse</div>
      <div class={`${track} dg-flex-row-reverse`}>
        <div class={item}>Logo</div>
        <div class={item}>Navegación</div>
        <div class={item}>Acción</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">column</div>
      <div class={`${track} dg-col-flex`}>
        <div class={item}>Imagen</div>
        <div class={item}>Título</div>
        <div class={item}>Descripción</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">column-reverse</div>
      <div class={`${track} dg-flex-col-reverse`}>
        <div class={item}>Imagen</div>
        <div class={item}>Título</div>
        <div class={item}>Descripción</div>
      </div>
    </div>
  </div>
  <div class="doc-code" data-lang="html"><button class="cp">Copiar</button><pre>&lt;div class="dg-flex dg-flex-row"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Logo&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Navegación&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Acción&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-flex-row-reverse"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Logo&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Navegación&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Acción&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-col-flex"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Imagen&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Título&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Descripción&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-flex-col-reverse"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Imagen&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Título&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Descripción&lt;/div&gt;
&lt;/div&gt;</pre></div>

  <!-- ══ 3. JUSTIFY CONTENT ══════════════════════════════════════════════── -->
  <div class="doc-sub">Justify content</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Distribuye los flex items en el eje principal.
  </p>

  <div class="doc-demo is-plain">
    {justifyValues.map(([cls, val]) => (
      <div>
        <div class="doc-flex-label">{val}</div>
        <div class={`${track} ${cls}`}>
          <div class={item}>Logo</div>
          <div class={item}>Navegación</div>
          <div class={item}>Acción</div>
        </div>
      </div>
    ))}
  </div>
  <div class="doc-code" data-lang="html"><button class="cp">Copiar</button><pre>&lt;div class="dg-flex dg-justify-start"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Logo&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Navegación&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Acción&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-justify-end"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Logo&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Navegación&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Acción&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-justify-center"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Logo&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Navegación&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Acción&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-justify-between"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Logo&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Navegación&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Acción&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-justify-around"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Logo&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Navegación&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Acción&lt;/div&gt;
&lt;/div&gt;</pre></div>

  <!-- ══ 4. ALIGN ITEMS ══════════════════════════════════════════════════── -->
  <div class="doc-sub">Align items</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Alinea los items en el eje cruzado. El contenedor tiene altura fija para que el efecto sea visible.
  </p>

  <div class="doc-demo is-plain">
    <div>
      <div class="doc-flex-label">flex-start</div>
      <div class={`${track} dg-items-start dg-h-96`}>
        <div class={item}>Icono</div>
        <div class={item}>Contenido</div>
        <div class={item}>Estado</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">flex-end</div>
      <div class={`${track} dg-items-end dg-h-96`}>
        <div class={item}>Icono</div>
        <div class={item}>Contenido</div>
        <div class={item}>Estado</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">center</div>
      <div class={`${track} dg-items-center dg-h-96`}>
        <div class={itemA}>Icono</div>
        <div class={itemB}>Contenido</div>
        <div class={itemC}>Estado</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">baseline</div>
      <div class={`${track} dg-items-baseline dg-h-96`}>
        <div class={itemA}>Icono</div>
        <div class={itemB}>Contenido</div>
        <div class={itemC}>Estado</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">stretch</div>
      <div class={`${track} dg-items-stretch dg-h-96`}>
        <div class={itemX}>Icono</div>
        <div class={itemX}>Contenido</div>
        <div class={itemX}>Estado</div>
      </div>
    </div>
  </div>
  <div class="doc-code" data-lang="html"><button class="cp">Copiar</button><pre>&lt;div class="dg-flex dg-items-start"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Icono&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Contenido&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Estado&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-items-end"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Icono&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Contenido&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Estado&lt;/div&gt;
&lt;/div&gt;

&lt;!-- Padding asimétrico para ver la diferencia entre center y baseline --&gt;
&lt;div class="dg-flex dg-items-center"&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-2 dg-pb-6"&gt;Icono&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-5"&gt;Contenido&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-2 dg-pt-6"&gt;Estado&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-items-baseline"&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-2 dg-pb-6"&gt;Icono&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-5"&gt;Contenido&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-2 dg-pt-6"&gt;Estado&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-items-stretch"&gt;
  &lt;div class="dg-bg-dark dg-px-2"&gt;Icono&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2"&gt;Contenido&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2"&gt;Estado&lt;/div&gt;
&lt;/div&gt;</pre></div>

  <!-- ══ 5. ALIGN SELF ═══════════════════════════════════════════════════── -->
  <div class="doc-sub">Align self</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Sobrescribe <code class="dg-code">align-items</code> en un item individual.
  </p>

  <div class="doc-demo is-plain">
    <div>
      <div class="doc-flex-label">flex-start</div>
      <div class={`${track} dg-h-96`}>
        <div class={item}>Lateral</div>
        <div class={`${item} dg-self-start`}>Contenido</div>
        <div class={item}>Lateral</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">flex-end</div>
      <div class={`${track} dg-h-96`}>
        <div class={item}>Lateral</div>
        <div class={`${item} dg-self-end`}>Contenido</div>
        <div class={item}>Lateral</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">center</div>
      <div class={`${track} dg-h-96`}>
        <div class={itemA}>Lateral</div>
        <div class={`${itemB} dg-self-center`}>Contenido</div>
        <div class={itemC}>Lateral</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">baseline</div>
      <div class={`${track} dg-h-96`}>
        <div class={itemA}>Lateral</div>
        <div class={`${itemB} dg-self-baseline`}>Contenido</div>
        <div class={itemC}>Lateral</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">stretch</div>
      <div class={`${track} dg-h-96`}>
        <div class={item}>Lateral</div>
        <div class={`${itemX} dg-self-stretch`}>Contenido</div>
        <div class={item}>Lateral</div>
      </div>
    </div>
  </div>
  <div class="doc-code" data-lang="html"><button class="cp">Copiar</button><pre>&lt;div class="dg-flex"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Lateral&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2 dg-self-start"&gt;Contenido&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Lateral&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Lateral&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2 dg-self-end"&gt;Contenido&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Lateral&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex"&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-2 dg-pb-6"&gt;Lateral&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-5 dg-self-center"&gt;Contenido&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-2 dg-pt-6"&gt;Lateral&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex"&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-2 dg-pb-6"&gt;Lateral&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-5 dg-self-baseline"&gt;Contenido&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-py-2 dg-pt-6"&gt;Lateral&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Lateral&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-px-2 dg-self-stretch"&gt;Contenido&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Lateral&lt;/div&gt;
&lt;/div&gt;</pre></div>

  <!-- ══ 6. AUTO MARGINS ═════════════════════════════════════════════════── -->
  <div class="doc-sub">Auto margins</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Combina <code class="dg-code">dg-ml-auto</code> o <code class="dg-code">dg-mr-auto</code> con flex para empujar items hacia un lado.
  </p>

  <div class="doc-demo is-plain">
    <div>
      <div class="doc-flex-label">sin auto margin</div>
      <div class={track}>
        <div class={item}>Logo</div>
        <div class={item}>Login</div>
        <div class={item}>Registro</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">margin-right: auto</div>
      <div class={track}>
        <div class={`${item} dg-mr-auto`}>Logo</div>
        <div class={item}>Login</div>
        <div class={item}>Registro</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">margin-left: auto</div>
      <div class={track}>
        <div class={item}>Filtros</div>
        <div class={item}>Exportar</div>
        <div class={`${item} dg-ml-auto`}>Acción</div>
      </div>
    </div>
  </div>
  <div class="doc-code" data-lang="html"><button class="cp">Copiar</button><pre>&lt;div class="dg-flex"&gt;
  &lt;div class="dg-bg-dark dg-p-2 dg-mr-auto"&gt;Logo&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Login&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Registro&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex"&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Filtros&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Exportar&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2 dg-ml-auto"&gt;Acción&lt;/div&gt;
&lt;/div&gt;</pre></div>

  <!-- ══ 7. WRAP ══════════════════════════════════════════════════════════── -->
  <div class="doc-sub">Wrap</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Controla si los items pueden saltar de línea cuando no caben.
  </p>

  <div class="doc-demo is-plain">
    <div>
      <div class="doc-flex-label">nowrap (default)</div>
      <div class={`${track} dg-nowrap`} style="overflow:hidden">
        {['HTML','CSS','JS','React','Astro','Node','TS'].map(t => <div class={itemS}>{t}</div>)}
      </div>
    </div>
    <div>
      <div class="doc-flex-label">wrap</div>
      <div class={`${track} dg-wrap`}>
        {['HTML','CSS','JS','React','Astro','Node','TS'].map(t => <div class={itemS}>{t}</div>)}
      </div>
    </div>
    <div>
      <div class="doc-flex-label">wrap-reverse</div>
      <div class={`${track} dg-wrap-reverse`}>
        {['HTML','CSS','JS','React','Astro','Node','TS'].map(t => <div class={itemS}>{t}</div>)}
      </div>
    </div>
  </div>
  <div class="doc-code" data-lang="html"><button class="cp">Copiar</button><pre>&lt;div class="dg-flex dg-nowrap"&gt;
  &lt;div class="dg-bg-dark dg-p-1"&gt;HTML&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-1"&gt;CSS&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-1"&gt;JS&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-1"&gt;React&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-1"&gt;Astro&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-1"&gt;Node&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-1"&gt;TS&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex dg-wrap"&gt;...&lt;/div&gt;
&lt;div class="dg-flex dg-wrap-reverse"&gt;...&lt;/div&gt;</pre></div>

  <!-- ══ 8. GROW & SHRINK ════════════════════════════════════════════════── -->
  <div class="doc-sub">Grow y shrink</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Controla si un item puede crecer o encogerse dentro del contenedor.
  </p>

  <div class="doc-demo is-plain">
    <div>
      <div class="doc-flex-label">flex: 1 1 auto</div>
      <div class={track}>
        <div class={`${item} dg-grow`}>Búsqueda</div>
        <div class={item}>Buscar</div>
        <div class={item}>Filtrar</div>
      </div>
    </div>
    <div>
      <div class="doc-flex-label">flex-shrink: 0</div>
      <div class={track} style="overflow:hidden;width:320px">
        <div class={`${item} dg-shrink-0`}>Avatar</div>
        <div class={item}>Contenido principal</div>
        <div class={item}>Sidebar</div>
      </div>
    </div>
  </div>
  <div class="doc-code" data-lang="html"><button class="cp">Copiar</button><pre>&lt;div class="dg-flex"&gt;
  &lt;div class="dg-bg-dark dg-p-2 dg-grow"&gt;Búsqueda&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Buscar&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Filtrar&lt;/div&gt;
&lt;/div&gt;

&lt;div class="dg-flex"&gt;
  &lt;div class="dg-bg-dark dg-p-2 dg-shrink-0"&gt;Avatar&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Contenido principal&lt;/div&gt;
  &lt;div class="dg-bg-dark dg-p-2"&gt;Sidebar&lt;/div&gt;
&lt;/div&gt;</pre></div>

  <!-- ══ 9. ORDER ════════════════════════════════════════════════════════── -->
  <div class="doc-sub">Order</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Cambia el orden visual sin modificar el DOM.
