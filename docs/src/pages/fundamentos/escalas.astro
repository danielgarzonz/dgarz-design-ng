---
import Layout from "../../layouts/DocsLayout.astro";
import Code from "../../components/Code.astro";

// The full utility scales (generated in core/src/scss/abstracts/_scales.scss).
// Demos use only framework classes (no style attributes).
const scales = [
  { family: "Margen", classes: "dg-m-*, dg-mt-*, dg-mr-*, dg-mb-*, dg-ml-*, dg-mx-*, dg-my-*", steps: "0–9 · auto · negativos n1–n9 (dg-mt-n4)" },
  { family: "Padding", classes: "dg-p-*, dg-pt-*, dg-pr-*, dg-pb-*, dg-pl-*, dg-px-*, dg-py-*", steps: "0–9" },
  { family: "Gap", classes: "dg-gap-*, dg-gap-x-*, dg-gap-y-*", steps: "0–9" },
  { family: "Espacio (valor)", classes: "--dg-space-1 … 9", steps: "4 · 8 · 12 · 16 · 24 · 32 · 48 · 64 · 96 px" },
  { family: "Ancho", classes: "dg-w-*", steps: "px: 16 24 32 40 48 64 80 96 128 160 200 240 320 400 480 560 640 720 · %: 10 20 25 30 33 40 50 60 66 70 75 80 90 100 (dg-w-50p) · vw: 25 50 75 100 · auto, fit, min, max, full, screen" },
  { family: "Ancho máximo", classes: "dg-max-w-*", steps: "px: igual que ancho + 800 960 1080 1200 1440 · % · vw · none" },
  { family: "Ancho mínimo", classes: "dg-min-w-*", steps: "px · 0 · full · fit" },
  { family: "Alto", classes: "dg-h-*", steps: "px: igual que ancho · %: 25 50 75 100 · vh: 25 50 75 100 · auto, fit, full, screen, px (1px)" },
  { family: "Alto mínimo / máximo", classes: "dg-min-h-*, dg-max-h-*", steps: "px · vh: 25 50 75 100 · full · screen · none" },
  { family: "Cuadrado", classes: "dg-size-*", steps: "16 24 32 40 48 64 80 96 128 160 200 240 (ancho y alto)" },
  { family: "Posición", classes: "dg-top-*, dg-right-*, dg-bottom-*, dg-left-*", steps: "0–9 (espacio) · %: 25 50 75 100 (dg-top-50p) · auto · dg-inset-0, -x-0, -y-0" },
  { family: "Grid", classes: "dg-grid-cols-*, dg-span-*, dg-grid-rows-*, dg-row-span-*", steps: "columnas 1–12 · filas 1–6 · dg-span-full · dg-grid-flow-row / col / dense" },
  { family: "Alineación de grid", classes: "dg-place-items-*, dg-place-self-*, dg-justify-items-*", steps: "start · center · end · stretch" },
  { family: "Esquinas por lado", classes: "dg-rounded-t, -b, -l, -r", steps: "(radio por defecto) · -0 · -sm · -lg · -xl · -pill · una esquina: dg-rounded-tl-full…" },
  { family: "Texto", classes: "dg-text-*, dg-line-clamp-*", steps: "tamaños xs–5xl · left, center, right, justify, start, end · lowercase, capitalize, normal-case · line-clamp 1–5" },
  { family: "Opacidad", classes: "dg-opacity-*", steps: "0 10 20 25 30 40 50 60 70 75 80 90 100" },
  { family: "Grises", classes: "dg-text-gray-*, dg-bg-gray-*", steps: "0 50 100 200 300 400 500 600 700 800 900 950 · dg-text-current, dg-text-inherit, dg-bg-transparent" },
  { family: "Texto grande y fluido", classes: "dg-text-6xl…9xl, dg-text-fluid-*", steps: "80 · 96 · 128 · 160 px · fluid: sm, md, lg, xl (crece con la ventana entre un mínimo y un máximo)" },
  { family: "Tipografía extra", classes: "dg-fw-thin, -light, -black · dg-leading-loose · dg-tracking-tighter", steps: "dg-text-pretty · dg-tabular-nums · dg-hyphens-auto · dg-whitespace-pre · dg-underline-offset-2/4/8" },
  { family: "Columnas de texto", classes: "dg-columns-*, dg-break-inside-avoid", steps: "1–4 (también responsivas: dg-md-columns-2)" },
  { family: "Transformaciones", classes: "dg-rotate-*, dg-scale-*, dg-translate-*, dg-flip-*", steps: "rotar 1 3 6 12 45 90 180 (n = negativo) · escala 50 75 90 95 100 105 110 125 · dg-translate-center, -x-n50, -y-n50 · dg-center-abs · se combinan entre sí" },
  { family: "Filtros y fusión", classes: "dg-blur-*, dg-brightness-*, dg-backdrop-blur-*, dg-mix-*", steps: "blur sm md lg · brillo 50 75 110 125 · dg-contrast-125 · dg-grayscale, dg-invert, dg-sepia · mix multiply, screen, difference, overlay · dg-isolate" },
  { family: "Velos sobre fotos", classes: "dg-scrim-*", steps: "b (abajo) · t (arriba) · full · light-b — en una capa dg-absolute dg-inset-0" },
  { family: "Entre hijos", classes: "dg-space-y-*, dg-space-x-*, dg-divide-y, dg-divide-x", steps: "espacio 0–9 · líneas de 1px sin borde" },
  { family: "Hover y grupo", classes: "dg-hover-*, dg-group + dg-group-hover-*", steps: "hover: lift, scale-105, opacity-75/100, underline, bg-surface-2/3 · grupo: scale-105/110, opacity-75/100, underline, nudge, x, lift" },
  { family: "Scroll y toque", classes: "dg-scroll-mt-*, dg-scrollbar-none, dg-touch-*", steps: "scroll-mt 0–9 (anclas con cabecera fija) · overscroll-none · touch none, pan-x, pan-y · appearance-none · resize none, y · cursores zoom-in, move, help, wait" },
  { family: "Tema e impresión", classes: "dg-only-light, dg-only-dark, dg-print-*", steps: "mostrar solo en tema claro u oscuro · print-hidden, print-only, print-break-before/after" },
  { family: "Capas", classes: "dg-z-*", steps: "n1 · 0 · 10 20 30 40 50 60 100 · auto · max" },
];

const responsive = "dg-block, dg-flex, dg-grid-d, dg-hidden… · dg-static, dg-relative, dg-absolute… · dirección, wrap, justify, items, self, content, dg-flex-1, dg-grow, order · grid-cols, span, place · gap · margen y padding (sin negativos) · alineación y tamaño de texto (también 6xl–9xl) · columnas de texto · ancho y alto en %, vw/vh y palabras clave";

const examples = [
  {
    id: "espaciado",
    title: "Espaciado en todos los lados",
    desc: "Margen, padding y gap usan la misma escala de espacio del 0 al 9 en todos los lados: sin sufijo (todos), t, r, b, l, x (izquierda y derecha) e y (arriba y abajo). El margen suma auto y negativos (dg-mt-n4 sube el elemento 16px).",
    html: `<div class="dg-flex dg-wrap dg-items-end dg-gap-3">
  <div class="dg-bg-sand dg-p-2 dg-rounded">p-2</div>
  <div class="dg-bg-sand dg-p-5 dg-rounded">p-5</div>
  <div class="dg-bg-sand dg-px-8 dg-py-3 dg-rounded">px-8 · py-3</div>
  <div class="dg-bg-sand dg-pt-9 dg-pb-2 dg-px-4 dg-rounded">pt-9</div>
</div>`,
  },
  {
    id: "tamanos",
    title: "Tamaños en px, porcentaje y pantalla",
    desc: "Una sola serie en px para ancho, alto, mínimos y máximos; porcentajes del contenedor con sufijo p (dg-w-33p, dg-w-66p) y medidas de pantalla con vw / vh. dg-size-* fija ancho y alto a la vez, útil para íconos, avatares y círculos.",
    html: `<div class="dg-flex dg-flex-col dg-gap-2">
  <div class="dg-w-25p dg-bg-sand dg-p-2 dg-rounded dg-text-sm">dg-w-25p</div>
  <div class="dg-w-50p dg-bg-sand dg-p-2 dg-rounded dg-text-sm">dg-w-50p</div>
  <div class="dg-w-75p dg-bg-sand dg-p-2 dg-rounded dg-text-sm">dg-w-75p</div>
  <div class="dg-flex dg-items-end dg-gap-3 dg-mt-3">
    <div class="dg-size-32 dg-bg-graphite dg-rounded-full"></div>
    <div class="dg-size-48 dg-bg-graphite dg-rounded-full"></div>
    <div class="dg-size-64 dg-bg-graphite dg-rounded-full"></div>
    <div class="dg-w-160 dg-h-96 dg-bg-sand-deep dg-rounded-lg"></div>
  </div>
</div>`,
  },
  {
    id: "grid",
    title: "Grid de 12 columnas",
    desc: "dg-grid-cols-{1…12} crea la grilla (ya incluye display: grid) y dg-span-{1…12} hace que un hijo ocupe varias columnas; dg-span-full ocupa la fila completa. Para filas: dg-grid-rows-{1…6} y dg-row-span-{1…6}.",
    html: `<div class="dg-grid-cols-12 dg-gap-2 dg-text-sm">
  <div class="dg-span-12 dg-bg-graphite dg-p-3 dg-rounded">span-12</div>
  <div class="dg-span-8 dg-bg-sand dg-p-3 dg-rounded">span-8</div>
  <div class="dg-span-4 dg-bg-sand dg-p-3 dg-rounded">span-4</div>
  <div class="dg-span-3 dg-bg-sand-deep dg-p-3 dg-rounded">span-3</div>
  <div class="dg-span-6 dg-bg-sand-deep dg-p-3 dg-rounded">span-6</div>
  <div class="dg-span-3 dg-bg-sand-deep dg-p-3 dg-rounded">span-3</div>
</div>`,
  },
  {
    id: "responsivo",
    title: "Responsivo: una clase por tamaño de pantalla",
    desc: "Pon md-, lg- o xl- después de dg- y la clase se aplica desde ese ancho de ventana (768, 992 y 1200 px; móvil primero, los mismos cortes que dg-col-md-*). Aquí: una columna en móvil, dos desde md y cuatro desde lg; el texto centrado en móvil y a la izquierda desde md, y el padding crece con la pantalla. Cambia el ancho de la ventana para verlo.",
    html: `<div class="dg-grid-cols-1 dg-md-grid-cols-2 dg-lg-grid-cols-4 dg-gap-3 dg-lg-gap-5">
  <div class="dg-bg-sand dg-p-4 dg-lg-p-6 dg-rounded-lg dg-text-center dg-md-text-left">Uno</div>
  <div class="dg-bg-sand dg-p-4 dg-lg-p-6 dg-rounded-lg dg-text-center dg-md-text-left">Dos</div>
  <div class="dg-bg-sand dg-p-4 dg-lg-p-6 dg-rounded-lg dg-text-center dg-md-text-left">Tres</div>
  <div class="dg-bg-sand dg-p-4 dg-lg-p-6 dg-rounded-lg dg-text-center dg-md-text-left">Cuatro</div>
</div>`,
  },
  {
    id: "responsivo-flex",
    title: "Responsivo: apilar en móvil, fila en escritorio",
    desc: "dg-flex dg-flex-col dg-md-flex-row apila en móvil y pone en fila desde md; dg-md-items-center y dg-md-justify-between alinean solo en pantallas anchas. dg-hidden dg-lg-block muestra algo solo desde lg (y dg-lg-hidden lo oculta).",
    html: `<div class="dg-flex dg-flex-col dg-md-flex-row dg-md-items-center dg-md-justify-between dg-gap-3 dg-bg-sand dg-p-5 dg-rounded-lg">
  <div>
    <p class="dg-fw-bold dg-mb-1">Plan Estudio</p>
    <p class="dg-muted dg-text-sm dg-mb-0">Todo lo necesario para un equipo pequeño.</p>
  </div>
  <span class="dg-hidden dg-lg-block dg-text-sm dg-muted">Solo en escritorio</span>
  <a class="dg-btn" href="#">Elegir plan</a>
</div>`,
  },
  {
    id: "texto",
    title: "Texto: recortes, mayúsculas y listas",
    desc: "dg-line-clamp-{1…5} corta el texto a ese número de líneas con puntos suspensivos. dg-lowercase, dg-capitalize y dg-normal-case cambian las mayúsculas; dg-list-none quita viñetas y sangría (dg-list-disc, -decimal y -inside las configuran).",
    html: `<div class="dg-grid-cols-1 dg-md-grid-cols-2 dg-gap-5">
  <p class="dg-line-clamp-2 dg-mb-0">Este párrafo es largo a propósito para mostrar cómo dg-line-clamp-2 lo recorta a dos líneas, sin importar el ancho del contenedor, y termina con puntos suspensivos cuando el texto no cabe completo.</p>
  <ul class="dg-list-none dg-mb-0">
    <li class="dg-capitalize">primer elemento sin viñeta</li>
    <li class="dg-capitalize">segundo elemento sin viñeta</li>
  </ul>
</div>`,
  },
  {
    id: "esquinas",
    title: "Esquinas por lado",
    desc: "dg-rounded-t, -b, -l y -r redondean un lado con el radio por defecto; agrega -sm, -lg, -xl, -pill o -0 para cambiar el radio. Para un arco en una sola esquina: dg-rounded-tl-full (y tr, bl, br).",
    html: `<div class="dg-flex dg-wrap dg-gap-3">
  <div class="dg-size-96 dg-bg-sand dg-rounded-t-xl"></div>
  <div class="dg-size-96 dg-bg-sand dg-rounded-b-xl"></div>
  <div class="dg-size-96 dg-bg-sand dg-rounded-l-pill"></div>
  <div class="dg-size-96 dg-bg-sand dg-rounded-tl-full"></div>
</div>`,
  },
  {
    id: "grupo",
    title: "Hover y grupos: tarjetas que reaccionan",
    desc: "Pon dg-group en el contenedor (un enlace o una card) y dg-group-hover-* en sus hijos: la foto se acerca, la flecha se mueve en diagonal y el título se subraya cuando pasas el cursor o enfocas con teclado. dg-hover-* hace lo mismo sobre el propio elemento. Las transiciones respetan reducir movimiento.",
    html: `<a class="dg-group dg-block dg-w-320 dg-max-w-full dg-no-underline" href="#">
  <div class="dg-overflow-hidden dg-rounded-lg dg-aspect-4-3">
    <img class="dg-w-full dg-h-full dg-object-cover dg-group-hover-scale-105" src="https://images.pexels.com/photos/6615804/pexels-photo-6615804.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Interior minimalista" loading="lazy">
  </div>
  <div class="dg-flex dg-justify-between dg-items-center dg-pt-3">
    <span class="dg-fw-medium dg-group-hover-underline">Casa Ladera</span>
    <span class="dg-group-hover-nudge" aria-hidden="true">↗</span>
  </div>
</a>`,
  },
  {
    id: "listas",
    title: "Espacio y líneas entre elementos",
    desc: "dg-space-y-* separa a los hijos sin tocar al primero, y dg-divide-y dibuja una línea fina entre ellos (es un fondo de 1px, así que el reset que quita los bordes la respeta). dg-tabular-nums alinea las cifras.",
    html: `<ul class="dg-list-none dg-divide-y dg-max-w-400 dg-mb-0">
  <li class="dg-flex dg-justify-between dg-py-3"><span>Plan Estudio</span><span class="dg-tabular-nums">$ 1,200</span></li>
  <li class="dg-flex dg-justify-between dg-py-3"><span>Plan Equipo</span><span class="dg-tabular-nums">$ 4,850</span></li>
  <li class="dg-flex dg-justify-between dg-py-3"><span>Plan Empresa</span><span class="dg-tabular-nums">$ 12,000</span></li>
</ul>`,
  },
  {
    id: "velo",
    title: "Texto sobre foto con velo",
    desc: "Una capa dg-absolute dg-inset-0 con dg-scrim-b oscurece la parte de abajo de la foto para que el texto claro se lea; dg-scrim-t lo hace arriba, dg-scrim-full en toda la foto y dg-scrim-light-b aclara para texto oscuro.",
    html: `<div class="dg-relative dg-overflow-hidden dg-rounded-lg dg-aspect-16-10 dg-max-w-480">
  <img class="dg-absolute dg-inset-0 dg-w-full dg-h-full dg-object-cover" src="https://images.pexels.com/photos/7078717/pexels-photo-7078717.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Fachada blanca curva" loading="lazy">
  <div class="dg-absolute dg-inset-0 dg-scrim-b"></div>
  <div class="dg-absolute dg-bottom-0 dg-left-0 dg-p-5 dg-ink-white">
    <p class="dg-text-xs dg-uppercase dg-tracking-widest dg-mb-1">Proyecto</p>
    <p class="dg-text-2xl dg-fw-medium dg-mb-0">Fachada Alto Sereno</p>
  </div>
</div>`,
  },
  {
    id: "editorial",
    title: "Texto fluido y columnas",
    desc: "dg-text-fluid-{sm, md, lg, xl} crece con la ventana entre un mínimo y un máximo, sin saltos; para tamaños fijos más grandes hay dg-text-6xl a 9xl. dg-columns-{1…4} reparte un texto largo en columnas (con dg-md-columns-2 solo desde tablet) y dg-break-inside-avoid evita que un bloque se parta.",
    html: `<h2 class="dg-text-fluid-md dg-fw-light dg-tracking-tighter dg-leading-none dg-mb-5">Hecho a mano</h2>
<div class="dg-columns-1 dg-md-columns-2 dg-gap-x-7 dg-text-sm dg-text-pretty">
  <p>Cada pieza empieza en el taller con un boceto a lápiz y una conversación larga sobre cómo se va a usar. Elegimos maderas locales, secadas al aire, y dejamos que su veta decida la forma final.</p>
  <p>El acabado es aceite natural, sin barnices. Con los años la superficie toma el color de la casa y de quien la usa; por eso cada mueble viene con instrucciones para cuidarlo y una garantía de por vida.</p>
</div>`,
  },
  {
    id: "transformar",
    title: "Rotar, escalar y centrar",
    desc: "dg-rotate-*, dg-scale-* y dg-translate-* usan propiedades separadas, así que se combinan entre sí (dg-rotate-n3 dg-scale-105). dg-center-abs centra un elemento absoluto en su contenedor; dg-flip-x lo refleja.",
    html: `<div class="dg-relative dg-h-240 dg-bg-sand dg-rounded-lg dg-overflow-hidden">
  <div class="dg-absolute dg-top-5 dg-left-5 dg-size-96 dg-bg-graphite dg-rounded-lg dg-rotate-n6"></div>
  <span class="dg-center-abs dg-badge dg-badge-solid dg-rotate-3 dg-scale-125">dg-center-abs</span>
  <div class="dg-absolute dg-bottom-5 dg-right-5 dg-size-64 dg-bg-sand-deep dg-rounded-tl-full dg-flip-x"></div>
</div>`,
  },
];
---

<Layout
  title="Escalas"
  lead="Todas las utilidades de espaciado, tamaño, posición, grid y texto con escalas completas, y sus versiones responsivas. Con ellas una página entera se arma solo con clases."
  currentHref="/fundamentos/escalas"
>
  <div class="doc-sub" id="tabla">Referencia de escalas</div>
  <p class="dg-muted dg-text-sm dg-mb-4">Cada familia tiene todos los pasos de su escala; no se agregan pasos por diseño. Los valores en px van sin sufijo (dg-w-240), los porcentajes con p (dg-w-50p) y las medidas de pantalla con vw / vh (dg-h-50vh).</p>
  <div class="dg-overflow-x-auto dg-mb-6">
    <table class="dg-table">
      <thead><tr><th>Familia</th><th>Clases</th><th>Pasos</th></tr></thead>
      <tbody>
        {scales.map((row) => (
          <tr><td class="dg-fw-medium dg-no-wrap">{row.family}</td><td><code class="dg-code">{row.classes}</code></td><td class="dg-text-sm">{row.steps}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="dg-callout dg-callout-info dg-mb-6">
    <p class="dg-callout-title">Versiones responsivas: dg-md-*, dg-lg-*, dg-xl-*</p>
    Desde 768, 992 y 1200 px. Existen para: {responsive}.
  </div>

  {examples.map((example) => (
    <>
      <div class="doc-sub" id={example.id}>{example.title}</div>
      <p class="dg-muted dg-text-sm dg-mb-4">{example.desc}</p>
      <div class="doc-example">
        <div class="doc-demo is-plain"><Fragment set:html={example.html} /></div>
        <Code>{example.html}</Code>
      </div>
    </>
  ))}
</Layout>
