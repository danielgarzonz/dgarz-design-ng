---
import Layout from "../../layouts/DocsLayout.astro";

const themes = [
  {
    key: "sharp",
    name: "Sin Border Radius",
    lead: "Rectas, estrictas y con sensación más técnica o enterprise.",
    tokens: "--dg-radius-sm: 0px, --dg-radius: 0px, --dg-radius-lg: 0px",
  },
  {
    key: "semi",
    name: "Semi Redondeado",
    lead: "Todavía sobrio, pero con suavidad ligera para producto moderno.",
    tokens: "--dg-radius-sm: 6px, --dg-radius: 10px, --dg-radius-lg: 16px",
  },
  {
    key: "rounded",
    name: "Redondeado",
    lead: "El equilibrio clásico de dgarz studio para dashboards y apps.",
    tokens: "--dg-radius-sm: 8px, --dg-radius: 14px, --dg-radius-lg: 22px",
  },
  {
    key: "pill",
    name: "Bastante Redondeado",
    lead: "Más amable, más visual, ideal para experiencias premium o brand-forward.",
    tokens: "--dg-radius-sm: 12px, --dg-radius: 18px, --dg-radius-lg: 28px",
  },
];
---

<Layout
  title="Temas"
  lead="Con dgarz studio no solo cambias colores: también puedes mover la personalidad visual del sistema ajustando radios, superficies y contraste."
  currentHref="/studio/themes"
>
  <div class="dg-callout dg-callout-info dg-mb-5">
    <p class="dg-callout-title">Idea</p>
    La misma base de componentes puede sentirse más técnica, más editorial o más amable
    sin rehacer la UI. Aquí usamos el dashboard como referencia para mostrar cuatro
    direcciones visuales dentro del mismo sistema.
  </div>

  <div class="doc-sub">Los 4 estilos base</div>
  <div class="doc-theme-grid">
    {themes.map((theme) => (
      <article class="dg-card doc-theme-card">
        <div class="doc-theme-frame">
          <iframe
            src={`/examples/dashboard.html?theme=${theme.key}`}
            title={`${theme.name} preview`}
            loading="lazy"
          ></iframe>
        </div>
        <div class="dg-card-body">
          <div class="dg-flex dg-items-center dg-justify-between dg-gap-3">
            <span class="dg-badge">{theme.name}</span>
            <span class="dg-text-xs dg-muted">Dashboard base</span>
          </div>
          <h3 class="dg-card-title dg-text-xl dg-mt-3">{theme.name}</h3>
          <p class="dg-muted dg-text-sm dg-mt-2">{theme.lead}</p>
          <div class="doc-sub doc-theme-sub">Token guía</div>
          <div class="doc-theme-token">{theme.tokens}</div>
          <a class="dg-btn dg-btn-glass dg-btn-sm dg-mt-4" href={`/examples/dashboard.html?theme=${theme.key}`} target="_blank" rel="noopener">
            Abrir variante
          </a>
        </div>
      </article>
    ))}
  </div>

  <div class="doc-sub">Qué cambia realmente</div>
  <div class="dg-grid dg-grid-2">
    <article class="dg-card">
      <div class="dg-card-body">
        <h3 class="dg-card-title dg-text-xl">Forma</h3>
        <p class="dg-muted dg-text-sm dg-mt-2">El cambio principal viene de los radios: cards, botones, tablas, badges, modales y campos heredan otra personalidad visual al instante.</p>
      </div>
    </article>
    <article class="dg-card">
      <div class="dg-card-body">
        <h3 class="dg-card-title dg-text-xl">Sensación de producto</h3>
        <p class="dg-muted dg-text-sm dg-mt-2">Sin tocar la arquitectura del dashboard, el cliente puede ver si su marca pide algo más rígido, más equilibrado o más expresivo.</p>
      </div>
    </article>
  </div>

  <div class="doc-sub">Patrón recomendado</div>
  <p class="dg-muted dg-text-sm dg-mb-4">Cambia los tokens del tema en un solo lugar en vez de reescribir los componentes.</p>
  <div class="doc-code" data-lang="css">
    <button class="cp">Copiar</button>
    <pre>{`/* Tema sharp */
[data-studio-theme="sharp"] {
  --dg-radius-sm: 0px;
  --dg-radius: 0px;
  --dg-radius-lg: 0px;
  --dg-radius-xl: 0px;
}

/* Tema semi */
[data-studio-theme="semi"] {
  --dg-radius-sm: 6px;
  --dg-radius: 10px;
  --dg-radius-lg: 16px;
  --dg-radius-xl: 20px;
}

/* Tema pill */
[data-studio-theme="pill"] {
  --dg-radius-sm: 12px;
  --dg-radius: 18px;
  --dg-radius-lg: 28px;
  --dg-radius-xl: 36px;
}`}</pre>
  </div>

  <style>
    .doc-theme-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--dg-space-5);
    }

    .doc-theme-card {
      overflow: hidden;
    }

    .doc-theme-frame {
      padding: var(--dg-space-4);
      background: var(--dg-surface-2);
      border-bottom: 1px solid var(--dg-border);
    }

    .doc-theme-frame iframe {
      width: 100%;
      height: 320px;
      border: 0;
      border-radius: var(--dg-radius);
      background: var(--dg-paper);
      box-shadow: var(--dg-shadow-2);
    }

    .doc-theme-token {
      font-family: var(--dg-font-mono);
      font-size: var(--dg-text-xs);
      color: var(--dg-text-muted);
      background: var(--dg-surface-2);
      border: 1px solid var(--dg-border);
      border-radius: var(--dg-radius-sm);
      padding: var(--dg-space-3);
      margin-top: var(--dg-space-2);
    }

    .doc-theme-sub {
      margin-top: var(--dg-space-5);
      margin-bottom: var(--dg-space-2);
    }

    @media (max-width: 980px) {
      .doc-theme-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
