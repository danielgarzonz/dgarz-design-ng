---
import Layout from "../../layouts/DocsLayout.astro";
import { allExamples } from "../../data/examples";

// Regla de la colección: cada ejemplo usa solo clases del framework (dg-*).
// Sin CSS propio ni estilos inline — si algo no se puede construir con dgarz design, no va aquí.

export function getStaticPaths() {
  return allExamples.map((example) => ({
    params: { slug: example.slug },
    props: { example },
  }));
}

const { example } = Astro.props;
const slug = example.slug as string;

const photo = {
  portrait: "https://images.pexels.com/photos/16245933/pexels-photo-16245933.jpeg?auto=compress&w=800",
  surreal: "https://images.pexels.com/photos/20212633/pexels-photo-20212633.jpeg?auto=compress&w=1200",
  workspace: "https://images.pexels.com/photos/34147402/pexels-photo-34147402.jpeg?auto=compress&w=1200",
  interior: "https://images.pexels.com/photos/6615804/pexels-photo-6615804.jpeg?auto=compress&w=800",
  phone: "https://images.pexels.com/photos/5053841/pexels-photo-5053841.jpeg?auto=compress&w=800",
  fashion: "https://images.pexels.com/photos/34426766/pexels-photo-34426766.jpeg?auto=compress&w=1200",
};

const skinClass = {
  cool: "dg-surface-gradient-cool",
  neutral: "dg-bg-surface-2",
  warm: "dg-surface-gradient-warm",
  aurora: "dg-surface-gradient-aurora",
  dark: "dg-bg-dark",
}[example.skin];

const icon = (name: string) => `#dg-${name}`;

function is(name: string) {
  return slug.includes(name);
}
---

<Layout title={example.title} lead={example.desc} currentHref="/examples">
  <div class="dg-flex dg-items-center dg-justify-between dg-gap-3 dg-wrap dg-mb-4 dg-text-sm">
    <a class="dg-link" href="/examples">← Volver a la colección</a>
    <span class="dg-muted">{example.tag} / {example.components.slice(0, 2).join(" · ")}</span>
  </div>

  <div data-theme={example.skin === "dark" ? "dark" : undefined} class:list={["dg-rounded-xl dg-overflow-hidden dg-p-5 dg-min-h-420", skinClass]}>
    {example.tag === "Desktop" && (
      <div class="dg-stack dg-gap-4">

        {is("social-profile") && (
          <>
            <article class="dg-card dg-surface-glass-strong dg-overflow-hidden">
              <img class="dg-w-full dg-aspect-3-1 dg-object-cover" src={photo.surreal} alt="" loading="lazy" />
              <div class="dg-card-body dg-flex dg-items-end dg-justify-between dg-gap-4 dg-wrap">
                <div class="dg-flex dg-items-center dg-gap-4">
                  <img class="dg-avatar dg-avatar-xl" src={photo.portrait} alt="Andrea Ruiz" loading="lazy" />
                  <div>
                    <h2 class="dg-h3">Andrea Ruiz</h2>
                    <p class="dg-muted dg-text-sm">Designer, educator and creative systems builder.</p>
                  </div>
                </div>
                <div class="dg-cluster dg-gap-2">
                  <button class="dg-btn dg-btn-glass dg-btn-sm">Message</button>
                  <button class="dg-btn dg-btn-gradient dg-btn-sm">Follow</button>
                </div>
              </div>
            </article>
            <div class="dg-grid dg-grid-3">
              <div class="dg-stat dg-surface-glass"><div class="dg-stat-label">Followers</div><div class="dg-stat-value">24.8K</div></div>
              <div class="dg-stat dg-surface-glass"><div class="dg-stat-label">Projects</div><div class="dg-stat-value">312</div></div>
              <div class="dg-stat dg-surface-glass"><div class="dg-stat-label">Rating</div><div class="dg-stat-value">4.9</div></div>
            </div>
            <div class="dg-grid dg-grid-2">
              <article class="dg-card dg-card-hover"><div class="dg-card-body"><span class="dg-eyebrow">Pinned post</span><h3 class="dg-card-title dg-mt-2">Building interfaces that feel selected, not generated.</h3></div></article>
              <article class="dg-card dg-card-hover dg-surface-glass"><div class="dg-card-body"><span class="dg-eyebrow">Collection</span><h3 class="dg-card-title dg-mt-2">Glass surfaces for dashboards</h3></div></article>
            </div>
          </>
        )}

        {is("calendar-booking") && (
          <div class="dg-row">
            <section class="dg-col-12 dg-col-lg-7">
              <div class="dg-card dg-surface-glass-strong">
                <div class="dg-card-header dg-card-header-row">
                  <div>
                    <div class="dg-text-sm dg-muted">Junio 2026</div>
                    <h2 class="dg-card-title">Appointments</h2>
                  </div>
                  <button class="dg-btn dg-btn-gradient dg-btn-sm">New booking</button>
                </div>
                <div class="dg-card-body">
                  <div class="dg-cal-grid">
                    {["Lu","Ma","Mi","Ju","Vi","Sa","Do"].map((d) => <div class="dg-cal-weekday">{d}</div>)}
                    {Array.from({ length: 35 }).map((_, i) => (
                      <div class:list={["dg-cal-day", i >= 30 && "is-empty", i === 11 && "is-selected", i === 5 && "is-today"]}>{i < 30 ? i + 1 : ""}</div>
                    ))}
                  </div>
                </div>
              </div>
            </section>
            <section class="dg-col-12 dg-col-lg-5">
              <div class="dg-card">
                <div class="dg-card-header"><h3 class="dg-card-title">Today</h3></div>
                <div class="dg-list dg-border-0 dg-rounded-0">
                  <div class="dg-list-item"><span class="dg-font-mono dg-text-sm dg-fw-semi">09:00</span><div class="dg-list-title">Consultation call</div><span class="dg-list-end dg-badge dg-badge-success">Confirmed</span></div>
                  <div class="dg-list-item"><span class="dg-font-mono dg-text-sm dg-fw-semi">11:30</span><div class="dg-list-title">Studio review</div><span class="dg-list-end dg-badge dg-badge-warning">Pending</span></div>
                  <div class="dg-list-item"><span class="dg-font-mono dg-text-sm dg-fw-semi">16:00</span><div class="dg-list-title">Project kickoff</div><span class="dg-list-end dg-badge">Draft</span></div>
                </div>
                <div class="dg-card-footer">
                  <label class="dg-label" for="bookDate">Reprogramar</label>
                  <input class="dg-input dg-datepicker" id="bookDate" placeholder="DD/MM/AAAA" />
                </div>
              </div>
            </section>
          </div>
        )}

        {is("calculator") && (
          <div class="dg-row">
            <section class="dg-col-12 dg-col-lg-5">
              <div class="dg-card dg-surface-glass dg-h-full">
                <div class="dg-card-body">
                  <div class="dg-stat-label">Revenue forecast</div>
                  <div class="dg-text-5xl dg-fw-bold dg-mt-3">$18,480</div>
                  <span class="dg-glass-pill dg-mt-4">Saved calculation</span>
                  <div class="dg-list dg-mt-5">
                    <div class="dg-list-item"><span class="dg-list-title dg-font-mono">1,284 × 12</span><span class="dg-list-end dg-font-mono">15,408</span></div>
                    <div class="dg-list-item"><span class="dg-list-title dg-font-mono">+ 96</span><span class="dg-list-end dg-font-mono">15,504</span></div>
                  </div>
                </div>
              </div>
            </section>
            <section class="dg-col-12 dg-col-lg-7">
              <div class="dg-card dg-surface-glass-strong">
                <div class="dg-card-body">
                  <input class="dg-input dg-input-lg dg-font-mono dg-text-right" value="1,284 × 12 + 96 = 15,504" readonly aria-label="Pantalla" />
                  <div class="dg-grid dg-grid-4 dg-gap-2 dg-mt-4">
                    {["7","8","9","÷","4","5","6","×","1","2","3","−","0",".","=","+"].map((key) => (
                      <button class:list={["dg-btn dg-btn-lg", key === "=" ? "dg-btn-gradient" : "dg-btn-glass"]}>{key}</button>
                    ))}
                  </div>
                </div>
              </div>
            </section>
          </div>
        )}

        {is("hero-landing") && (
          <div class="dg-row dg-items-center">
            <section class="dg-col-12 dg-col-lg-6">
              <span class="dg-glass-pill">New collection</span>
              <h1 class="dg-display dg-mt-4">A product system with minimal structure and expressive surfaces.</h1>
              <p class="dg-lead dg-muted dg-mt-3">Build faster with coherent cards, forms, CTAs and visual presets that still feel intentional.</p>
              <div class="dg-cluster dg-gap-3 dg-mt-5">
                <button class="dg-btn dg-btn-gradient dg-btn-lg">Start free</button>
                <button class="dg-btn dg-btn-glass dg-btn-lg">See demo</button>
              </div>
            </section>
            <section class="dg-col-12 dg-col-lg-6">
              <div class="dg-card dg-surface-glass-strong">
                <div class="dg-card-body dg-stack dg-gap-4">
                  <img class="dg-w-full dg-aspect-video dg-object-cover dg-rounded-lg" src={photo.workspace} alt="" loading="lazy" />
                  <div class="dg-grid dg-grid-2">
                    <div class="dg-stat dg-surface-glass"><div class="dg-stat-label">Growth</div><div class="dg-stat-value">+73.6%</div></div>
                    <div class="dg-stat dg-surface-glass"><div class="dg-stat-label">Teams</div><div class="dg-stat-value">12K</div></div>
                  </div>
                </div>
              </div>
            </section>
          </div>
        )}

        {is("slider-editorial") && (
          <>
            <div class="dg-carousel" data-dg-carousel>
              <div class="dg-carousel-inner">
                {[
                  { src: photo.fashion, eyebrow: "Featured", title: "Designing premium interfaces with restraint" },
                  { src: photo.portrait, eyebrow: "Issue 01", title: "The new softness" },
                  { src: photo.workspace, eyebrow: "Issue 02", title: "Data with atmosphere" },
                ].map((s) => (
                  <div class="dg-carousel-item">
                    <img class="dg-carousel-slide" src={s.src} alt={s.title} loading="lazy" />
                    <div class="dg-carousel-caption">
                      <span class="dg-eyebrow">{s.eyebrow}</span>
                      <h3>{s.title}</h3>
                    </div>
                  </div>
                ))}
              </div>
              <button class="dg-carousel-prev" aria-label="Anterior">‹</button>
              <button class="dg-carousel-next" aria-label="Siguiente">›</button>
              <div class="dg-carousel-indicators">
                {[0, 1, 2].map((n) => <button data-dg-carousel-go={n} aria-label={`Diapositiva ${n + 1}`}></button>)}
              </div>
            </div>
            <div class="dg-grid dg-grid-3">
              {[
                { src: photo.portrait, issue: "Issue 01", title: "The new softness" },
                { src: photo.workspace, issue: "Issue 02", title: "Data with atmosphere" },
                { src: photo.interior, issue: "Issue 03", title: "Interfaces with memory" },
              ].map((c) => (
                <article class="dg-card dg-card-hover dg-surface-glass">
                  <img class="dg-card-img" src={c.src} alt="" loading="lazy" />
                  <div class="dg-card-body">
                    <span class="dg-eyebrow">{c.issue}</span>
                    <h3 class="dg-card-title dg-mt-2">{c.title}</h3>
                  </div>
                </article>
              ))}
            </div>
          </>
        )}

        {is("order-confirmation") && (
          <div class="dg-row">
            <section class="dg-col-12 dg-col-lg-7">
              <div class="dg-card dg-surface-glass-strong">
                <div class="dg-card-header dg-card-header-row">
                  <div>
                    <div class="dg-text-sm dg-muted">Order confirmed</div>
                    <h2 class="dg-card-title dg-font-mono">#1298907</h2>
                  </div>
                  <span class="dg-badge dg-badge-success">Paid</span>
                </div>
                <div class="dg-list dg-border-0 dg-rounded-0">
                  <div class="dg-list-item"><span class="dg-list-meta">Delivery address</span><span class="dg-list-end dg-list-title">Mexico City, MX</span></div>
                  <div class="dg-list-item"><span class="dg-list-meta">Estimated arrival</span><span class="dg-list-end dg-list-title">June 12</span></div>
                  <div class="dg-list-item"><span class="dg-list-meta">Payment method</span><span class="dg-list-end dg-list-title">Visa ending 9012</span></div>
                </div>
              </div>
            </section>
            <section class="dg-col-12 dg-col-lg-5">
              <div class="dg-card dg-surface-glass">
                <div class="dg-card-header"><h3 class="dg-card-title">Tracking</h3></div>
                <div class="dg-card-body">
                  <div class="dg-timeline">
                    <div class="dg-timeline-item is-done"><span class="dg-timeline-dot"><svg class="dg-icon dg-icon-sm"><use href={icon("check")} /></svg></span><div class="dg-timeline-body"><div class="dg-timeline-title">Order placed</div><div class="dg-timeline-date">June 8 · 10:12</div></div></div>
                    <div class="dg-timeline-item is-done"><span class="dg-timeline-dot"><svg class="dg-icon dg-icon-sm"><use href={icon("check")} /></svg></span><div class="dg-timeline-body"><div class="dg-timeline-title">Payment approved</div><div class="dg-timeline-date">June 8 · 10:13</div></div></div>
                    <div class="dg-timeline-item is-active"><span class="dg-timeline-dot"></span><div class="dg-timeline-body"><div class="dg-timeline-title">Shipped</div><div class="dg-timeline-date">In progress</div></div></div>
                    <div class="dg-timeline-item"><span class="dg-timeline-dot"></span><div class="dg-timeline-body"><div class="dg-timeline-title">Delivered</div><div class="dg-timeline-date">Estimated June 12</div></div></div>
                  </div>
                </div>
              </div>
            </section>
          </div>
        )}

        {is("chat-view") && (
          <div class="dg-row">
            <aside class="dg-col-12 dg-col-lg-4">
              <div class="dg-card dg-surface-glass">
                <div class="dg-card-header dg-card-header-row">
                  <h3 class="dg-card-title">Inbox</h3>
                  <span class="dg-glass-pill">8 chats</span>
                </div>
                <div class="dg-list dg-border-0 dg-rounded-0">
                  {[
                    { name: "Acme team", text: "Need the final deck and updated CTA states before Friday.", time: "2m", unread: 3, img: photo.portrait, active: true },
                    { name: "Maria Soto", text: "See you at 4pm. I already uploaded the revised copy.", time: "18m", img: photo.surreal },
                    { name: "Support", text: "Ticket updated. Customer is asking for a refund flow preview.", time: "1h", initials: "SP" },
                    { name: "Javier Luna", text: "Can you share the staging link once the pricing table is live?", time: "3h", initials: "JL" },
                  ].map((c) => (
                    <div class:list={["dg-list-item", c.active && "dg-bg-surface-2"]}>
                      {c.img ? <img class="dg-avatar dg-no-shrink" src={c.img} alt="" loading="lazy" /> : <span class="dg-avatar dg-no-shrink">{c.initials}</span>}
                      <div class="dg-min-w-0">
                        <div class="dg-list-title">{c.name}</div>
                        <div class="dg-list-meta dg-truncate">{c.text}</div>
                      </div>
                      <div class="dg-list-end dg-stack dg-gap-1 dg-items-end dg-text-xs">
                        <span>{c.time}</span>
                        {c.unread && <span class="dg-badge dg-badge-solid">{c.unread}</span>}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </aside>
            <section class="dg-col-12 dg-col-lg-8">
              <div class="dg-card">
                <div class="dg-card-header dg-card-header-row">
                  <div class="dg-flex dg-items-center dg-gap-3">
                    <img class="dg-avatar" src={photo.portrait} alt="" loading="lazy" />
                    <div>
                      <h3 class="dg-card-title">Acme team</h3>
                      <div class="dg-text-sm dg-muted">4 people online</div>
                    </div>
                  </div>
                  <button class="dg-btn dg-btn-glass dg-btn-sm">Archive</button>
                </div>
                <div class="dg-card-body dg-stack dg-gap-3">
                  <div class="dg-divider-label">Today · 11:42 AM</div>
                  <div class="dg-card dg-bg-surface-2 dg-max-w-480">
                    <div class="dg-card-body dg-p-4 dg-text-sm">
                      <div class="dg-flex dg-justify-between dg-mb-1"><strong>Camila</strong><span class="dg-muted dg-text-xs">11:43</span></div>
                      Can we ship the updated UI by Friday? The stakeholders want chat, pricing and order flows in one pass.
                    </div>
                  </div>
                  <div class="dg-card dg-bg-dark dg-max-w-480 dg-ml-auto" data-theme="dark">
                    <div class="dg-card-body dg-p-4 dg-text-sm">
                      <div class="dg-flex dg-justify-between dg-mb-1"><strong>You</strong><span class="dg-muted dg-text-xs">11:46</span></div>
                      Yes, I am polishing the cards and modal states now. Everything in this view is built with framework classes only.
                    </div>
                  </div>
                  <div class="dg-card dg-bg-surface-2 dg-max-w-480">
                    <div class="dg-card-body dg-p-4 dg-text-sm">
                      <div class="dg-flex dg-justify-between dg-mb-1"><strong>Diego</strong><span class="dg-muted dg-text-xs">11:49</span></div>
                      Perfect. Share the staging link once the sidebar list and conversation panel are both ready.
                    </div>
                  </div>
                </div>
                <div class="dg-card-footer">
                  <div class="dg-input-group">
                    <input class="dg-input" placeholder="Write a message" aria-label="Mensaje" />
                    <button class="dg-btn dg-btn-gradient">Send</button>
                  </div>
                </div>
              </div>
            </section>
          </div>
        )}

        {is("gallery") && (
          <>
            <div class="dg-flex dg-items-center dg-justify-between dg-gap-4 dg-wrap">
              <div>
                <h2 class="dg-h3">Gallery explorer</h2>
                <p class="dg-muted dg-text-sm">Visual work, organized by mood and palette. Click a photo to open the lightbox.</p>
              </div>
              <div class="dg-segmented" data-dg-segmented>
                <button class="dg-btn dg-btn-sm is-active">All</button>
                <button class="dg-btn dg-btn-sm">Editorial</button>
                <button class="dg-btn dg-btn-sm">Motion</button>
              </div>
            </div>
            <div class="dg-gallery">
              {[
                { src: photo.portrait, caption: "Portrait" },
                { src: photo.workspace, caption: "Workspace" },
                { src: photo.interior, caption: "Interior" },
                { src: photo.fashion, caption: "Fashion" },
                { src: photo.surreal, caption: "Surreal" },
                { src: photo.phone, caption: "Mobile" },
              ].map((g) => (
                <div class="dg-gallery-item" data-caption={g.caption}>
                  <img src={g.src} alt={g.caption} loading="lazy" />
                  <div class="dg-gallery-item-overlay"><svg class="dg-icon"><use href={icon("search")} /></svg></div>
                </div>
              ))}
            </div>
          </>
        )}

        {is("event-modal") && (
          <>
            <div class="dg-flex dg-justify-center">
              <div class="dg-card dg-surface-glass-strong dg-max-w-520 dg-w-full">
                <div class="dg-card-body">
                  <div class="dg-flex dg-items-start dg-justify-between dg-gap-3">
                    <div>
                      <span class="dg-glass-pill">Live event</span>
                      <h2 class="dg-h3 dg-mt-3">Design systems beyond utility</h2>
                    </div>
                    <button class="dg-btn dg-btn-glass dg-btn-icon" aria-label="Cerrar"><svg class="dg-icon dg-icon-sm"><use href={icon("x")} /></svg></button>
                  </div>
                  <div class="dg-cluster dg-gap-2 dg-mt-4">
                    <span class="dg-chip"><svg class="dg-icon dg-icon-sm"><use href={icon("calendar")} /></svg>June 26 · 18:00</span>
                    <span class="dg-chip">CDMX · 120 seats</span>
                    <span class="dg-chip">Afterparty included</span>
                  </div>
                  <div class="dg-flex dg-items-center dg-gap-3 dg-mt-4">
                    <div class="dg-avatar-group">
                      <img class="dg-avatar" src={photo.portrait} alt="" loading="lazy" />
                      <img class="dg-avatar" src={photo.surreal} alt="" loading="lazy" />
                      <span class="dg-avatar">JL</span>
                      <span class="dg-avatar">+1</span>
                    </div>
                    <span class="dg-text-sm dg-muted">4 speakers</span>
                  </div>
                  <div class="dg-grid dg-grid-2 dg-gap-2 dg-mt-5">
                    <button class="dg-btn dg-btn-glass dg-btn-block">Maybe later</button>
                    <button class="dg-btn dg-btn-gradient dg-btn-block" data-dg-open="#eventModal">Reserve seat</button>
                  </div>
                </div>
              </div>
            </div>
            <div class="dg-modal-backdrop" id="eventModalBd" hidden></div>
            <div class="dg-modal dg-modal-sm dg-modal-confirm" id="eventModal" data-dg-backdrop="#eventModalBd" hidden>
              <div class="dg-modal-body">
                <span class="dg-modal-icon dg-text-success"><svg class="dg-icon dg-icon-lg"><use href={icon("check")} /></svg></span>
                <h3 class="dg-modal-title">Seat reserved</h3>
                <p class="dg-muted dg-text-sm">We sent the ticket to your email.</p>
              </div>
              <div class="dg-modal-footer">
                <button class="dg-btn dg-btn-primary dg-btn-block" data-dg-close>Done</button>
              </div>
            </div>
          </>
        )}

        {is("pricing") && (
          <>
            <div class="dg-flex dg-items-end dg-justify-between dg-gap-4 dg-wrap">
              <div>
                <h2 class="dg-h3">Pricing that scales with your system</h2>
                <p class="dg-muted dg-text-sm dg-measure-md">Choose a plan based on velocity, team size and how much brand expression you want built in.</p>
              </div>
              <div class="dg-flex dg-items-center dg-gap-2">
                <div class="dg-segmented" data-dg-segmented>
                  <button class="dg-btn dg-btn-sm is-active">Monthly</button>
                  <button class="dg-btn dg-btn-sm">Yearly</button>
                </div>
                <span class="dg-badge dg-badge-success">Save 18%</span>
              </div>
            </div>
            <div class="dg-pricing-grid">
              <div class="dg-pricing-card dg-surface-glass">
                <div class="dg-pricing-name">Starter</div>
                <div class="dg-pricing-price"><span class="dg-pricing-amount">$12</span><span class="dg-pricing-period">/mo</span></div>
                <p class="dg-pricing-desc">For solo creators and small projects validating a first UI language.</p>
                <hr class="dg-pricing-divider" />
                <ul class="dg-pricing-features">
                  <li class="dg-pricing-feature">Core components</li>
                  <li class="dg-pricing-feature">1 visual preset</li>
                  <li class="dg-pricing-feature">Email support (48h)</li>
                  <li class="dg-pricing-feature is-missing">Team members</li>
                </ul>
                <button class="dg-btn dg-btn-outline dg-btn-block">Choose starter</button>
              </div>
              <div class="dg-pricing-card is-featured dg-surface-glass-strong">
                <span class="dg-pricing-badge">Recommended</span>
                <div class="dg-pricing-name">Growth</div>
                <div class="dg-pricing-price"><span class="dg-pricing-amount">$29</span><span class="dg-pricing-period">/mo</span></div>
                <p class="dg-pricing-desc">Best balance for growing product teams shipping docs, dashboards and flows together.</p>
                <hr class="dg-pricing-divider" />
                <ul class="dg-pricing-features">
                  <li class="dg-pricing-feature">Core + app patterns</li>
                  <li class="dg-pricing-feature">Glass and gradient presets</li>
                  <li class="dg-pricing-feature">Priority support (24h)</li>
                  <li class="dg-pricing-feature">Up to 5 team members</li>
                </ul>
                <button class="dg-btn dg-btn-gradient dg-btn-block">Choose growth</button>
              </div>
              <div class="dg-pricing-card dg-bg-dark" data-theme="dark">
                <div class="dg-pricing-name">Scale</div>
                <div class="dg-pricing-price"><span class="dg-pricing-amount">$79</span><span class="dg-pricing-period">/mo</span></div>
                <p class="dg-pricing-desc">Advanced analytics, design reviews and a richer component roadmap for large teams.</p>
                <hr class="dg-pricing-divider" />
                <ul class="dg-pricing-features">
                  <li class="dg-pricing-feature">Unlimited product surfaces</li>
                  <li class="dg-pricing-feature">Dedicated onboarding</li>
                  <li class="dg-pricing-feature">SLA support (4h)</li>
                  <li class="dg-pricing-feature">Unlimited team members</li>
                </ul>
                <button class="dg-btn dg-btn-glass dg-btn-block">Talk to sales</button>
              </div>
            </div>
            <div class="dg-table-card dg-surface-glass">
              <table class="dg-table">
                <thead><tr><th>Feature</th><th>Starter</th><th>Growth</th><th>Scale</th></tr></thead>
                <tbody>
                  <tr><td class="dg-fw-medium">Theme variants</td><td>1 preset</td><td><span class="dg-badge dg-badge-success">3 presets</span></td><td><span class="dg-badge dg-badge-success">Custom</span></td></tr>
                  <tr><td class="dg-fw-medium">App example library</td><td>Basic</td><td><span class="dg-badge dg-badge-success">Included</span></td><td><span class="dg-badge dg-badge-success">Extended</span></td></tr>
                  <tr><td class="dg-fw-medium">Support speed</td><td>48h</td><td>24h</td><td><span class="dg-badge dg-badge-success">SLA</span></td></tr>
                </tbody>
              </table>
            </div>
          </>
        )}
      </div>
    )}

    {example.tag === "Mobile" && (
      <div class="dg-card dg-surface-glass-strong dg-rounded-xl dg-max-w-sm dg-mx-auto">
        <div class="dg-card-body dg-stack dg-gap-4">
          <div class="dg-flex dg-items-center dg-justify-between dg-text-xs">
            <span class="dg-fw-semi">9:41</span>
            <span class="dg-muted">5G · 100%</span>
          </div>

          {is("login") && (
            <>
              <img class="dg-w-full dg-aspect-video dg-object-cover dg-rounded-lg" src={photo.workspace} alt="" loading="lazy" />
              <div>
                <span class="dg-glass-pill">Welcome back</span>
                <h2 class="dg-h3 dg-mt-3">Access your workspace</h2>
                <p class="dg-text-sm dg-muted">Continue with your email or social provider.</p>
              </div>
              <div class="dg-stack dg-gap-3">
                <div class="dg-float-field">
                  <input class="dg-input" id="mLoginEmail" type="email" placeholder=" " />
                  <label for="mLoginEmail">Email address</label>
                </div>
                <div class="dg-float-field">
                  <input class="dg-input" id="mLoginPw" type="password" placeholder=" " />
                  <label for="mLoginPw">Password</label>
                </div>
                <button class="dg-btn dg-btn-gradient dg-btn-block">Log in</button>
                <div class="dg-divider-label">o</div>
                <button class="dg-btn dg-btn-glass dg-btn-block">Continue with Google</button>
              </div>
            </>
          )}

          {is("menu") && (
            <>
              <div class="dg-flex dg-items-center dg-gap-3">
                <span class="dg-avatar dg-avatar-lg">DG</span>
                <div>
                  <div class="dg-fw-semi">Daniel Garzon</div>
                  <div class="dg-text-sm dg-muted">@dgarzdesign</div>
                </div>
              </div>
              <nav class="dg-nav-vertical">
                <a class="dg-nav-item is-active" href="#"><svg class="dg-icon"><use href={icon("home")} /></svg><span>Dashboard</span></a>
                <a class="dg-nav-item" href="#"><svg class="dg-icon"><use href={icon("star")} /></svg><span>Bookmarks</span></a>
                <a class="dg-nav-item" href="#"><svg class="dg-icon"><use href={icon("bell")} /></svg><span>Notifications</span><span class="dg-badge dg-badge-solid dg-nav-badge">12</span></a>
                <a class="dg-nav-item" href="#"><svg class="dg-icon"><use href={icon("moon")} /></svg><span>Appearance</span></a>
              </nav>
              <button class="dg-btn dg-btn-ghost dg-btn-block"><svg class="dg-icon dg-icon-sm"><use href={icon("logout")} /></svg>Sign out</button>
            </>
          )}

          {is("wallet") && (
            <>
              <section class="dg-card dg-bg-dark dg-surface-shine" data-theme="dark">
                <div class="dg-card-body">
                  <div class="dg-text-sm dg-muted">Total balance</div>
                  <div class="dg-text-4xl dg-fw-bold dg-mt-1">$73,558.00</div>
                  <div class="dg-grid dg-grid-3 dg-gap-2 dg-mt-4">
                    <span class="dg-glass-pill">Visa</span>
                    <span class="dg-glass-pill">MC</span>
                    <span class="dg-glass-pill">Save</span>
                  </div>
                </div>
              </section>
              <div class="dg-list">
                <div class="dg-list-item"><span class="dg-avatar dg-avatar-sm"><svg class="dg-icon dg-icon-sm"><use href={icon("credit")} /></svg></span><div class="dg-list-title">Stripe pricing</div><span class="dg-list-end dg-fw-semi">$1,200</span></div>
                <div class="dg-list-item"><span class="dg-avatar dg-avatar-sm"><svg class="dg-icon dg-icon-sm"><use href={icon("edit")} /></svg></span><div class="dg-list-title">Figma membership</div><span class="dg-list-end dg-fw-semi">$155</span></div>
                <div class="dg-list-item"><span class="dg-avatar dg-avatar-sm"><svg class="dg-icon dg-icon-sm"><use href={icon("mail")} /></svg></span><div class="dg-list-title">Loom subscription</div><span class="dg-list-end dg-fw-semi">$100</span></div>
              </div>
              <div class="dg-segmented dg-w-full" data-dg-segmented>
                <button class="dg-btn dg-btn-sm is-active">Home</button>
                <button class="dg-btn dg-btn-sm">Cards</button>
                <button class="dg-btn dg-btn-sm">Stats</button>
              </div>
            </>
          )}

          {is("notification") && (
            <>
              <div class="dg-alert dg-alert-info">
                <svg class="dg-icon dg-icon-sm dg-alert-icon"><use href={icon("bell")} /></svg>
                <div class="dg-alert-body"><div class="dg-alert-title">Delivery update</div>Your order is arriving in 12 minutes.</div>
              </div>
              <section class="dg-card dg-surface-gradient-warm">
                <div class="dg-card-body">
                  <span class="dg-badge">Rider: Alberto</span>
                  <h2 class="dg-h3 dg-mt-3">Your order is on its way</h2>
                  <div class="dg-progress dg-mt-4"><div class="dg-progress-bar is-warning" style="width:72%"></div></div>
                  <p class="dg-text-sm dg-muted dg-mt-2">Track live from the app.</p>
                  <div class="dg-grid dg-grid-2 dg-gap-2 dg-mt-4">
                    <button class="dg-btn dg-btn-glass" data-dg-toast="Notification dismissed">Dismiss</button>
                    <button class="dg-btn dg-btn-gradient-warm" data-dg-toast="Opening live tracking…" data-dg-variant="warning">Track</button>
                  </div>
                </div>
              </section>
            </>
          )}

          {is("checkout") && (
            <>
              <div>
                <div class="dg-text-sm dg-muted">Checkout</div>
                <h2 class="dg-h3">Review your order</h2>
              </div>
              <div class="dg-steps">
                <div class="dg-step is-done"><span class="dg-step-dot"><svg class="dg-icon dg-icon-sm"><use href={icon("check")} /></svg></span><span class="dg-step-label">Cart</span></div>
                <div class="dg-step is-active"><span class="dg-step-dot">2</span><span class="dg-step-label">Pay</span></div>
                <div class="dg-step"><span class="dg-step-dot">3</span><span class="dg-step-label">Done</span></div>
              </div>
              <div class="dg-list">
                <div class="dg-list-item"><div class="dg-list-title">Travel bag</div><span class="dg-list-end">$120</span></div>
                <div class="dg-list-item"><div class="dg-list-title">Shipping</div><span class="dg-list-end">$12</span></div>
                <div class="dg-list-item"><div class="dg-list-title">Total</div><span class="dg-list-end dg-fw-bold">$132</span></div>
              </div>
              <div class="dg-field">
                <label class="dg-label" for="mCard">Card number</label>
                <input class="dg-input dg-font-mono" id="mCard" data-mask="card" placeholder="0000 0000 0000 0000" />
              </div>
              <button class="dg-btn dg-btn-gradient dg-btn-block">Pay now</button>
            </>
          )}

          {is("social-profile") && (
            <>
              <img class="dg-w-full dg-aspect-video dg-object-cover dg-rounded-lg" src={photo.surreal} alt="" loading="lazy" />
              <div class="dg-flex dg-items-center dg-gap-3">
                <img class="dg-avatar dg-avatar-lg" src={photo.portrait} alt="Andrea Ruiz" loading="lazy" />
                <div>
                  <h2 class="dg-h4">Andrea Ruiz</h2>
                  <div class="dg-text-sm dg-muted">24.8K followers</div>
                </div>
                <button class="dg-btn dg-btn-gradient dg-btn-sm dg-ml-auto">Follow</button>
              </div>
              <div class="dg-grid dg-grid-2 dg-gap-2">
                <div class="dg-stat dg-surface-glass"><div class="dg-stat-label">Posts</div><div class="dg-stat-value">312</div></div>
                <div class="dg-stat dg-surface-glass"><div class="dg-stat-label">Collections</div><div class="dg-stat-value">28</div></div>
              </div>
              <div class="dg-gallery">
                <div class="dg-gallery-item"><img src={photo.fashion} alt="Fashion" loading="lazy" /></div>
                <div class="dg-gallery-item"><img src={photo.interior} alt="Interior" loading="lazy" /></div>
              </div>
            </>
          )}

          {is("calendar") && (
            <>
              <div>
                <div class="dg-text-sm dg-muted">Today</div>
                <h2 class="dg-h3">June 6</h2>
              </div>
              <div class="dg-cal-grid">
                {["Lu","Ma","Mi","Ju","Vi","Sa","Do"].map((d) => <div class="dg-cal-weekday">{d}</div>)}
                {[1,2,3,4,5,6,7].map((d) => <div class:list={["dg-cal-day", d === 6 && "is-selected"]}>{d}</div>)}
              </div>
              <div class="dg-timeline">
                <div class="dg-timeline-item is-done"><span class="dg-timeline-dot"></span><div class="dg-timeline-body"><div class="dg-timeline-title">09:00 · Consultation</div><div class="dg-timeline-date">Video call · 30 min</div></div></div>
                <div class="dg-timeline-item is-active"><span class="dg-timeline-dot"></span><div class="dg-timeline-body"><div class="dg-timeline-title">11:30 · Review call</div><div class="dg-timeline-date">Studio · 45 min</div></div></div>
                <div class="dg-timeline-item"><span class="dg-timeline-dot"></span><div class="dg-timeline-body"><div class="dg-timeline-title">16:00 · Follow-up</div><div class="dg-timeline-date">Phone · 15 min</div></div></div>
              </div>
              <button class="dg-btn dg-btn-gradient dg-btn-block">Book a slot</button>
            </>
          )}

          {is("chat") && (
            <>
              <div class="dg-flex dg-items-center dg-gap-3">
                <img class="dg-avatar" src={photo.portrait} alt="" loading="lazy" />
                <div>
                  <div class="dg-fw-semi">Acme team</div>
                  <div class="dg-text-xs dg-muted">Friday delivery?</div>
                </div>
              </div>
              <div class="dg-stack dg-gap-2">
                <div class="dg-card dg-bg-surface-2 dg-max-w-260"><div class="dg-card-body dg-p-3 dg-text-sm">Can we share the staging link today?</div></div>
                <div class="dg-card dg-surface-gradient-cool dg-max-w-260 dg-ml-auto"><div class="dg-card-body dg-p-3 dg-text-sm">Yes, I’m finalizing cards and motion.</div></div>
                <div class="dg-card dg-bg-surface-2 dg-max-w-260"><div class="dg-card-body dg-p-3 dg-text-sm">Great. Drop it in this thread.</div></div>
              </div>
              <div class="dg-input-group">
                <input class="dg-input" placeholder="Write a message" aria-label="Mensaje" />
                <button class="dg-btn dg-btn-gradient">Send</button>
              </div>
            </>
          )}

          {is("event") && (
            <>
              <section class="dg-card dg-surface-gradient-warm">
                <div class="dg-card-body">
                  <span class="dg-badge">June 26</span>
                  <h2 class="dg-h3 dg-mt-3">Systems beyond utility</h2>
                  <p class="dg-text-sm dg-muted">Live talk · CDMX · 18:00</p>
                </div>
              </section>
              <div class="dg-flex dg-items-center dg-gap-3">
                <div class="dg-avatar-group">
                  <img class="dg-avatar" src={photo.portrait} alt="" loading="lazy" />
                  <img class="dg-avatar" src={photo.surreal} alt="" loading="lazy" />
                  <span class="dg-avatar">JL</span>
                </div>
                <span class="dg-text-sm dg-muted">4 speakers · 38 seats left</span>
              </div>
              <div class="dg-progress"><div class="dg-progress-bar is-warning" style="width:68%"></div></div>
              <button class="dg-btn dg-btn-gradient-warm dg-btn-block">Reserve seat</button>
            </>
          )}

          {is("pricing") && (
            <>
              <div class="dg-pricing-card is-featured dg-surface-glass">
                <span class="dg-pricing-badge">Recommended</span>
                <div class="dg-pricing-name">Growth plan</div>
                <div class="dg-pricing-price"><span class="dg-pricing-amount">$29</span><span class="dg-pricing-period">/ month</span></div>
                <p class="dg-pricing-desc">Best for growing teams.</p>
                <hr class="dg-pricing-divider" />
                <ul class="dg-pricing-features">
                  <li class="dg-pricing-feature">Unlimited components</li>
                  <li class="dg-pricing-feature">Theme presets</li>
                  <li class="dg-pricing-feature">Priority support</li>
                </ul>
                <button class="dg-btn dg-btn-gradient dg-btn-block">Upgrade now</button>
              </div>
              <button class="dg-btn dg-btn-ghost dg-btn-block">Compare all plans</button>
            </>
          )}
        </div>
      </div>
    )}
  </div>

  <div class="doc-sub">En qué pensar</div>
  <div class="dg-grid dg-grid-2">
    <article class="dg-card dg-surface-glass">
      <div class="dg-card-body">
        <div class="dg-text-sm dg-muted">Caso de uso</div>
        <h3 class="dg-card-title dg-mt-2">{example.focus}</h3>
      </div>
    </article>
    <article class="dg-card">
      <div class="dg-card-body">
        <div class="dg-text-sm dg-muted">Componentes clave</div>
        <div class="dg-cluster dg-mt-3 dg-gap-2 dg-wrap">
          {example.components.map((component) => (
            <span class="dg-glass-pill">{component}</span>
          ))}
        </div>
      </div>
    </article>
  </div>

  <p class="dg-text-sm dg-muted dg-mt-4">
    Fotos demo de apoyo visual vía
    <a class="dg-link" href="https://www.pexels.com/license/" target="_blank" rel="noreferrer">Pexels</a>.
  </p>
</Layout>
