          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/article&gt;
  &lt;/section&gt;
&lt;/div&gt;</Code>

  <div class="doc-sub">Serie 2 · Editorial warm</div>
  <Demo plain class="dg-surface-gradient-warm dg-rounded-xl">
    <div class="dg-grid dg-grid-2">
      <section class="dg-card dg-surface-gradient-warm">
        <div class="dg-card-body">
          <span class="dg-badge">Newsletter</span>
          <h3 class="dg-h4">Subscribe to weekly dispatch</h3>
          <p class="dg-muted dg-text-sm">Una versión más cálida y editorial, con superficies limpias y CTA marcado.</p>
          <div class="dg-stack dg-mt-4 dg-gap-3">
            <div class="dg-field">
              <label class="dg-label" for="warm-name">Full name</label>
              <input class="dg-input" id="warm-name" type="text" placeholder="Ana Rivas" />
            </div>
            <div class="dg-field">
              <label class="dg-label" for="warm-mail">Email</label>
              <input class="dg-input" id="warm-mail" type="email" placeholder="ana@studio.com" />
            </div>
          </div>
          <button class="dg-btn dg-btn-gradient-warm dg-btn-block dg-mt-4">Subscribe now</button>
        </div>
      </section>
      <section class="dg-stack dg-gap-4">
        <article class="dg-card">
          <div class="dg-card-body">
            <span class="dg-badge dg-badge-outline">Feature card</span>
            <h3 class="dg-h4 dg-mt-3">Design systems should feel chosen, not generic.</h3>
            <p class="dg-muted dg-text-sm dg-mt-3">
              Esta serie funciona bien para productos editoriales, cursos o herramientas creativas donde el contraste
              no tiene que sentirse tan “fintech”.
            </p>
          </div>
        </article>
        <article class="dg-card dg-surface-glass">
          <div class="dg-card-body">
            <div class="dg-flex dg-items-center dg-justify-between">
              <div>
                <span class="dg-badge">Modal preview</span>
                <h3 class="dg-h4 dg-mt-3">Save article</h3>
              </div>
              <button class="dg-btn dg-btn-glass dg-btn-icon" aria-label="Cerrar"><svg class="dg-icon dg-icon-sm"><use href="#dg-x"/></svg></button>
            </div>
            <div class="dg-card dg-bg-surface-2 dg-p-4 dg-mt-4">
              <div class="dg-text-sm dg-muted">Collection</div>
              <div class="dg-fw-semi">Minimal dashboards</div>
              <div class="dg-text-sm dg-muted dg-mt-3">Visibility</div>
              <div class="dg-fw-semi">Private</div>
              <div class="dg-flex dg-gap-2 dg-mt-4">
                <button class="dg-btn dg-btn-outline dg-btn-block">Later</button>
                <button class="dg-btn dg-btn-gradient-warm dg-btn-block">Save</button>
              </div>
            </div>
          </div>
        </article>
      </section>
    </div>
  </Demo>
