---
import Layout from "../../layouts/DocsLayout.astro";
import Demo from "../../components/Demo.astro";
import Code from "../../components/Code.astro";
---

<Layout
  title="Series visuales"
  lead="Ejemplos de componentes coordinados dentro de una misma identidad: formularios, cards, modales y acciones con un lenguaje visual consistente."
  currentHref="/examples/series"
>
  <div class="doc-sub">Cómo usar estas series</div>
  <p class="dg-muted dg-text-sm dg-mb-4 dg-measure-2xl">
    La idea no es darte una app completa, sino grupos de componentes coherentes entre sí. Cada serie mezcla
    <code class="dg-code">surfaces</code>, botones, formularios y jerarquía tipográfica para que el usuario
    vea cómo se comporta una identidad visual completa dentro del core.
  </p>

  <div class="doc-sub">Serie 1 · Fintech glass</div>
  <Demo plain class="dg-surface-gradient-cool dg-rounded-xl">
    <div class="dg-grid dg-grid-2">
      <section class="dg-card dg-surface-glass-strong">
        <div class="dg-card-body">
          <span class="dg-glass-pill">Form</span>
          <h3 class="dg-h4">Create savings pocket</h3>
          <p class="dg-muted dg-text-sm">Onboarding corto para abrir una nueva meta financiera.</p>
          <div class="dg-stack dg-mt-4 dg-gap-3">
            <div class="dg-float-field">
              <input class="dg-input" id="cool-pocket" type="text" placeholder=" " />
              <label for="cool-pocket">Pocket name</label>
            </div>
            <div class="dg-float-field">
              <input class="dg-input" id="cool-goal" type="number" placeholder=" " />
              <label for="cool-goal">Goal amount</label>
            </div>
            <div class="dg-float-field">
              <select class="dg-select" id="cool-plan">
                <option value="">Monthly plan</option>
                <option>$200 / month</option>
                <option>$500 / month</option>
                <option>$900 / month</option>
              </select>
              <label for="cool-plan">Contribution</label>
            </div>
          </div>
          <div class="dg-flex dg-gap-2 dg-mt-4">
            <button class="dg-btn dg-btn-glass">Later</button>
            <button class="dg-btn dg-btn-gradient">Create pocket</button>
          </div>
        </div>
      </section>
      <section class="dg-stack dg-gap-4">
        <article class="dg-card dg-surface-gradient-cool dg-surface-shine">
          <div class="dg-card-body">
            <div class="dg-flex dg-items-start dg-justify-between">
              <div>
                <span class="dg-glass-pill">Card</span>
                <h3 class="dg-h4 dg-mt-3">$23,558 saved</h3>
                <p class="dg-text-sm dg-max-w-24ch dg-text-muted">Mastercard pocket with auto-invest enabled and weekly transfers.</p>
              </div>
              <button class="dg-btn dg-btn-glass dg-btn-icon" aria-label="Abrir"><svg class="dg-icon dg-icon-sm"><use href="#dg-external"/></svg></button>
            </div>
          </div>
        </article>
        <article class="dg-card dg-surface-glass-strong">
          <div class="dg-card-body">
            <div class="dg-flex dg-items-center dg-justify-between">
              <div>
                <span class="dg-glass-pill">Modal preview</span>
                <h3 class="dg-h4 dg-mt-3">Confirm transfer</h3>
              </div>
              <button class="dg-btn dg-btn-glass dg-btn-icon" aria-label="Cerrar"><svg class="dg-icon dg-icon-sm"><use href="#dg-x"/></svg></button>
            </div>
            <div class="dg-card dg-bg-surface-2 dg-p-4 dg-mt-4">
              <div class="dg-text-sm dg-muted">Send from</div>
              <div class="dg-fw-semi">Emergency fund</div>
              <div class="dg-text-sm dg-muted dg-mt-3">To</div>
              <div class="dg-fw-semi">Travel pocket</div>
              <div class="dg-flex dg-gap-2 dg-mt-4">
                <button class="dg-btn dg-btn-glass dg-btn-block">Cancel</button>
                <button class="dg-btn dg-btn-gradient dg-btn-block">Transfer</button>
              </div>
            </div>
          </div>
        </article>
      </section>
    </div>
  </Demo>
  <Code>&lt;div class="dg-grid dg-grid-2"&gt;
