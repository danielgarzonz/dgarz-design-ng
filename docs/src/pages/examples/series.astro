  <div class="doc-sub">Serie 3 · Neutral product UI</div>
  <Demo plain class="dg-bg-surface-2 dg-rounded-xl">
    <div class="dg-grid dg-grid-2">
      <section class="dg-card">
        <div class="dg-card-body">
          <span class="dg-badge dg-badge-dot">Support</span>
          <h3 class="dg-h4">Open a request</h3>
          <p class="dg-muted dg-text-sm">Una serie más sobria para productos B2B donde la prioridad es legibilidad y neutralidad.</p>
          <div class="dg-stack dg-mt-4 dg-gap-3">
            <div class="dg-field">
              <label class="dg-label" for="neutral-subject">Subject</label>
              <input class="dg-input" id="neutral-subject" type="text" placeholder="Billing issue" />
            </div>
            <div class="dg-field">
              <label class="dg-label" for="neutral-msg">Message</label>
              <textarea class="dg-textarea" id="neutral-msg" placeholder="Describe the issue"></textarea>
            </div>
          </div>
          <div class="dg-flex dg-gap-2 dg-mt-4">
            <button class="dg-btn dg-btn-outline">Cancel</button>
            <button class="dg-btn">Submit</button>
          </div>
        </div>
      </section>
      <section class="dg-stack dg-gap-4">
        <article class="dg-card dg-card-hover">
          <div class="dg-card-body">
            <div class="dg-flex dg-items-center dg-justify-between">
              <div>
                <div class="dg-text-sm dg-muted">Status card</div>
                <h3 class="dg-h4 dg-mt-2">System healthy</h3>
              </div>
              <span class="dg-badge dg-badge-success">99.98%</span>
            </div>
            <p class="dg-muted dg-text-sm dg-mt-3">Perfecta para paneles internos o dashboards de operación.</p>
          </div>
        </article>
        <article class="dg-card">
          <div class="dg-card-body">
            <div class="dg-flex dg-items-center dg-justify-between">
              <div>
                <div class="dg-text-sm dg-muted">Modal preview</div>
                <h3 class="dg-h4 dg-mt-2">Archive project</h3>
              </div>
              <button class="dg-btn dg-btn-ghost dg-btn-icon" aria-label="Cerrar"><svg class="dg-icon dg-icon-sm"><use href="#dg-x"/></svg></button>
            </div>
            <p class="dg-muted dg-text-sm dg-mt-3">This action keeps all records but hides the project from active views.</p>
            <div class="dg-flex dg-gap-2 dg-mt-4">
              <button class="dg-btn dg-btn-outline dg-btn-block">Keep active</button>
              <button class="dg-btn dg-btn-danger dg-btn-block">Archive</button>
            </div>
          </div>
        </article>
      </section>
    </div>
  </Demo>
