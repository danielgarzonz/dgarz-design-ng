---
import "../../styles/example-collection.css";
import Preview from "../../components/examples/Preview.astro";
import Layout from "../../layouts/DocsLayout.astro";
import { desktopExamples, mobileExamples } from "../../data/examples";
---

<Layout
  title="Galería de ejemplos"
  lead="Interfaces para conectar, crear y crecer. Explora composiciones de escritorio y móvil con una identidad clara."
  currentHref="/examples"
>
  <div class="dg-card gallery-intro">
    <div class="gallery-intro-body">
      <div>
        <span class="gallery-eyebrow">DGARZ DESIGN / COLECCIÓN 01</span>
        <h2>Buenas ideas.<br /><span>Mejores interfaces.</span></h2>
        <p>Una colección para llevar tu próximo proyecto del boceto a la pantalla.</p>
      </div>
      <div class="gallery-count"><strong>20</strong><span>ideas para construir ↗</span></div>
    </div>
  </div>

  <div data-dg-tabs class="dg-mb-6">
    <div class="dg-tabs dg-tabs-pill gallery-device-tabs dg-mb-5">
      <button type="button" class="dg-tab is-active" data-dg-panel="#gallery-desktop">Escritorio · {desktopExamples.length}</button>
      <button type="button" class="dg-tab" data-dg-panel="#gallery-mobile">Móvil · {mobileExamples.length}</button>
    </div>

    <div id="gallery-desktop">
      <p class="dg-muted dg-text-sm dg-mb-4 dg-measure-lg">
        Referencias de pantalla completa o bloques hero para escritorio: navegación, densidad, cards, CTA y jerarquía en pantallas amplias.
      </p>
      <div class="doc-showcase-grid-2">
        {desktopExamples.map((example) => (
          <a class="dg-card dg-card-hover doc-gallery-card doc-gallery-link" href={`/examples/${example.slug}`}>
            <Preview example={example} />
            <div class="dg-card-body">
              <div class="dg-flex dg-items-center dg-justify-between dg-gap-3">
                <span class="dg-glass-pill">{example.tag}</span>
                <span class="dg-text-xs dg-muted">{example.components.slice(0, 2).join(" · ")}</span>
              </div>
              <h3 class="dg-card-title dg-mt-3 dg-text-xl">{example.title}</h3>
              <p class="dg-muted dg-text-sm dg-mt-2">{example.desc}</p>
              <div class="dg-text-sm dg-mt-3 doc-gallery-open">Abrir ejemplo</div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div id="gallery-mobile" hidden>
      <p class="dg-muted dg-text-sm dg-mb-4 dg-measure-lg">
        Flujos compactos: ritmo vertical, CTAs claros, fondos con identidad y tarjetas que se lean bien en un viewport angosto.
      </p>
      <div class="doc-showcase-grid-2">
        {mobileExamples.map((example) => (
          <a class="dg-card dg-card-hover doc-gallery-card doc-gallery-link" href={`/examples/${example.slug}`}>
            <Preview example={example} />
            <div class="dg-card-body">
              <div class="dg-flex dg-items-center dg-justify-between dg-gap-3">
                <span class="dg-glass-pill">{example.tag}</span>
                <span class="dg-text-xs dg-muted">{example.components.slice(0, 2).join(" · ")}</span>
              </div>
              <h3 class="dg-card-title dg-mt-3 dg-text-xl">{example.title}</h3>
              <p class="dg-muted dg-text-sm dg-mt-2">{example.desc}</p>
              <div class="dg-text-sm dg-mt-3 doc-gallery-open">Abrir ejemplo</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
