---
import Layout from "../../layouts/DocsLayout.astro";

const colorScale = [
  { label: "Primary",   chips: [
    { cls: "dg-bg-primary-subtle" },
    { cls: "dg-bg-primary-light"  },
    { cls: "dg-bg-primary",      full: true },
    { cls: "dg-bg-primary-dark", full: true },
  ]},
  { label: "Secondary", chips: [
    { cls: "dg-bg-secondary-subtle" },
    { cls: "dg-bg-secondary-light"  },
    { cls: "dg-bg-secondary",      full: true },
    { cls: "dg-bg-secondary-dark", full: true },
  ]},
  // Light and Dark are the neutral pair: one cell, each block half height.
  { label: "Light y Dark", pair: true, chips: [{ cls: "dg-bg-light", full: true }, { cls: "dg-bg-dark", full: true }] },
  { label: "Success",   chips: [
    { cls: "dg-bg-success-subtle" },
    { cls: "dg-bg-success-light"  },
    { cls: "dg-bg-success",      full: true },
    { cls: "dg-bg-success-dark", full: true },
  ]},
  { label: "Warning",   chips: [
    { cls: "dg-bg-warning-subtle" },
    { cls: "dg-bg-warning-light"  },
    { cls: "dg-bg-warning",      full: true },
    { cls: "dg-bg-warning-dark", full: true },
  ]},
  { label: "Danger",    chips: [
    { cls: "dg-bg-danger-subtle" },
    { cls: "dg-bg-danger-light"  },
    { cls: "dg-bg-danger",      full: true },
    { cls: "dg-bg-danger-dark", full: true },
  ]},
  { label: "Info",      chips: [
    { cls: "dg-bg-info-subtle" },
    { cls: "dg-bg-info-light"  },
    { cls: "dg-bg-info",      full: true },
    { cls: "dg-bg-info-dark", full: true },
  ]},
];

const gradientScale = [
  { label: "Primary",   chips: [{ cls: "dg-gradient-primary",   full: true }] },
  { label: "Secondary", chips: [{ cls: "dg-gradient-secondary", full: true }] },
  { label: "Success",   chips: [{ cls: "dg-gradient-success",   full: true }] },
  { label: "Warning",   chips: [{ cls: "dg-gradient-warning",   full: true }] },
  { label: "Danger",    chips: [{ cls: "dg-gradient-danger",    full: true }] },
  { label: "Info",      chips: [{ cls: "dg-gradient-info",      full: true }] },
];

const textColors = [
  { label: "Neutros", chips: [
    { cls: "dg-text-primary" },
    { cls: "dg-text-secondary" },
  ]},
  { label: "Primary", chips: [
    { cls: "dg-text-primary-subtle", mark: true },
    { cls: "dg-text-primary-light" },
    { cls: "dg-text-primary" },
    { cls: "dg-text-primary-dark", full: true },
  ]},
  { label: "Secondary", chips: [
    { cls: "dg-text-secondary-subtle", mark: true },
    { cls: "dg-text-secondary-light" },
    { cls: "dg-text-secondary" },
    { cls: "dg-text-secondary-dark", full: true },
  ]},
  { label: "Success", chips: [
    { cls: "dg-text-success-subtle", mark: true },
    { cls: "dg-text-success-light" },
    { cls: "dg-text-success" },
    { cls: "dg-text-success-dark", full: true },
  ]},
  { label: "Warning", chips: [
    { cls: "dg-text-warning-subtle", mark: true },
    { cls: "dg-text-warning-light" },
    { cls: "dg-text-warning" },
    { cls: "dg-text-warning-dark", full: true },
  ]},
  { label: "Danger", chips: [
    { cls: "dg-text-danger-subtle", mark: true },
    { cls: "dg-text-danger-light" },
    { cls: "dg-text-danger" },
    { cls: "dg-text-danger-dark", full: true },
  ]},
  { label: "Info", chips: [
    { cls: "dg-text-info-subtle", mark: true },
    { cls: "dg-text-info-light" },
    { cls: "dg-text-info" },
    { cls: "dg-text-info-dark", full: true },
  ]},
];

---

<Layout title="Color" lead="Tokens semánticos y utilidades de color que se invierten en dark mode." currentHref="/foundations/color">

  <!-- ── Fondos ────────────────────────────────────────────── -->
  <div class="doc-sub">Fondos</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Clases <code class="dg-code">dg-bg-*</code> que aplican fondo <strong>y</strong> color de texto implícito —
    no necesitas agregar una clase de texto adicional. Cada estado tiene tres variantes:
    subtle para alertas suaves, base sólido, y dark para énfasis.
  </p>

  <div class="doc-example">
<div class="doc-demo is-plain">
    <div class="doc-color-role-section is-bg">
      {colorScale.map(({ label, chips, pair }) => (
        <div class:list={["doc-color-role-group", pair && "is-pair"]} role="group" aria-label={label}>
          
          <div class="doc-color-role-chips">
            {chips.map(({ cls, full }) => (
              <div class:list={["doc-color-role-chip", cls, full && "full"]}><span class="doc-chip-name">{cls.replace('dg-bg-', '')}</span><code class="doc-chip-hex" data-chip-hex></code></div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="doc-code" data-code-source="manual">
    <button class="cp">Copiar</button>
    <pre>{`<!-- Valores del tema claro; en oscuro cambian solos (ver la carta). -->
<!-- El color de texto es automático, no hace falta clase extra. -->

<!-- Marca -->
<div class="dg-bg-primary-subtle">...</div> <!-- #ececee + texto #0b0b0c -->
<div class="dg-bg-primary-light">...</div>  <!-- #bcbcc3 + texto #0b0b0c -->
<div class="dg-bg-primary">...</div>        <!-- #0b0b0c + texto #ffffff -->
<div class="dg-bg-primary-dark">...</div>   <!-- #242428 + texto #ffffff -->
<div class="dg-bg-secondary-subtle">...</div><!-- #f6f6f7 + texto #62626b -->
<div class="dg-bg-secondary-light">...</div><!-- #93939c + texto #0b0b0c -->
<div class="dg-bg-secondary">...</div>      <!-- #6f6f78 + texto #ffffff -->
<div class="dg-bg-secondary-dark">...</div> <!-- #3b3b41 + texto #ffffff -->

<!-- Neutros -->
<div class="dg-bg-light">...</div>          <!-- #ececee + texto #0b0b0c -->
<div class="dg-bg-dark">...</div>           <!-- #242428 + texto #ffffff -->

<!-- Semánticos -->
<div class="dg-bg-success-subtle">...</div> <!-- #e7f8ee + texto #15803d -->
<div class="dg-bg-success-light">...</div>  <!-- #4ade80 + texto #14532d -->
<div class="dg-bg-success">...</div>        <!-- #15803d + texto #ffffff -->
<div class="dg-bg-success-dark">...</div>   <!-- #166534 + texto #ffffff -->
<div class="dg-bg-warning-subtle">...</div> <!-- #fffbeb + texto #a16207 -->
<div class="dg-bg-warning-light">...</div>  <!-- #fde047 + texto #713f12 -->
<div class="dg-bg-warning">...</div>        <!-- #eab308 + texto #1a1400 -->
<div class="dg-bg-warning-dark">...</div>   <!-- #ca8a04 + texto #1a1400 -->
<div class="dg-bg-danger-subtle">...</div>  <!-- #fef1f1 + texto #c81e1e -->
<div class="dg-bg-danger-light">...</div>   <!-- #f87171 + texto #450a0a -->
<div class="dg-bg-danger">...</div>         <!-- #dc2626 + texto #ffffff -->
<div class="dg-bg-danger-dark">...</div>    <!-- #b91c1c + texto #ffffff -->
<div class="dg-bg-info-subtle">...</div>    <!-- #eef5ff + texto #1d4ed8 -->
<div class="dg-bg-info-light">...</div>     <!-- #60a5fa + texto #172554 -->
<div class="dg-bg-info">...</div>           <!-- #2563eb + texto #ffffff -->
<div class="dg-bg-info-dark">...</div>      <!-- #1d4ed8 + texto #ffffff -->`}</pre>
  </div>
</div>

  <!-- ── Color de texto ────────────────────────────────────── -->
  <div class="doc-sub">Color de texto</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Clases <code class="dg-code">dg-text-*</code> para colorear solo el texto.
    Las variantes subtle van sobre una etiqueta de contraste (oscura en el tema claro, clara en el oscuro), porque son tonos muy cercanos al fondo.
  </p>

  <div class="doc-example">
<div class="doc-demo is-plain">
    <div class="doc-color-role-section is-text">
      {textColors.map(({ label, chips }) => (
        <div class="doc-color-role-group" role="group" aria-label={label}>
          
          <div class="doc-color-role-chips">
            {chips.map(({ cls, bg, full, mark }) => (
              <div class:list={["doc-color-role-chip", bg, cls, full && "full"]}>
                {mark
                  ? <span class="doc-chip-mark">{cls.replace('dg-text-', '')}</span>
                  : cls.replace('dg-text-', '')}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="doc-code" data-code-source="manual">
    <button class="cp">Copiar</button>
    <pre>{`<!-- Valores del tema claro; en oscuro cambian solos. -->

<!-- Neutros -->
<span class="dg-text-primary">...</span>      <!-- #0b0b0c -->
<span class="dg-text-secondary">...</span>    <!-- #6f6f78 -->

<!-- Marca -->
<span class="dg-text-primary-subtle">...</span><!-- #ececee -->
<span class="dg-text-primary-light">...</span><!-- #bcbcc3 -->
<span class="dg-text-primary">...</span>      <!-- #0b0b0c -->
<span class="dg-text-primary-dark">...</span> <!-- #242428 -->
<span class="dg-text-secondary-subtle">...</span><!-- #f6f6f7 -->
<span class="dg-text-secondary-light">...</span><!-- #93939c -->
<span class="dg-text-secondary">...</span>    <!-- #6f6f78 -->
<span class="dg-text-secondary-dark">...</span><!-- #3b3b41 -->

<!-- Semánticos -->
<span class="dg-text-success-subtle">...</span><!-- #e7f8ee -->
<span class="dg-text-success-light">...</span><!-- #4ade80 -->
<span class="dg-text-success">...</span>      <!-- #15803d -->
<span class="dg-text-success-dark">...</span> <!-- #166534 -->
<span class="dg-text-warning-subtle">...</span><!-- #fffbeb -->
<span class="dg-text-warning-light">...</span><!-- #fde047 -->
<span class="dg-text-warning">...</span>      <!-- #eab308 -->
<span class="dg-text-warning-dark">...</span> <!-- #ca8a04 -->
<span class="dg-text-danger-subtle">...</span><!-- #fef1f1 -->
<span class="dg-text-danger-light">...</span> <!-- #f87171 -->
<span class="dg-text-danger">...</span>       <!-- #dc2626 -->
<span class="dg-text-danger-dark">...</span>  <!-- #b91c1c -->
<span class="dg-text-info-subtle">...</span>  <!-- #eef5ff -->
<span class="dg-text-info-light">...</span>   <!-- #60a5fa -->
<span class="dg-text-info">...</span>         <!-- #2563eb -->
<span class="dg-text-info-dark">...</span>    <!-- #1d4ed8 -->`}</pre>
  </div>
</div>

  <!-- ── Gradientes ───────────────────────────────────────────── -->
  <div class="doc-sub">Gradientes</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Clases <code class="dg-code">dg-gradient-*</code>: una diagonal limpia del tono <code class="dg-code">light</code>
    al <code class="dg-code">subtle</code> de cada color, sin manchas oscuras. <code class="dg-code">primary</code> es la excepción: va
    del tono base al <code class="dg-code">dark</code>, oscuro como el color de marca (en tema oscuro se invierte, igual que el primary). El texto encima mantiene su contraste en claro y oscuro.
  </p>

  <div class="doc-example">
<div class="doc-demo is-plain">
    <div class="doc-color-role-section is-grad">
      {gradientScale.map(({ label, chips }) => (
        <div class="doc-color-role-group" role="group" aria-label={label}>
          <div class="doc-color-role-chips">
            {chips.map(({ cls, full }) => (
              <div class:list={["doc-color-role-chip", cls, full && "full"]}><span class="doc-chip-name">{cls.replace('dg-gradient-', '')}</span><code class="doc-chip-hex" data-chip-grad></code></div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="doc-code" data-code-source="manual">
    <button class="cp">Copiar</button>
    <pre>{`<!-- Diagonal (135°) del tono light al subtle; primary: del base al dark -->
<div class="dg-gradient-primary">...</div>
<div class="dg-gradient-secondary">...</div>
<div class="dg-gradient-success">...</div>
<div class="dg-gradient-warning">...</div>
<div class="dg-gradient-danger">...</div>
<div class="dg-gradient-info">...</div>`}</pre>
  </div>
</div>

  <!-- ── Tokens semánticos ──────────────────────────────────── -->
  <div class="doc-sub">Tokens semánticos</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Usa siempre estos tokens en tus componentes, no valores fijos.
    Se invierten automáticamente en dark mode — si usas <code class="dg-code">var(--dg-border)</code>
    en vez de <code class="dg-code">#dcdce0</code>, el componente funciona en ambos temas sin cambios.
  </p>
  <div class="dg-table-card dg-mb-4">
    <table class="dg-table dg-table-sm">
      <thead><tr><th>Token</th><th>Light</th><th>Dark</th><th>Uso</th></tr></thead>
      <tbody>
        <tr><td><code class="dg-code">--dg-paper</code></td><td>#ffffff</td><td>#0b0b0c</td><td>Fondo de página (body)</td></tr>
        <tr><td><code class="dg-code">--dg-surface</code></td><td>#ffffff</td><td>#0f0f11</td><td>Fondo de cards y paneles</td></tr>
        <tr><td><code class="dg-code">--dg-surface-2</code></td><td>#f6f6f7</td><td>#161618</td><td>Filas alternadas, footers de card</td></tr>
        <tr><td><code class="dg-code">--dg-surface-3</code></td><td>#ececee</td><td>#1e1e21</td><td>Inputs, badges, code</td></tr>
        <tr><td><code class="dg-code">--dg-border</code></td><td>#dcdce0</td><td>#2a2a2e</td><td>Bordes estándar</td></tr>
        <tr><td><code class="dg-code">--dg-border-strong</code></td><td>#bcbcc3</td><td>#3a3a40</td><td>Bordes enfatizados, inputs</td></tr>
        <tr><td><code class="dg-code">--dg-text</code></td><td>#0b0b0c</td><td>#f4f4f5</td><td>Texto principal</td></tr>
        <tr><td><code class="dg-code">--dg-solid</code></td><td>#0b0b0c</td><td>#ffffff</td><td>Color primario de controles</td></tr>
        <tr><td><code class="dg-code">--dg-on-solid</code></td><td>#ffffff</td><td>#0b0b0c</td><td>Texto sobre --dg-solid</td></tr>
      </tbody>
    </table>
  </div>
  <div class="doc-code">
    <button class="cp">Copiar</button>
    <pre>{`/* ✓ Usa tokens — funciona en light y dark sin cambios */
.mi-card {
  background: var(--dg-surface);          /* #ffffff / #0f0f11 */
  border:     1px solid var(--dg-border); /* #dcdce0 / #2a2a2e */
  color:      var(--dg-text);             /* #0b0b0c / #f4f4f5 */
}

/* ✗ Nunca valores hardcoded */
.mi-card {
  background: #ffffff;       /* invisible en dark mode */
  border: 1px solid #dcdce0;
  color: #0b0b0c;
}`}</pre>
  </div>

  <!-- ── Personalizar ──────────────────────────────────────── -->
  <div class="doc-sub">Personalizar la paleta</div>
  <p class="dg-muted dg-text-sm dg-mb-4">
    Sobrescribe cualquier token en tu propio archivo CSS <em>después</em> de cargar el framework.
    Todos los componentes y utilidades los recogen automáticamente.
  </p>
  <div class="doc-code">
    <button class="cp">Copiar</button>
    <pre>{`/* mi-tema.css — cargado después de dgarz.css */
:root {
  --dg-solid:    #4f46e5;  /* primary de negro a índigo */
  --dg-on-solid: #ffffff;

  --dg-success:        #16a34a;  /* verde más vivo */
  --dg-success-subtle: #f0fdf4;
  --dg-on-success:     #ffffff;

  --dg-danger:        #dc2626;   /* rojo más vivo */
  --dg-danger-subtle: #fef2f2;
  --dg-on-danger:     #ffffff;
}

[data-theme="dark"] {
  --dg-solid:   #818cf8;   /* índigo claro para dark */
  --dg-success: #4ade80;
  --dg-danger:  #f87171;
}`}</pre>
  </div>

</Layout>

<script>
  // Background swatches: show the real hex of each block (read from the
  // rendered color, so it always matches the framework and the theme).
  // Any CSS color (rgb, oklab, color-mix…) to #rrggbb: paint one pixel and read it.
  const pixel = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
  function toHex(color: string): string {
    if (!pixel || !color) return '';
    pixel.clearRect(0, 0, 1, 1);
    pixel.fillStyle = '#000';
    pixel.fillStyle = color;
    pixel.fillRect(0, 0, 1, 1);
    const [r, g, b] = pixel.getImageData(0, 0, 1, 1).data;
    return '#' + [r, g, b].map((v) => v.toString(16).padStart(2, '0')).join('');
  }
  function paintHex() {
    document.querySelectorAll<HTMLElement>('[data-chip-hex]').forEach((el) => {
      const chip = el.parentElement;
      if (chip) el.textContent = toHex(getComputedStyle(chip).backgroundColor);
    });
    // Gradients: the two ends of the diagonal, read from the painted image.
    document.querySelectorAll<HTMLElement>('[data-chip-grad]').forEach((el) => {
      const chip = el.parentElement;
      if (!chip) return;
      const stops = getComputedStyle(chip).backgroundImage.match(/(?:rgba?|oklab|oklch|color)\([^()]*(?:\([^()]*\)[^()]*)*\)/g) ?? [];
      el.textContent = stops.length >= 2 ? `${toHex(stops[0])} → ${toHex(stops[stops.length - 1])}` : '';
    });
  }
  paintHex();
  // The theme changes the tokens: repaint once the colors have settled.
  new MutationObserver(() => requestAnimationFrame(paintHex))
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
