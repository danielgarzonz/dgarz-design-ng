        <div class="dg-segmented doc-modal-size-tabs" role="tablist" aria-labelledby="modal-pos-label">
          <button type="button" class="is-active" role="tab" id="modal-pos-tab-0" aria-controls="modal-pos-panel-0" aria-selected="true" tabindex="0">Círculo</button>
