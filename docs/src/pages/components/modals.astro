<div class="dg-modal-backdrop" id="mdOnboard" data-dg-backdrop="" hidden>
  <div class="dg-modal dg-modal-onboard" role="dialog" aria-modal="true">
    <button class="dg-modal-close" data-dg-close aria-label="Cerrar"><svg class="dg-icon dg-icon-sm"><use href="#dg-x"/></svg></button>
    <div class="dg-onboard-media"><svg class="dg-icon dg-size-48" id="onboardIcon"><use href="#dg-star"/></svg></div>
    <div class="dg-modal-body">
      <span class="dg-onboard-step" id="onboardStep">Paso 1 de 3</span>
      <h3 class="dg-modal-title dg-fs-2xl" id="onboardTitle">Te damos la bienvenida</h3>
      <p class="dg-mt-2" id="onboardText">dgarz design te ayuda a construir interfaces sobrias y consistentes en minutos.</p>
    </div>
    <div class="dg-modal-footer">
      <button type="button" class="dg-btn dg-btn-ghost" id="onboardPrev" disabled>Anterior</button>
      <div class="dg-onboard-dots" id="onboardDots"><i class="is-active"></i><i></i><i></i></div>
      <button class="dg-btn" id="onboardNext">Siguiente</button>
    </div>
  </div>
</div>

<script>

  document.querySelectorAll<HTMLElement>('[data-modal-basic-tabs], [data-modal-size-tabs], [data-modal-footer-tabs], [data-modal-pos-tabs], [data-modal-status-tabs]').forEach((group) => {
    const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(group.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (index: number) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.classList.toggle('is-active', i === index);
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next);
        tabs[next].focus();
      });
    });
  });


  // Surface switcher
  const switcher = document.getElementById('surfaceSwitcher');
  if (switcher) {
    switcher.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-surface]');
      if (!btn) return;
      const surface = btn.dataset.surface;
      document.querySelectorAll('.dg-modal').forEach(modal => {
        modal.classList.toggle('is-glass', surface === 'glass');
      });
    });
  }

  // Entrance effects
  const mdPos = document.getElementById('mdPos');
  if (mdPos && window.dgarz) {
    document.querySelectorAll<HTMLElement>('[data-effect-demo]').forEach(btn => {
      btn.addEventListener('click', () => {
        const effect = btn.dataset.effectDemo || '';
        const card = document.getElementById('mdPosCard');
        if (card) card.className = 'dg-modal dg-modal-sm' + (effect ? ' ' + effect : '');
        const title = document.getElementById('mdPosTitle');
        if (title) title.textContent = btn.dataset.effectLabel || 'Efecto de entrada';
        window.dgarz.openOverlay(mdPos);
      });
    });
  }

  // Status modal
  const statusMap = {
    success: { title: 'Operación exitosa', body: 'Todo salió bien. Puedes continuar.',          use: '#dg-check' },
    warning: { title: 'Revisa esto',       body: 'Hay algo que requiere tu atención.',           use: '#dg-alert-tri' },
    danger:  { title: 'Algo falló',        body: 'No pudimos completar la acción.',              use: '#dg-x' },
    info:    { title: 'Buenas noticias',   body: 'Una actualización con mejoras está disponible.',use: '#dg-info' }
  };
  const mdStatus = document.getElementById('mdStatus');
  if (mdStatus && window.dgarz) {
    document.querySelectorAll('[data-status]').forEach(btn => {
      btn.addEventListener('click', () => {
        const s = btn.getAttribute('data-status'), c = statusMap[s];
        const statusCard = document.getElementById('mdStatusCard');
        const glass = statusCard.classList.contains('is-glass');
        statusCard.className = 'dg-modal dg-modal-sm dg-modal-accent is-' + s + (glass ? ' is-glass' : '');
        document.getElementById('mdStatusAccept').className = 'dg-btn dg-btn-primary';
        const ic = document.getElementById('mdStatusIcon');
        ic.className = 'dg-modal-icon is-' + s;
        if (s === 'success') {
          ic.innerHTML = '<svg class="dg-check-animated" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path class="dg-check-path" d="m5 12 4.5 4.5L19 7"/></svg>';
        } else {
          ic.innerHTML = '<svg class="dg-icon dg-icon-sm"><use href="' + c.use + '"/></svg>';
        }
        document.getElementById('mdStatusTitle').textContent = c.title;
        document.getElementById('mdStatusBody').textContent = c.body;
        window.dgarz.openOverlay(mdStatus);
      });
    });
  }

  // Onboarding stepper
  const steps = [
    { icon: '#dg-star',   step: 'Paso 1 de 3', title: 'Te damos la bienvenida',  text: 'dgarz design te ayuda a construir interfaces sobrias y consistentes en minutos.' },
    { icon: '#dg-folder', step: 'Paso 2 de 3', title: 'Organiza tu trabajo',     text: 'Agrupa componentes y reutiliza tus tokens en cualquier proyecto.' },
    { icon: '#dg-check',  step: 'Paso 3 de 3', title: 'Todo listo',              text: 'Ya puedes empezar a crear. Encuentra todo en la documentación.' }
  ];
  let idx = 0;
  const obNext = document.getElementById('onboardNext');
  const obPrev = document.querySelector<HTMLButtonElement>('#onboardPrev');
  let onboardTransition = 0;
  let onboardBusy = false;
  async function renderOnboard(animate = false) {
    const version = ++onboardTransition;
    const elements = ['onboardStep', 'onboardTitle', 'onboardText'].map(id => document.getElementById(id)!);
    elements.forEach(el => el.getAnimations().forEach(animation => animation.cancel()));
    const motion = animate && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && !!elements[0].animate;
    onboardBusy = motion;
    const s = steps[idx];
    const stepIndex = idx;
    const settle = (animations: Animation[]) => Promise.all(animations.map(animation => animation.finished.catch(() => {})));
    if (motion) {
      await settle(elements.map(el => el.animate([
        { opacity: 1, transform: 'translateY(0)' },
        { opacity: 0, transform: 'translateY(-6px)' }
      ], { duration: 120, easing: 'ease-in', fill: 'both' })));
      if (version !== onboardTransition) return;
    }
    document.querySelector('#onboardIcon use').setAttribute('href', s.icon);
    elements[0].textContent = s.step;
    elements[1].textContent = s.title;
    elements[2].textContent = s.text;
    document.querySelectorAll('#onboardDots i').forEach((d, i) => d.classList.toggle('is-active', i === stepIndex));
    obNext.textContent = stepIndex === steps.length - 1 ? 'Finalizar' : 'Siguiente';
    if (obPrev) obPrev.disabled = stepIndex === 0;
    if (motion) {
      elements.forEach(el => el.getAnimations().forEach(animation => animation.cancel()));
      await settle(elements.map((el, i) => el.animate([
        { opacity: 0, transform: 'translateY(10px)' },
        { opacity: 1, transform: 'translateY(0)' }
      ], { duration: 280, delay: i * 35, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'both' })));
      if (version !== onboardTransition) return;
      elements.forEach(el => el.getAnimations().forEach(animation => animation.cancel()));
    }
    onboardBusy = false;
  }
  if (obNext && window.dgarz) {
    document.querySelector('[data-dg-open="#mdOnboard"]')
      ?.addEventListener('click', () => { idx = 0; renderOnboard(); });
    obPrev?.addEventListener('click', () => {
      if (onboardBusy || idx === 0) return;
      idx--;
      renderOnboard(true);
    });
    obNext.addEventListener('click', () => {
      if (onboardBusy) return;
      if (idx < steps.length - 1) { idx++; renderOnboard(true); }
      else window.dgarz.closeOverlay(document.getElementById('mdOnboard'));
    });
  }

</script>


<div class="dg-modal-backdrop" id="mdDefaultFooter" data-dg-backdrop="" hidden>
  <div class="dg-modal" role="dialog" aria-modal="true" aria-labelledby="mdDefaultFooterTitle">
    <button class="dg-modal-close" data-dg-close aria-label="Cerrar"><svg class="dg-icon dg-icon-sm"><use href="#dg-x"/></svg></button>
    <div class="dg-modal-header"><h3 class="dg-modal-title" id="mdDefaultFooterTitle">Footer flotante estándar</h3></div>
    <div class="dg-modal-body">
      <p class="dg-mb-3">El footer flotante es el estilo por defecto en <strong>Dgarz Design</strong>. Se ubica flotando sobre el diálogo con esquinas redondeadas y fondo translúcido con desenfoque suave.</p>
      <p class="dg-mb-3"><strong>Sin contenedor detrás:</strong> el contenido del modal fluye y hace scroll directamente por detrás de los botones, aprovechando todo el alto disponible del modal sin barras ni fondos adicionales.</p>
      <p class="dg-mb-3">Puedes desplazarte libremente por este contenido para comprobar cómo el texto pasa fluidamente por debajo de los botones de acción con el efecto de cristal esmerilado.</p>
      <div class="dg-card dg-mb-3">
        <div class="dg-card-body">
          <h4 class="dg-text-sm dg-fw-bold dg-mb-1">Espaciado inteligente</h4>
          <p class="dg-text-xs dg-muted">El cuerpo del modal incluye una compensación inferior (<code>padding-bottom</code>) para asegurar que el último elemento sea 100% visible y accionable al llegar al final del scroll.</p>
        </div>
      </div>
      <div class="dg-card dg-mb-3">
        <div class="dg-card-body">
          <h4 class="dg-text-sm dg-fw-bold dg-mb-1">Efecto glass y elevación</h4>
          <p class="dg-text-xs dg-muted">La cápsula flotante cuenta con sombra suave y borde sutil, integrándose perfectamente sobre cualquier tipo de contenido.</p>
        </div>
      </div>
      <p class="dg-text-sm dg-muted">Fin del contenido demostrativo. Observa cómo este texto queda totalmente legible sobre el fondo del diálogo.</p>
    </div>
    <div class="dg-modal-footer">
      <button class="dg-btn dg-btn-cancel" data-dg-close>Cancelar</button>
      <button class="dg-btn" data-dg-close>Aceptar</button>
    </div>
  </div>
</div>

<div class="dg-modal-backdrop" id="mdWideFooter" data-dg-backdrop="" hidden>
  <div class="dg-modal" role="dialog" aria-modal="true" aria-labelledby="mdWideFooterTitle">
    <button class="dg-modal-close" data-dg-close aria-label="Cerrar"><svg class="dg-icon dg-icon-sm"><use href="#dg-x"/></svg></button>
    <div class="dg-modal-header"><h3 class="dg-modal-title" id="mdWideFooterTitle">Footer flotante ampliado</h3></div>
    <div class="dg-modal-body">
      <p class="dg-mb-3">Con <code>.dg-modal-footer-wide</code> el footer flotante abarca todo el ancho del diálogo, manteniendo una separación uniforme a los lados y esquinas redondeadas.</p>
      <p class="dg-mb-3">Al igual que el footer estándar, flota libremente por encima del contenido sin ningún contenedor o bloque detrás. El contenido pasa directamente por debajo al hacer scroll.</p>
      <div class="dg-card dg-mb-3">
        <div class="dg-card-body">
          <h4 class="dg-text-sm dg-fw-bold dg-mb-1">Distribución flexible</h4>
          <p class="dg-text-xs dg-muted">Puedes combinarlo con <code>is-between</code> para separar los botones de acción a los extremos izquierdo y derecho.</p>
        </div>
      </div>
      <p class="dg-text-sm dg-muted">Prueba desplazando el contenido para observar el desenfoque en toda la franja flotante.</p>
    </div>
    <div class="dg-modal-footer dg-modal-footer-wide is-between">
      <button class="dg-btn dg-btn-cancel" data-dg-close>Cancelar</button>
      <button class="dg-btn" data-dg-close>Guardar cambios</button>
    </div>
  </div>
</div>

<div class="dg-modal-backdrop" id="mdFlushFooter" data-dg-backdrop="" hidden>
