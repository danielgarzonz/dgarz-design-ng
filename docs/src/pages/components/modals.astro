        <div role="tabpanel" id="modal-footer-panel-3" aria-labelledby="modal-footer-tab-3" tabindex="0" hidden>
          <p class="dg-muted dg-text-sm dg-mt-3">Solo iconos · <code>.dg-btn-icon</code> botones circulares de 42px para acciones rápidas</p>
