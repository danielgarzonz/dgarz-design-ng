---
import Layout from "../../layouts/DocsLayout.astro";
import Code from "../../components/Code.astro";

const rightExample = "<button class=\"dg-btn\" data-dg-open=\"#demoDrawerRight\">Drawer derecha</button>\n\n<div class=\"dg-drawer-backdrop\" id=\"demoDrawerRightBd\" data-dg-backdrop=\"\" hidden></div>\n<div class=\"dg-drawer\" id=\"demoDrawerRight\" hidden data-dg-backdrop=\"#demoDrawerRightBd\"\n     role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"drawerRightTitle\">\n  <button type=\"button\" class=\"dg-modal-close dg-drawer-close\" data-dg-close aria-label=\"Cerrar\">\n    <svg class=\"dg-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6 6 18\"/></svg>\n  </button>\n  <div class=\"dg-drawer-header\">\n    <h4 id=\"drawerRightTitle\">Panel de filtros</h4>\n  </div>\n  <div class=\"dg-drawer-body dg-stack\">\n    <div class=\"dg-field\">\n      <label class=\"dg-label\" for=\"drawerState\">Estado</label>\n      <select class=\"dg-select\" id=\"drawerState\"><option>Todos</option><option>Activo</option><option>Pendiente</option></select>\n    </div>\n    <div class=\"dg-field\">\n      <label class=\"dg-label\" for=\"drawerPrice\">Precio máximo</label>\n      <input class=\"dg-input\" id=\"drawerPrice\" type=\"number\" placeholder=\"500\" />\n    </div>\n  </div>\n  <div class=\"dg-drawer-footer\">\n    <button class=\"dg-btn dg-btn-cancel\" data-dg-close>Cancelar</button>\n    <button class=\"dg-btn\" data-dg-close>Aplicar filtros</button>\n  </div>\n</div>";
const leftExample = "<button class=\"dg-btn dg-btn-ghost\" data-dg-open=\"#demoDrawerLeft\">Drawer izquierda</button>\n\n<div class=\"dg-drawer-backdrop\" id=\"demoDrawerLeftBd\" data-dg-backdrop=\"\" hidden></div>\n<div class=\"dg-drawer dg-drawer-left\" id=\"demoDrawerLeft\" hidden data-dg-backdrop=\"#demoDrawerLeftBd\"\n     role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"drawerLeftTitle\">\n  <button type=\"button\" class=\"dg-modal-close dg-drawer-close\" data-dg-close aria-label=\"Cerrar\">\n    <svg class=\"dg-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6 6 18\"/></svg>\n  </button>\n  <div class=\"dg-drawer-header\">\n    <h4 id=\"drawerLeftTitle\">Menú lateral</h4>\n  </div>\n  <div class=\"dg-drawer-body\">\n    <nav class=\"dg-nav-vertical\">\n      <a class=\"dg-nav-item is-active\" href=\"/\"><svg class=\"dg-icon\"><use href=\"#dg-menu\"/></svg><span>Inicio</span></a>\n      <a class=\"dg-nav-item\" href=\"/components/tables\"><svg class=\"dg-icon\"><use href=\"#dg-search\"/></svg><span>Buscar</span></a>\n      <a class=\"dg-nav-item\" href=\"/components/alerts\"><svg class=\"dg-icon\"><use href=\"#dg-bell\"/></svg><span>Notificaciones</span></a>\n    </nav>\n  </div>\n  <div class=\"dg-drawer-footer\">\n    <button class=\"dg-btn dg-btn-primary\" data-dg-close>Cerrar menú</button>\n  </div>\n</div>";
const bottomExample = "<button class=\"dg-btn\" data-dg-open=\"#demoDrawerBottom\">Drawer inferior</button>\n\n<div class=\"dg-drawer-backdrop\" id=\"demoDrawerBottomBd\" data-dg-backdrop=\"\" hidden></div>\n<div class=\"dg-drawer dg-drawer-bottom\" id=\"demoDrawerBottom\" hidden data-dg-backdrop=\"#demoDrawerBottomBd\"\n     role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"drawerBottomTitle\">\n  <button type=\"button\" class=\"dg-modal-close dg-drawer-close\" data-dg-close aria-label=\"Cerrar\">\n    <svg class=\"dg-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6 6 18\"/></svg>\n  </button>\n  <div class=\"dg-drawer-header\">\n    <h4 id=\"drawerBottomTitle\">Compartir proyecto</h4>\n  </div>\n  <div class=\"dg-drawer-body dg-stack\">\n    <div class=\"dg-field\">\n      <label class=\"dg-label\" for=\"drawerShareEmail\">Invitar por correo</label>\n      <input class=\"dg-input\" id=\"drawerShareEmail\" type=\"email\" placeholder=\"nombre@ejemplo.com\" />\n    </div>\n    <div class=\"dg-field\">\n      <label class=\"dg-label\" for=\"drawerShareRole\">Permiso</label>\n      <select class=\"dg-select\" id=\"drawerShareRole\"><option>Puede ver</option><option>Puede editar</option></select>\n    </div>\n  </div>\n  <div class=\"dg-drawer-footer\">\n    <button class=\"dg-btn dg-btn-cancel\" data-dg-close>Cancelar</button>\n    <button class=\"dg-btn\" data-dg-close>Enviar invitación</button>\n  </div>\n</div>";
const topExample = "<button class=\"dg-btn\" data-dg-open=\"#demoDrawerTop\">Drawer superior</button>\n\n<div class=\"dg-drawer-backdrop\" id=\"demoDrawerTopBd\" data-dg-backdrop=\"\" hidden></div>\n<div class=\"dg-drawer dg-drawer-top\" id=\"demoDrawerTop\" hidden data-dg-backdrop=\"#demoDrawerTopBd\"\n     role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"drawerTopTitle\">\n  <button type=\"button\" class=\"dg-modal-close dg-drawer-close\" data-dg-close aria-label=\"Cerrar\">\n    <svg class=\"dg-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6 6 18\"/></svg>\n  </button>\n  <div class=\"dg-drawer-header\">\n    <h4 id=\"drawerTopTitle\">Buscar</h4>\n  </div>\n  <div class=\"dg-drawer-body dg-stack\">\n    <div class=\"dg-field\">\n      <label class=\"dg-label\" for=\"drawerSearch\">Buscar en la documentación</label>\n      <input class=\"dg-input\" id=\"drawerSearch\" type=\"search\" placeholder=\"Botones, modales, tokens…\" />\n    </div>\n    <p class=\"dg-text-sm\">Búsquedas recientes: Drawer · Tabs · Glass</p>\n  </div>\n  <div class=\"dg-drawer-footer\">\n    <button class=\"dg-btn dg-btn-cancel\" data-dg-close>Cancelar</button>\n    <button class=\"dg-btn\" data-dg-close>Buscar</button>\n  </div>\n</div>";
---

<Layout
  title="Drawer"
  lead="Panel lateral con el acabado de los modales: sólido por defecto o glass opcional, con cabecera y footer flotante con el mismo contraste que el modal. Conserva su altura completa y apertura desde el borde."
  currentHref="/components/drawer"
>
  <div class="dg-segmented dg-mb-5" id="drawerSurface" role="group" aria-label="Superficie del drawer">
    <button type="button" class="is-active" data-drawer-surface="solid" aria-pressed="true">Sólido</button>
    <button type="button" data-drawer-surface="glass" aria-pressed="false">Glass</button>
  </div>
  <p class="dg-muted dg-mb-4">Glass usa transparencia y <code>saturate(1.8) blur(20px)</code>. Sólido usa fondo blanco opaco. El título se alinea a la izquierda y las esquinas interiores distinguen el panel lateral del modal centrado.</p>
  <h2 class="doc-sub">Drawer desde la derecha</h2>
  <p class="dg-muted dg-text-sm dg-mb-4">Es la posición por defecto: el panel entra desde el borde derecho. Ábrelo con <code class="dg-code">data-dg-open</code> apuntando al id del drawer.</p>
  <div class="doc-example">
<div class="doc-demo is-plain">
    <button class="dg-btn" data-dg-open="#demoDrawerRight">Drawer derecha</button>
  </div>
  <Code>{rightExample}</Code>
</div>

  <h2 class="doc-sub">Drawer desde la izquierda</h2>
  <p class="dg-muted dg-text-sm dg-mb-4">Añade <code class="dg-code">.dg-drawer-left</code> para que el panel entre desde el borde izquierdo.</p>
  <div class="doc-example">
<div class="doc-demo is-plain">
    <button class="dg-btn dg-btn-ghost" data-dg-open="#demoDrawerLeft">Drawer izquierda</button>
  </div>
  <Code>{leftExample}</Code>
</div>

  <h2 class="doc-sub">Drawer desde abajo</h2>
  <p class="dg-muted dg-text-sm dg-mb-4">Añade <code class="dg-code">.dg-drawer-bottom</code> para que el panel suba desde el borde inferior, a todo el ancho. Su altura se ajusta al contenido hasta el 85% de la pantalla; si hay más contenido, el cuerpo hace scroll. Las esquinas superiores van redondeadas (<code class="dg-code">--dg-drawer-bottom-radius</code>, por defecto <code class="dg-code">--dg-radius-xl</code>).</p>
  <div class="doc-example">
<div class="doc-demo is-plain">
    <button class="dg-btn" data-dg-open="#demoDrawerBottom">Drawer inferior</button>
  </div>
  <Code>{bottomExample}</Code>
</div>

  <h2 class="doc-sub">Drawer desde arriba</h2>
  <p class="dg-muted dg-text-sm dg-mb-4">Con <code class="dg-code">.dg-drawer-top</code> el panel baja desde el borde superior, a todo el ancho, con la misma altura automática y las esquinas inferiores redondeadas con el mismo radio del menú superior (<code class="dg-code">--dg-bar-radius</code>: 55px en móvil, 32px en pantallas de 380px o menos y recto desde 861px, igual que el menú; personalizable con <code class="dg-code">--dg-drawer-top-radius</code>). Útil para búsquedas o avisos rápidos.</p>
  <div class="doc-example">
<div class="doc-demo is-plain">
    <button class="dg-btn" data-dg-open="#demoDrawerTop">Drawer superior</button>
  </div>
  <Code>{topExample}</Code>
</div>
  <p class="dg-muted dg-text-sm">El drawer es sólido por defecto. Para la variante glass, agrega <code>is-glass</code> al contenedor <code>dg-drawer</code> de cualquiera de los ejemplos, o <code>data-surface="glass"</code> a <code>&lt;html&gt;</code> para todos los flotantes. Con <em>reducir transparencia</em> activado vuelve a sólido.</p>
</Layout>

<!-- Drawer backdrops -->
<div class="dg-drawer-backdrop" id="demoDrawerRightBd" data-dg-backdrop="" hidden></div>
<div class="dg-drawer" id="demoDrawerRight" hidden data-dg-backdrop="#demoDrawerRightBd"
     role="dialog" aria-modal="true" aria-labelledby="drawerRightTitle">
  <button type="button" class="dg-modal-close dg-drawer-close" data-dg-close aria-label="Cerrar">
    <svg class="dg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <div class="dg-drawer-header">
    <h4 id="drawerRightTitle">Panel de filtros</h4>
  </div>
  <div class="dg-drawer-body dg-stack">
    <div class="dg-field">
      <label class="dg-label" for="drawerState">Estado</label>
      <select class="dg-select" id="drawerState"><option>Todos</option><option>Activo</option><option>Pendiente</option></select>
    </div>
    <div class="dg-field">
      <label class="dg-label" for="drawerPrice">Precio máximo</label>
      <input class="dg-input" id="drawerPrice" type="number" placeholder="500" />
    </div>
  </div>
  <div class="dg-drawer-footer">
    <button class="dg-btn dg-btn-cancel" data-dg-close>Cancelar</button>
    <button class="dg-btn" data-dg-close>Aplicar filtros</button>
  </div>
</div>

<div class="dg-drawer-backdrop" id="demoDrawerLeftBd" data-dg-backdrop="" hidden></div>
<div class="dg-drawer dg-drawer-left" id="demoDrawerLeft" hidden data-dg-backdrop="#demoDrawerLeftBd"
     role="dialog" aria-modal="true" aria-labelledby="drawerLeftTitle">
  <button type="button" class="dg-modal-close dg-drawer-close" data-dg-close aria-label="Cerrar">
    <svg class="dg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <div class="dg-drawer-header">
    <h4 id="drawerLeftTitle">Menú lateral</h4>
  </div>
  <div class="dg-drawer-body">
    <nav class="dg-nav-vertical">
      <a class="dg-nav-item is-active" href="/"><svg class="dg-icon"><use href="#dg-menu"/></svg><span>Inicio</span></a>
      <a class="dg-nav-item" href="/components/tables"><svg class="dg-icon"><use href="#dg-search"/></svg><span>Buscar</span></a>
      <a class="dg-nav-item" href="/components/alerts"><svg class="dg-icon"><use href="#dg-bell"/></svg><span>Notificaciones</span></a>
    </nav>
  </div>
  <div class="dg-drawer-footer">
    <button class="dg-btn dg-btn-primary" data-dg-close>Cerrar menú</button>
  </div>
</div>

<div class="dg-drawer-backdrop" id="demoDrawerBottomBd" data-dg-backdrop="" hidden></div>
<div class="dg-drawer dg-drawer-bottom" id="demoDrawerBottom" hidden data-dg-backdrop="#demoDrawerBottomBd"
     role="dialog" aria-modal="true" aria-labelledby="drawerBottomTitle">
  <button type="button" class="dg-modal-close dg-drawer-close" data-dg-close aria-label="Cerrar">
    <svg class="dg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <div class="dg-drawer-header">
    <h4 id="drawerBottomTitle">Compartir proyecto</h4>
  </div>
  <div class="dg-drawer-body dg-stack">
    <div class="dg-field">
      <label class="dg-label" for="drawerShareEmail">Invitar por correo</label>
      <input class="dg-input" id="drawerShareEmail" type="email" placeholder="nombre@ejemplo.com" />
    </div>
    <div class="dg-field">
      <label class="dg-label" for="drawerShareRole">Permiso</label>
      <select class="dg-select" id="drawerShareRole"><option>Puede ver</option><option>Puede editar</option></select>
    </div>
  </div>
  <div class="dg-drawer-footer">
    <button class="dg-btn dg-btn-cancel" data-dg-close>Cancelar</button>
    <button class="dg-btn" data-dg-close>Enviar invitación</button>
  </div>
</div>

<div class="dg-drawer-backdrop" id="demoDrawerTopBd" data-dg-backdrop="" hidden></div>
<div class="dg-drawer dg-drawer-top" id="demoDrawerTop" hidden data-dg-backdrop="#demoDrawerTopBd"
     role="dialog" aria-modal="true" aria-labelledby="drawerTopTitle">
  <button type="button" class="dg-modal-close dg-drawer-close" data-dg-close aria-label="Cerrar">
    <svg class="dg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <div class="dg-drawer-header">
    <h4 id="drawerTopTitle">Buscar</h4>
  </div>
  <div class="dg-drawer-body dg-stack">
    <div class="dg-field">
      <label class="dg-label" for="drawerSearch">Buscar en la documentación</label>
      <input class="dg-input" id="drawerSearch" type="search" placeholder="Botones, modales, tokens…" />
    </div>
    <p class="dg-text-sm">Búsquedas recientes: Drawer · Tabs · Glass</p>
  </div>
  <div class="dg-drawer-footer">
    <button class="dg-btn dg-btn-cancel" data-dg-close>Cancelar</button>
    <button class="dg-btn" data-dg-close>Buscar</button>
  </div>
</div>

<script>
  const surfaces = document.getElementById('drawerSurface');
  surfaces?.querySelectorAll<HTMLButtonElement>('[data-drawer-surface]').forEach(button => {
    button.addEventListener('click', () => {
      const glass = button.dataset.drawerSurface === 'glass';
      document.querySelectorAll('.dg-drawer').forEach(drawer => drawer.classList.toggle('is-glass', glass));
      surfaces.querySelectorAll('button').forEach(option => {
        option.classList.toggle('is-active', option === button);
        option.setAttribute('aria-pressed', String(option === button));
      });
    });
  });
</script>
