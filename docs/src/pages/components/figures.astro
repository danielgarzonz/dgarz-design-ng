---
import Layout from "../../layouts/DocsLayout.astro";
const pageContent = `<div class="doc-sub">Figura con caption</div>
      <p class="dg-muted dg-text-sm dg-mb-4"><code class="dg-code">.dg-figure</code> agrupa una imagen <code class="dg-code">.dg-figure-img</code> con su texto en <code class="dg-code">.dg-figure-caption</code>.</p>
      <div class="doc-example">
<div class="doc-demo is-plain">
        <div class="dg-grid dg-grid-2 dg-max-w-2xl">
          <figure class="dg-figure">
            <div class="dg-figure-img dg-aspect-4-3 dg-rounded dg-gradient-secondary"></div>
            <figcaption class="dg-figure-caption">Figura 1 — Ejemplo de imagen con caption centrado.</figcaption>
          </figure>
          <figure class="dg-figure">
            <div class="dg-figure-img dg-aspect-4-3 dg-rounded dg-gradient-primary"></div>
            <figcaption class="dg-figure-caption">Figura 2 — El caption usa color muted y tamaño xs.</figcaption>
          </figure>
        </div>
      </div>
      <div class="doc-code"><button class="cp">Copiar</button><pre></pre></div>
</div>`;
---

<Layout title="Figures" lead="Imágenes con caption y variantes de aspecto." currentHref="/components/figures">
  <Fragment set:html={pageContent} />
</Layout>
