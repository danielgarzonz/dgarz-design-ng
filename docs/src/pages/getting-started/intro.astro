---
import Layout from "../../layouts/DocsLayout.astro";

// Swiss: no cards, no tinted icons — numbered blocks, a spec table and an index.
const features = [
  { title: "Monocromo por diseño", text: "Una escala de grises de 12 pasos. Sin paletas complejas: todo el color deriva de ella y funciona en claro y oscuro." },
  { title: "Cero dependencias", text: "Un archivo CSS y un JS opcional. Sin jQuery, sin PostCSS, sin Sass requerido. Cópialo y listo." },
  { title: "Modo oscuro nativo", text: "Cambia de tema con un solo atributo, <code class=\"dg-code\">data-theme=\"dark\"</code>, y todo el sistema se adapta." },
  { title: "Tokens sobreescribibles", text: "Todos los valores son variables CSS <code class=\"dg-code\">--dg-*</code>: adapta el framework completo a tu marca con unas pocas líneas." },
];

const files = [
  { group: "CSS", rows: [
    { names: ["dgarz.css", "dgarz.min.css"], text: "Core y componentes: tokens, reset, tipografía, retícula de 12 columnas, utilidades y más de 20 componentes (botones, formularios, cards, badges, alerts, modal, navegación…).", path: "dgarz-design/css" },
    { names: ["dgarz-app.css", "dgarz-app.min.css"], text: "App pack: app shell, sidebar, drawer, accordion, steps, skeleton y stat cards. Se carga después de dgarz.css.", path: "dgarz-design/app" },
    { names: ["dgarz.full.css", "dgarz.full.min.css"], text: "Todo en uno: core, componentes y app pack en un solo archivo.", path: "dgarz-design/full" },
    { names: ["tokens.css"], text: "Solo los tokens públicos (--dgarz-*) para dar identidad a los web components.", path: "dgarz-design/tokens" },
  ]},
  { group: "JavaScript", rows: [
    { names: ["dgarz.js", "dgarz.min.js"], text: "Capa de comportamiento por atributos (data-dg-*): modales, drawers, tabs, carrusel, dropdowns y más. Global dgarz, sin dependencias y opcional. Es también la raíz del paquete.", path: "dgarz-design/js" },
    { names: ["dgarz.esm.js"], text: "La misma capa como módulo ES, para bundlers.", path: "dgarz-design/esm" },
  ]},
  { group: "Web components", rows: [
    { names: ["index.mjs"], text: "Registra los web components (<dgarz-button>, <dgarz-input>) e incluye sus tipos de TypeScript.", path: "dgarz-design/core" },
    { names: ["components/"], text: "Cada web component por separado, para importar solo los que uses, con sus .d.ts.", path: "dgarz-design/components/*" },
    { names: ["hydrate/"], text: "Render en servidor (SSR) con Declarative Shadow DOM.", path: "dgarz-design/hydrate" },
    { names: ["component-docs.json"], text: "Metadatos de los componentes (props, eventos y slots) para herramientas y documentación.", path: "dgarz-design/component-docs.json" },
  ]},
  { group: "Recursos", rows: [
    { names: ["dgarz-icons.svg"], text: "Sprite con 38 íconos SVG para usar con <use href=\"#dg-…\">.", path: "dgarz-design/icons" },
  ]},
];

const explore = [
  { group: "Comenzar", title: "Instalación", text: "CDN, npm y bundlers", href: "/getting-started/install" },
  { group: "Fundamentos", title: "Color y tokens", text: "El sistema de diseño monocromo", href: "/foundations/color" },
  { group: "Formularios", title: "Campos", text: "Inputs, selects, máscaras y validación", href: "/forms/fields" },
  { group: "Componentes", title: "Botones", text: "Variantes, estados y grupos", href: "/components/buttons" },
  { group: "App Pack", title: "App Shell", text: "Sidebar, drawer y layout completo", href: "/app-pack/shell" },
  { group: "Studio", title: "Galería", text: "Ejemplos y plantillas completas", href: "/examples" },
];
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>';
const quickStart = `      <div class="doc-sub">Inicio rápido</div>
      <p class="dg-muted dg-text-sm dg-mb-4">Copia esta plantilla para tener una página funcionando con el CSS y el JS del framework.</p>
      <div class="doc-code" data-lang="html"><button class="cp">Copiar</button><pre>&lt;!DOCTYPE html&gt;
&lt;html data-theme="light"&gt;
&lt;head&gt;
  &lt;!-- Fuentes --&gt;
  &lt;link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;family=Geist+Mono&amp;display=swap" rel="stylesheet"&gt;
  &lt;link href="https://api.fontshare.com/v2/css?f[]=gambetta@400,401,500,501&amp;display=swap" rel="stylesheet"&gt;

  &lt;!-- dgarz design --&gt;
  &lt;link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/dgarz-design@1/dist/dgarz.full.min.css"&gt;
&lt;/head&gt;
&lt;body&gt;

  &lt;button class="dg-btn dg-btn-primary"&gt;Hola, dgarz design&lt;/button&gt;

  &lt;script src="https://cdn.jsdelivr.net/npm/dgarz-design@1/dist/dgarz.min.js" defer&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</pre></div>

`;
---

<Layout title="Introducción" lead="Component Design System agnóstico con Core Stencil.js, CSS nativo y tokens de diseño. Migración progresiva desde la versión 1." currentHref="/getting-started/intro">
  <p>El nuevo Core de componentes viene en <code>dgarz-design/core</code> desde la versión <code>1.2.0</code> (la raíz del paquete sigue entregando el JS clásico); sus adaptadores de React, Vue y Angular siguen en desarrollo local, sin publicar. Consulta la <a href="/getting-started/frameworks">guía de frameworks</a> y la demo de <a href="/getting-started/core">Core SSR</a> con Declarative Shadow DOM. El piloto también está verificado en Next.js App Router vía <code>dgarz-design/hydrate</code>.</p>
  <h2>Referencia heredada 1.x</h2>
  <p>Los ejemplos siguientes corresponden al CSS y JavaScript de la versión anterior, que se conservan durante la migración.</p>

  <div class="doc-sub">Características clave</div>
  <div class="in-features">
    {features.map((item, i) => (
      <article class="in-feature">
        <span class="in-num">01.{i + 1}</span>
        <div><h3>{item.title}</h3><p set:html={item.text} /></div>
      </article>
    ))}
  </div>

  <Fragment set:html={quickStart} />

  <div class="doc-sub">¿Qué incluye?</div>
  <p class="dg-muted dg-text-sm dg-mb-4">Todos los archivos que trae el paquete en <code class="dg-code">dist/</code>, con la ruta para importarlos desde npm. Los <code class="dg-code">.min</code> son las versiones minificadas para producción.</p>
  <div class="in-files">
    {files.map((group) => (
      <section class="in-file-group" aria-label={group.group}>
        <h3 class="in-file-label">{group.group}</h3>
        {group.rows.map((row) => (
          <div class="in-file">
            <div class="in-file-names">{row.names.map((n) => <code>{n}</code>)}</div>
            <p class="in-file-text">{row.text}</p>
            <code class="in-file-path">{row.path}</code>
          </div>
        ))}
      </section>
    ))}
  </div>

  <div class="doc-sub">Explorar la documentación</div>
  <ol class="in-index">
    {explore.map((item, i) => (
      <li><a href={item.href}><span class="in-num">04.{i + 1}</span><span class="in-eyebrow">{item.group}</span><strong>{item.title}</strong><em>{item.text}</em><Fragment set:html={arrow} /></a></li>
    ))}
  </ol>
</Layout>

<style is:global>
  /* Key features: numbered blocks on hairline rules, two columns. */
  .in-features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--dg-space-6) var(--doc-gutter); }
  .in-feature { display: grid; grid-template-columns: 3.25rem 1fr; }
  .in-feature h3 { margin: 0 0 var(--dg-space-2); font-size: var(--dg-text-xl); letter-spacing: -0.025em; }
  .in-feature p { margin: 0; color: var(--dg-text-muted); font-size: var(--dg-text-sm); line-height: 1.6; }
  .in-num { font-family: var(--dg-font-mono); font-size: var(--dg-text-xs); color: var(--dg-text-faint); padding-top: 0.3em; }
  @media (max-width: 860px) { .in-features { grid-template-columns: 1fr; } }

  /* What's included: a spec table, grouped, file · description · import path. */
  .in-file-group { margin-bottom: var(--dg-space-7); }
  .in-file-label {
    margin: 0 0 var(--dg-space-2);
    font-family: var(--dg-font-sans); font-size: var(--dg-text-xs); font-weight: var(--dg-weight-semi);
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--dg-text-faint);
  }
  .in-file {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 2fr); column-gap: var(--doc-gutter); align-items: baseline;
    padding: var(--dg-space-3) 0;
    background: linear-gradient(var(--doc-rule), var(--doc-rule)) top / 100% 1px no-repeat;
  }
  .in-file-names { display: flex; flex-wrap: wrap; gap: 0.25em 0.9em; }
  .in-file-names code { font-family: var(--dg-font-mono); font-size: var(--dg-text-sm); color: var(--dg-text); background: none; padding: 0; }
  .in-file-text { margin: 0; font-size: var(--dg-text-sm); line-height: 1.55; color: var(--dg-text-muted); }
  .in-file-path { justify-self: end; font-family: var(--dg-font-mono); font-size: var(--dg-text-xs); color: var(--dg-text-faint); background: none; padding: 0; text-align: right; overflow-wrap: anywhere; }
  @media (max-width: 860px) {
    .in-file { grid-template-columns: 1fr; row-gap: var(--dg-space-1); }
    .in-file-path { justify-self: start; text-align: left; }
  }

  /* Explore: the same typographic index as the landing page. */
  .in-index { list-style: none; margin: 0; padding: 0; }
  .in-index a {
    display: grid; grid-template-columns: 3.25rem minmax(0, 2fr) minmax(0, 3fr) minmax(0, 4fr) auto; column-gap: var(--dg-space-4); align-items: baseline;
    padding: var(--dg-space-4) 0; color: var(--dg-text); text-decoration: none;
    background: linear-gradient(var(--doc-rule), var(--doc-rule)) top / 100% 1px no-repeat;
    transition: background-color var(--dg-dur-motion) var(--dg-ease-motion), padding var(--dg-dur-motion) var(--dg-ease-motion);
  }
  .in-index li:last-child a { background-image: linear-gradient(var(--doc-rule), var(--doc-rule)), linear-gradient(var(--doc-rule), var(--doc-rule)); background-position: top, bottom; background-size: 100% 1px, 100% 1px; }
  .in-eyebrow { font-size: var(--dg-text-xs); font-weight: var(--dg-weight-semi); text-transform: uppercase; letter-spacing: 0.12em; color: var(--dg-text-faint); }
  .in-index strong { font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem); font-weight: var(--dg-weight-semi); letter-spacing: -0.035em; line-height: 1.05; }
  .in-index em { font-style: normal; font-size: var(--dg-text-sm); color: var(--dg-text-muted); }
  .in-index svg { width: 20px; height: 20px; transition: translate .5s var(--dg-ease), color var(--dg-dur) var(--dg-ease); }
  .in-index a:hover { background-color: var(--doc-demo-bg); padding-inline: var(--dg-space-3); }
  .in-index a:hover svg { translate: 3px -3px; color: var(--doc-accent); }
  @media (max-width: 860px) {
    .in-index a { grid-template-columns: 3rem 1fr auto; row-gap: var(--dg-space-1); }
    .in-index .in-eyebrow, .in-index strong, .in-index em { grid-column: 2; }
    .in-index svg { grid-column: 3; grid-row: 1 / span 3; align-self: center; }
  }
</style>
