---
import Layout from "../../layouts/DocsLayout.astro";
import { CHANGELOG } from "../../data/changelog";

const latestReleased = CHANGELOG.find((r) => !r.unreleased);
---

<Layout title="Changelog" lead="Todo lo que cambia en dgarz design, versión por versión." currentHref="/getting-started/changelog">
  <div class="cl-list">
    {CHANGELOG.map((release) => (
      <article class:list={["cl-release", release === latestReleased && "is-latest"]} aria-labelledby={`v-${release.version}`}>
        <header class="cl-head">
          <h2 class="cl-version" id={`v-${release.version}`}>{release.version}</h2>
          <dl class="cl-meta">
            <div><dt>Fecha</dt><dd>{release.unreleased ? "Próximamente" : <time datetime={release.date}>{release.date}</time>}</dd></div>
            <div><dt>Estado</dt><dd>{release.unreleased ? "En desarrollo" : release === latestReleased ? <span class="cl-latest">Última</span> : "Publicada"}</dd></div>
            {!release.unreleased && <div><dt>npm</dt><dd><a href={`https://www.npmjs.com/package/dgarz-design/v/${release.version}`} target="_blank" rel="noopener">Ver versión ↗</a></dd></div>}
          </dl>
        </header>
        <div class="cl-body">
          <p class="cl-summary">{release.summary}</p>
          <ul class="cl-highlights">
            {release.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>

  <p class="cl-note">
    dgarz design sigue <a class="dg-link" href="https://semver.org/" target="_blank" rel="noopener">Semantic Versioning</a>.
    Historial completo en el <a class="dg-link" href="https://github.com/dgarzonz/dgarz-design/blob/main/CHANGELOG.md" target="_blank" rel="noopener">CHANGELOG.md</a> del repo.
  </p>
</Layout>

<style>
  /* Swiss: each release is a block of the grid with a rule on top, no box.
     Version + metadata on the left (3 of 9 columns), notes on the right. */
  .cl-release {
    display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); column-gap: var(--doc-gutter);
    padding: var(--dg-space-4) 0 var(--dg-space-8);
    background: linear-gradient(var(--doc-rule-strong), var(--doc-rule-strong)) top / 100% 1px no-repeat;
  }
  .cl-head { grid-column: 1 / span 3; }
  .cl-body { grid-column: 4 / -1; }
  .cl-version {
    margin: 0 0 var(--dg-space-4);
    font-family: var(--dg-font-sans); font-size: clamp(2.5rem, 1.6rem + 2.6vw, 4rem); font-weight: var(--dg-weight-bold);
    line-height: 0.9; letter-spacing: -0.05em; font-variant-numeric: tabular-nums;
  }
  /* The current release: the red square, as in the index and the top bar. */
  .cl-release.is-latest .cl-version::after {
    content: ""; display: inline-block; width: 0.16em; height: 0.16em; margin-left: 0.06em;
    background: var(--doc-accent);
  }
  .cl-meta { margin: 0; font-size: var(--dg-text-sm); }
  .cl-meta > div {
    display: grid; grid-template-columns: 4.5rem 1fr; gap: var(--dg-space-2); padding: var(--dg-space-2) 0;
    background: linear-gradient(var(--doc-rule), var(--doc-rule)) top / 100% 1px no-repeat;
  }
  .cl-meta dt { font-size: var(--dg-text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--dg-text-faint); padding-top: 0.15em; }
  .cl-meta dd { margin: 0; font-family: var(--dg-font-mono); font-size: var(--dg-text-xs); color: var(--dg-text); }
  .cl-meta a { color: inherit; text-decoration: none; }
  .cl-meta a:hover { color: var(--doc-accent); }
  .cl-latest { color: var(--doc-accent); text-transform: uppercase; letter-spacing: 0.1em; font-family: var(--dg-font-sans); font-weight: var(--dg-weight-semi); }
  .cl-summary { margin: 0 0 var(--dg-space-5); font-size: var(--dg-text-xl); line-height: 1.4; letter-spacing: -0.015em; color: var(--dg-text); text-wrap: pretty; max-width: 46ch; }
  .cl-highlights { list-style: none; margin: 0; padding: 0; }
  .cl-highlights li {
    position: relative; padding: var(--dg-space-3) 0 var(--dg-space-3) 1.4em;
    font-size: var(--dg-text-sm); line-height: 1.55; color: var(--dg-text-muted);
    background: linear-gradient(var(--doc-rule), var(--doc-rule)) top / 100% 1px no-repeat;
  }
  .cl-highlights li::before {
    content: ""; position: absolute; left: 0; top: calc(var(--dg-space-3) + 0.55em);
    width: 6px; height: 6px; background: var(--dg-text);
  }
  .cl-note { margin-top: var(--dg-space-6); color: var(--dg-text-muted); font-size: var(--dg-text-sm); }
  @media (max-width: 860px) {
    .cl-head, .cl-body { grid-column: 1 / -1; }
    .cl-head { margin-bottom: var(--dg-space-5); }
  }
</style>
