<script is:inline>
  // Showcase parallax: each column drifts by its data-speed (px) as the section
  // crosses the viewport. Transform only, one write per frame, off when reduced motion.
  (function () {
    var section = document.querySelector("[data-pub-parallax]");
    if (!section) return;
    var cols = Array.prototype.slice.call(section.querySelectorAll("[data-speed]"));
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    var queued = false;
    function update() {
      queued = false;
      if (reduce.matches) { cols.forEach(function (c) { c.style.transform = ""; }); return; }
      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight;
      if (rect.bottom < 0 || rect.top > vh) return;
      // -1 when the section enters from below, 0 centered, 1 as it leaves above.
      var progress = (vh / 2 - (rect.top + rect.height / 2)) / (vh / 2 + rect.height / 2);
      progress = Math.max(-1, Math.min(1, progress));
      cols.forEach(function (c) {
        c.style.transform = "translate3d(0," + (-progress * parseFloat(c.dataset.speed)).toFixed(1) + "px,0)";
      });
    }
    function queue() { if (!queued) { queued = true; requestAnimationFrame(update); } }
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    if (reduce.addEventListener) reduce.addEventListener("change", queue);
    update();
  })();
</script>
