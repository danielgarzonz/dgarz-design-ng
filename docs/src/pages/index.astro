---
import SiteHeader from "../components/SiteHeader.astro";
import iconSpriteRaw from "../../../core/src/icons/dgarz-icons.svg?raw";
import "../styles/brand.css";

const iconSprite = iconSpriteRaw
  .replace(/<\?xml[^>]*\?>/, "")
  .replace("<svg ", '<svg aria-hidden="true" ');

const cssHref = import.meta.env.DEV ? "/__core/dgarz.full.css" : "/dist/dgarz.full.min.css";
const jsHref  = import.meta.env.DEV ? "/__core/dgarz.js" : "/dist/dgarz.js";

const features = [
  { title: "Monocromo por diseño", text: "Una escala de grises de 12 pasos. Todo el sistema de color deriva de ella y funciona en claro y oscuro." },
  { title: "Cero dependencias", text: "Un archivo CSS y un archivo JS opcional. Sin jQuery, sin PostCSS y sin Sass requerido." },
  { title: "Modo oscuro nativo", text: "Cambia de tema con un solo atributo, data-theme, y todo el sistema se adapta." },
  { title: "Tokens personalizables", text: "Todos los valores son variables CSS --dg-*, así que puedes adaptar el framework a tu marca." },
];

const sections = [
  { group: "Comenzar", title: "Instalación", text: "Agrega el framework a tu proyecto.", href: "/comenzar/install" },
  { group: "Fundamentos", title: "Color y tokens", text: "El sistema de diseño monocromo.", href: "/fundamentos/color" },
  { group: "Fundamentos", title: "Grid y layout", text: "12 columnas y breakpoints.", href: "/fundamentos/grid" },
  { group: "Componentes", title: "Botones", text: "Variantes, estados y grupos.", href: "/componentes/buttons" },
  { group: "Utilidades", title: "Utilidades", text: "Espaciado, display, flex y texto.", href: "/utilidades/utilities" },
  { group: "App Pack", title: "App Shell", text: "Sidebar, drawer y layout completo.", href: "/app-pack/shell" },
];
---

<!doctype html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" id="docThemeColor" />
  <title>dgarz design — Framework CSS monocromo</title>
  <meta name="description" content="Framework CSS monocromo, sin dependencias y con modo oscuro nativo." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://api.fontshare.com/v2/css?f[]=gambetta@400,401,500,501,600,601&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={cssHref} />
  <script is:inline>
    // Hold the hero entrance until the web fonts are ready (max 1.5s), so the
    // fallback → Gambetta swap happens while the hero is still invisible.
    (function () {
      var root = document.documentElement;
      if (!document.fonts || !document.fonts.load) return;
      root.classList.add("pub-fonts-pending");
      var done = function () { root.classList.remove("pub-fonts-pending"); };
      // fonts.ready resolves before any font is requested; load() requests
      // the title faces explicitly and resolves when they are usable.
      Promise.all([
        document.fonts.load('400 1em "Gambetta"'),
        document.fonts.load('italic 400 1em "Gambetta"')
      ]).then(done, done);
      setTimeout(done, 1500);
    })();
  </script>
  <style is:global>
    body { overflow-x: hidden; padding-top: 60px; background: var(--dg-surface-2); }
    /* Título, párrafo y botones forman un solo bloque centrado en la pantalla
       visible bajo la barra superior (60px). */
    .pub-hero {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center;
      /* White hero (#ffffff = --dg-paper in light; follows the theme in dark),
         bleeding to the viewport edges from inside .dg-container. */
      background: var(--dg-paper);
      margin-inline: calc(50% - 50vw);
      padding-inline: calc(50vw - 50%);
      /* Also extends up behind the fixed 60px menu, so the gaps around its
         rounded corners show the hero background. The extra top padding keeps
         the content centered in the visible area below the menu. */
      margin-top: -60px;
      min-height: 100svh;
      padding-block: calc(60px + var(--dg-space-5)) var(--dg-space-5);
    }
    .pub-title {
      margin: 0;
      font-weight: var(--dg-weight-medium); /* 500: wordmark a step heavier than body serif */
      /* Original scale (3.5rem min, 13vw), shrunk only when "dgarz design"
         (~4.9em wide in Gambetta) would not fit the line on narrow phones. */
      font-size: clamp(2.5rem, min(max(3.5rem, 13vw), calc((100vw - 3rem) / 5.2)), 11rem); line-height: 1; letter-spacing: -0.03em;
      --pub-letters: 11; /* "dgarz" + "design": the sweep starts at the last letter */
    }
    /* Strict sequence, one part after another: title → paragraph → button 1 → button 2.
       --pub-step is each part's own duration; the title ends when its last-swept
       letter ("d") finishes. */
    .pub-hero {
      --pub-step: var(--dg-dur-motion);
      --pub-title-end: calc(120ms + (11 - 1) * 55ms + var(--dg-dur-motion));
    }
    /* Italic glyphs extend beyond their advance width: keep their paint area open. */
    .pub-word { display: inline-block; overflow: visible; }
    .pub-letter {
      display: inline-block;
      /* Extra paint space prevents WebKit clipping animated italic overhangs.
         Negative margins preserve the original letter spacing. */
      padding-inline: .18em;
      margin-inline: -.18em;
      overflow: visible;
      /* Right-to-left sweep: the last letter enters first, each one slides in
         from the right while it fades in and comes into focus. */
      animation: pub-letter-sweep var(--dg-dur-motion) var(--dg-ease-motion) backwards;
      animation-delay: calc((var(--pub-letters) - 1 - var(--i)) * 55ms + 120ms);
    }
    @keyframes pub-letter-sweep {
      from { opacity: 0; transform: translateX(.45em); filter: blur(12px); }
      to { opacity: 1; transform: none; filter: blur(0); }
    }
    /* After the title: paragraph → button 1 → button 2, each fading in place. */
    .pub-reveal {
      animation: pub-reveal var(--pub-step) var(--dg-ease-motion) backwards;
      animation-delay: calc(var(--pub-title-end) + var(--pub-order, 0) * var(--pub-step));
    }
    @keyframes pub-reveal {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    /* Paused + backwards fill keeps the hero in its hidden start state. */
    .pub-fonts-pending :is(.pub-letter, .pub-reveal) { animation-play-state: paused; }
    .pub-intro { max-width: 36rem; padding-top: var(--dg-space-5); }
    .pub-intro .dg-cluster { justify-content: center; }
    /* Editorial showcase after the hero: three staggered columns of poster-like
       interfaces built with the framework; columns drift at different speeds
       on scroll (parallax, transform only). */
    .pub-showcase {
      position: relative; overflow: hidden;
      margin-inline: calc(50% - 50vw); padding: clamp(4rem, 9vw, 7.5rem) calc(50vw - 50%);
      /* Always dark: the posters are fixed images, not theme-aware. */
      background: var(--dg-950);
    }
    .pub-showcase-grid {
      display: grid; grid-template-columns: repeat(3, minmax(0, 19rem));
      justify-content: center; align-items: start; gap: clamp(1rem, 2.4vw, 1.75rem);
    }
    .pub-showcase-col { display: flex; flex-direction: column; gap: clamp(1rem, 2.4vw, 1.75rem); will-change: transform; }
    .pub-showcase-col-mid { margin-top: -4rem; }
    .pub-showcase-col-end { margin-top: 3rem; }
    /* Posters are WebP renders of docs/scripts/showcase/posters.html
       (regenerate with docs/scripts/render-showcase.mjs). */
    .pub-poster-img { display: block; width: 100%; height: auto; }
    /* Small screens: fixed-width posters, middle column centered; the side
       columns run off the edges and are clipped by the band (editorial crop). */
    @media (max-width: 860px) {
      .pub-showcase-grid { grid-template-columns: repeat(3, 15rem); justify-content: center; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pub-showcase-col { will-change: auto; transform: none !important; }
    }

    /* Component gallery: live framework markup, inert (preview only). */
    .pub-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--dg-space-4); }
    @media (max-width: 991px) { .pub-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 575px) { .pub-gallery { grid-template-columns: minmax(0, 1fr); } }
    .pub-tile { position: relative; display: flex; flex-direction: column; }
    .pub-tile-stage {
      display: grid; place-items: center; min-height: 240px; flex: 1;
      padding: var(--dg-space-5); background: var(--dg-surface);
    }
    .pub-tile-stage > * { max-width: 100%; }
    .pub-tile-form { width: min(100%, 17rem); }
    .pub-tile-modal { width: min(100%, 22rem); max-height: none; animation: none; }
    .pub-tile-glass {
      background:
        radial-gradient(circle at 18% 30%, #ff7a1a 0, transparent 40%),
        radial-gradient(circle at 82% 22%, #8e7dff 0, transparent 42%),
        radial-gradient(circle at 60% 95%, #22c55e 0, transparent 40%),
        linear-gradient(135deg, #0f1a2e, #247cff);
    }
    .pub-tile-meta { display: flex; align-items: center; justify-content: space-between; gap: var(--dg-space-3); padding: var(--dg-space-4) var(--dg-space-5); background: var(--dg-surface); }
    .pub-tile { overflow: hidden; }
    .pub-tile-meta h3 { margin: 0; }
    .pub-tile-meta > div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    /* Only the arrow navigates to the docs; the components above are live.
       It is a framework button (subtle, icon), so it shares the buttons' hover. */
    .pub-tile-arrow { flex: none; min-width: 0; }
    .pub-tile-arrow svg { width: 1rem; height: 1rem; transition: transform .5s var(--dg-ease); }
    .pub-tile-arrow:is(:hover, :focus-visible) svg { transform: translate(2px, -2px); }
    .pub-main .dg-card { border: 0; }
    .pub-link { color: inherit; text-decoration: none; }
    .pub-link:hover { background: var(--dg-surface-3); }
    .pub-code { margin: 0; overflow-x: auto; }
    .pub-cta {
      display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
      gap: var(--dg-space-5); padding: var(--dg-space-7);
      border-radius: var(--dg-radius-xl); background: var(--dg-solid); color: var(--dg-on-solid);
    }
    .pub-cta h2 { color: inherit; margin: 0; }
    .pub-cta .dg-btn { background: var(--dg-on-solid); color: var(--dg-solid); border: 0; }
    .pub-footer { padding-block: var(--dg-space-6); color: var(--dg-text-muted); font-size: var(--dg-text-sm); }

    @media (max-width: 860px) {
      .pub-cta { padding: var(--dg-space-5); }
    }
    @media (prefers-reduced-motion: reduce) {
      .pub-letter, .pub-reveal { animation: none; }
    }
  </style>
</head>
<body>
<Fragment set:html={iconSprite} />

<SiteHeader currentHref="/" hideOnScroll />

<main class="pub-main dg-container">
  <section class="pub-hero">
    <h1 class="dg-display pub-title" aria-label="dgarz design">
      <span class="pub-word brand-name" aria-hidden="true">{[..."dgarz"].map((letter, i) => <span class="pub-letter" style={`--i: ${i}`}>{letter}</span>)}</span>{" "}
      <span class="pub-word brand-suffix" aria-hidden="true">{[..."design"].map((letter, i) => <span class="pub-letter" style={`--i: ${i + 5}`}>{letter}</span>)}</span>
    </h1>
    <div class="pub-intro">
      <p class="dg-lead pub-reveal" style="--pub-order: 0">Un framework CSS moderno y monocromo, sin dependencias y con modo oscuro nativo.</p>
      <div class="dg-cluster dg-mt-4">
        <a href="/comenzar/intro" class="dg-btn dg-btn-primary pub-reveal" style="--pub-order: 1">Empezar</a>
        <a href="/componentes/buttons" class="dg-btn dg-btn-subtle pub-reveal" style="--pub-order: 2">Ver componentes</a>
      </div>
    </div>
  </section>

  <section class="pub-showcase" data-pub-parallax aria-labelledby="pub-showcase-title">
    <h2 id="pub-showcase-title" class="dg-sr-only">Sitios de ejemplo hechos con dgarz design</h2>
    <div class="pub-showcase-grid">
      <div class="pub-showcase-col" data-speed="70">
        <img class="pub-poster-img" src="/showcase/01-estudio.webp" alt="Sitio de ejemplo «Estudio Norte», estudio de arquitectura: titular «Espacios que respiran», ilustración de un arco y lista de proyectos." width="304" height="502" loading="lazy" decoding="async">
        <img class="pub-poster-img" src="/showcase/06-cuaderno.webp" alt="Sitio de ejemplo «Cuaderno», newsletter: titular, campo de correo, casilla de aceptación y botón «Suscribirme»." width="304" height="278" loading="lazy" decoding="async">
      </div>
      <div class="pub-showcase-col pub-showcase-col-mid" data-speed="-120">
        <img class="pub-poster-img" src="/showcase/02-evento.webp" alt="Sitio de ejemplo «Forma 26», conferencia: titular «Diseño sin ruido» y botón glass «Reservar lugar» sobre un degradado." width="304" height="454" loading="lazy" decoding="async">
        <img class="pub-poster-img" src="/showcase/04-panel.webp" alt="Sitio de ejemplo «Pulso», panel en modo oscuro: saludo, tabs, métricas de visitas y conversión y barras de progreso." width="304" height="331" loading="lazy" decoding="async">
      </div>
      <div class="pub-showcase-col pub-showcase-col-end" data-speed="40">
        <img class="pub-poster-img" src="/showcase/05-revista.webp" alt="Sitio de ejemplo «Revista Gris»: titular tipográfico «Luz y forma», entradilla del ensayo y esferas ilustradas." width="304" height="410" loading="lazy" decoding="async">
        <img class="pub-poster-img" src="/showcase/03-tienda.webp" alt="Sitio de ejemplo «Atelier Mono», tienda: frasco de sérum, precio, selector de tamaño y botón «Añadir a la bolsa»." width="304" height="440" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <section class="dg-section" data-dg-reveal-children aria-labelledby="pub-gallery">
    <h2 id="pub-gallery" class="dg-mb-2">Componentes listos para usar</h2>
    <p class="dg-muted dg-mb-5">Así se ven tal cual, con el HTML del framework. Cambia el tema para verlos en oscuro.</p>
    <div class="pub-gallery">
      <article class="dg-card pub-tile">
        <div class="pub-tile-stage">
          <div class="dg-stack dg-gap-3">
            <div class="dg-cluster">
              <button type="button" class="dg-btn dg-btn-primary">Guardar</button>
              <button type="button" class="dg-btn dg-btn-subtle">Cancelar</button>
            </div>
            <div class="dg-cluster">
              <button type="button" class="dg-btn dg-btn-success dg-btn-sm">Publicar</button>
              <button type="button" class="dg-btn dg-btn-subtle-info dg-btn-sm">Vista previa</button>
              <button type="button" class="dg-btn dg-btn-primary dg-btn-icon dg-btn-sm" aria-label="Añadir"><svg class="dg-icon dg-icon-sm"><use href="#dg-plus"/></svg></button>
            </div>
          </div>
        </div>
        <div class="pub-tile-meta"><div><h3 class="dg-text-base">Botones</h3><span class="dg-text-sm dg-muted">Variantes y tamaños</span></div><a class="dg-btn-subtle dg-btn-icon pub-tile-arrow" href="/componentes/buttons" aria-label="Documentación de Botones"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a></div>
      </article>

      <article class="dg-card pub-tile">
        <div class="pub-tile-stage">
          <div class="dg-stack dg-gap-3 pub-tile-form">
            <div class="dg-field">
              <label class="dg-label" for="pubDemoEmail">Correo</label>
              <input class="dg-input" id="pubDemoEmail" type="email" value="ana@estudio.com">
            </div>
            <label class="dg-switch"><input type="checkbox" checked><span class="dg-switch-track"></span> Notificaciones</label>
            <label class="dg-check"><input type="checkbox" checked><span class="dg-check-box"></span> Recordarme</label>
          </div>
        </div>
        <div class="pub-tile-meta"><div><h3 class="dg-text-base">Formularios</h3><span class="dg-text-sm dg-muted">Campos y controles</span></div><a class="dg-btn-subtle dg-btn-icon pub-tile-arrow" href="/formularios/forms" aria-label="Documentación de Formularios"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a></div>
      </article>

      <article class="dg-card pub-tile">
        <div class="pub-tile-stage">
          <div class="dg-stack dg-gap-3">
            <div class="dg-alert dg-alert-success">
              <svg class="dg-icon dg-icon-sm dg-alert-icon"><use href="#dg-check"/></svg>
              <div class="dg-alert-body"><div class="dg-alert-title">Guardado</div>Tus cambios están en línea.</div>
            </div>
            <div class="dg-cluster">
              <span class="dg-badge dg-badge-dot dg-badge-success">Activo</span>
              <span class="dg-badge dg-badge-warning">Pendiente</span>
              <span class="dg-badge dg-badge-solid">Pro</span>
            </div>
          </div>
        </div>
        <div class="pub-tile-meta"><div><h3 class="dg-text-base">Alertas y badges</h3><span class="dg-text-sm dg-muted">Estados claros</span></div><a class="dg-btn-subtle dg-btn-icon pub-tile-arrow" href="/componentes/alerts" aria-label="Documentación de Alertas y badges"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a></div>
      </article>

      <article class="dg-card pub-tile">
        <div class="pub-tile-stage">
          <div class="dg-modal dg-modal-sm pub-tile-modal">
            <button type="button" class="dg-modal-close" aria-label="Cerrar"><svg class="dg-icon"><use href="#dg-x"/></svg></button>
            <div class="dg-modal-header"><h4 class="dg-modal-title">Invitar equipo</h4></div>
            <div class="dg-modal-body">Enviaremos un enlace de acceso a cada correo.</div>
            <div class="dg-modal-footer">
              <button type="button" class="dg-btn dg-btn-cancel dg-btn-sm">Cancelar</button>
              <button type="button" class="dg-btn dg-btn-sm">Enviar</button>
            </div>
          </div>
        </div>
        <div class="pub-tile-meta"><div><h3 class="dg-text-base">Modales</h3><span class="dg-text-sm dg-muted">Sólido o glass</span></div><a class="dg-btn-subtle dg-btn-icon pub-tile-arrow" href="/componentes/modales" aria-label="Documentación de Modales"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a></div>
      </article>

      <article class="dg-card pub-tile">
        <div class="pub-tile-stage pub-tile-glass">
          <div class="dg-stack dg-gap-3" style="align-items: center">
            <span class="dg-badge dg-badge-info is-glass">Nuevo</span>
            <div class="dg-cluster">
              <button type="button" class="dg-btn dg-btn-primary is-glass">Explorar</button>
              <button type="button" class="dg-btn dg-btn-subtle is-glass">Guardar</button>
            </div>
          </div>
        </div>
        <div class="pub-tile-meta"><div><h3 class="dg-text-base">Glass opcional</h3><span class="dg-text-sm dg-muted">Sobre imágenes</span></div><a class="dg-btn-subtle dg-btn-icon pub-tile-arrow" href="/fundamentos/superficies#glass-componentes" aria-label="Documentación de Glass opcional"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a></div>
      </article>

      <article class="dg-card pub-tile">
        <div class="pub-tile-stage">
          <div class="dg-stack dg-gap-4" style="align-items: center">
            <div class="dg-tabs dg-tabs-pill" data-dg-tabs aria-label="Secciones de ejemplo">
              <button type="button" class="dg-tab is-active" role="tab" aria-selected="true">Resumen</button>
              <button type="button" class="dg-tab" role="tab" aria-selected="false">Equipo</button>
              <button type="button" class="dg-tab" role="tab" aria-selected="false">Ajustes</button>
            </div>
            <div class="dg-segmented" data-dg-segmented role="group" aria-label="Periodo de ejemplo">
              <button type="button" class="is-active">Día</button>
              <button type="button">Semana</button>
              <button type="button">Mes</button>
            </div>
          </div>
        </div>
        <div class="pub-tile-meta"><div><h3 class="dg-text-base">Navegación</h3><span class="dg-text-sm dg-muted">Tabs y segmentado</span></div><a class="dg-btn-subtle dg-btn-icon pub-tile-arrow" href="/componentes/nav" aria-label="Documentación de Navegación"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a></div>
      </article>
    </div>
  </section>

  <section class="dg-section" data-dg-reveal-children aria-labelledby="pub-features">
    <h2 id="pub-features" class="dg-mb-5">Pensado para ir directo al grano</h2>
    <div class="dg-grid dg-grid-2 dg-gap-4">
      {features.map((item) => (
        <div class="dg-card"><div class="dg-card-body">
          <h3 class="dg-text-lg">{item.title}</h3>
          <p class="dg-muted dg-text-sm dg-mt-2">{item.text}</p>
        </div></div>
      ))}
    </div>
  </section>

  <section class="dg-section" data-dg-reveal-children aria-labelledby="pub-code">
    <h2 id="pub-code" class="dg-mb-3">Clases claras, HTML limpio</h2>
    <p class="dg-muted dg-mb-5">Escribe el marcado y deja que el framework se encargue del resto.</p>
    <pre class="dg-pre pub-code"><code>&lt;html data-theme="dark"&gt;
  &lt;button class="dg-btn dg-btn-primary"&gt;Guardar&lt;/button&gt;
  &lt;span class="dg-badge dg-badge-success"&gt;Activo&lt;/span&gt;
&lt;/html&gt;</code></pre>
  </section>

  <section class="dg-section" data-dg-reveal-children aria-labelledby="pub-docs">
    <h2 id="pub-docs" class="dg-mb-5">Explora la documentación</h2>
    <div class="dg-grid dg-grid-3 dg-gap-3">
      {sections.map((item) => (
        <a href={item.href} class="dg-card pub-link">
          <div class="dg-card-body">
            <div class="dg-eyebrow dg-mb-2">{item.group}</div>
            <h3 class="dg-text-base">{item.title}</h3>
            <p class="dg-text-sm dg-muted dg-mt-1">{item.text}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

