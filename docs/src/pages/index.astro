<script is:inline>
  // Showcase parallax: each column drifts by its data-speed (px) as the section
  // crosses the viewport. Transform only, one write per frame, off with reduced motion.
  (function () {
    var section = document.querySelector("[data-lp-parallax]");
    if (!section) return;
    var cols = Array.prototype.slice.call(section.querySelectorAll("[data-speed]"));
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    var queued = false;
    function update() {
      queued = false;
      if (reduce.matches) { cols.forEach(function (c) { c.style.transform = ""; }); return; }
      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight;
      if (rect.bottom < 0 || rect.top > vh) return;
      var progress = (vh / 2 - (rect.top + rect.height / 2)) / (vh / 2 + rect.height / 2);
      progress = Math.max(-1, Math.min(1, progress));
      cols.forEach(function (c) {
        c.style.transform = "translate3d(0," + (-progress * parseFloat(c.dataset.speed)).toFixed(1) + "px,0)";
      });
    }
    function queue() { if (!queued) { queued = true; requestAnimationFrame(update); } }
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    update();
  })();

  // Figures count up from zero the first time they enter the screen.
  (function () {
    var els = Array.prototype.slice.call(document.querySelectorAll("[data-lp-count]"));
    if (!els.length || !("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    function format(el, n) {
      var s = String(Math.round(n));
      return el.dataset.lpFormat === "thousands" ? s.replace(/\B(?=(\d{3})+(?!\d))/g, " ") : s;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        io.unobserve(entry.target);
        var el = entry.target, target = Number(el.dataset.lpCount), start = null, duration = 1400;
        if (!target) return;
        function step(t) {
          if (start === null) start = t;
          var p = Math.min(1, (t - start) / duration);
          el.textContent = format(el, target * (1 - Math.pow(1 - p, 4)));
          if (p < 1) requestAnimationFrame(step);
        }
        el.textContent = format(el, 0);
        requestAnimationFrame(step);
      });
    }, { threshold: 0.6 });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>
