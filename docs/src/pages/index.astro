---
import Code from "../components/Code.astro";
import "../styles/doc-code.css";
import "../styles/swiss.css";
import SiteHeader from "../components/SiteHeader.astro";
import iconSpriteRaw from "../../../core/src/icons/dgarz-icons.svg?raw";
import "../styles/brand.css";
import { CHANGELOG } from "../data/changelog";

const iconSprite = iconSpriteRaw
  .replace(/<\?xml[^>]*\?>/, "")
  .replace("<svg ", '<svg aria-hidden="true" ');

const cssHref = import.meta.env.DEV ? "/__core/dgarz.full.css" : "/dist/dgarz.full.min.css";
const jsHref  = import.meta.env.DEV ? "/__core/dgarz.js" : "/dist/dgarz.js";
const version = CHANGELOG[0]?.version ?? "1.2.0";

// Spec sheet of the hero and the counters: real figures of the 1.2.0 build.
const spec = [
  { label: "Versión", value: version },
  { label: "Clases", value: "2 836" },
  { label: "Peso", value: "41 KB gzip" },
  { label: "Dependencias", value: "0" },
  { label: "Licencia", value: "MIT" },
];
const figures = [
  { value: 2836, format: "thousands", unit: "clases", text: "Escalas completas en todos los lados y versiones responsivas." },
  { value: 0, unit: "dependencias", text: "Un CSS y un JS opcional. Sin build obligatorio." },
  { value: 41, unit: "KB gzip", text: "Todo el framework, comprimido, con presupuesto en CI." },
  { value: 12, unit: "grises", text: "Una escala monocroma de la que deriva todo el color." },
];
const ideas = ["Monocromo", "Sin dependencias", "Modo oscuro nativo", "Capas de cascada", "Escalas completas", "Animaciones de 1 s", "Glass opcional", "Retícula de 12 columnas"];

const principles = [
  { title: "Monocromo por diseño", text: "Una escala de grises de 12 pasos. Todo el sistema de color deriva de ella y funciona igual en claro y oscuro." },
  { title: "Tu CSS siempre gana", text: "El framework vive en capas de cascada: tus estilos lo sobrescriben sin !important y sin pelear especificidad." },
  { title: "Una clase para cada cosa", text: "Margen, padding, tamaños, posición y grid con escalas completas, y sus versiones para cada tamaño de pantalla." },
  { title: "Movimiento con intención", text: "Entradas y salidas de un segundo, con tokens propios, que respetan la opción de reducir movimiento." },
];

const sections = [
  { group: "Comenzar", title: "Instalación", text: "Agrega el framework a tu proyecto.", href: "/getting-started/install" },
  { group: "Fundamentos", title: "Escalas", text: "Todas las utilidades y sus versiones responsivas.", href: "/foundations/scales" },
  { group: "Formularios", title: "Controles base", text: "Inputs, selects, switches y validación.", href: "/forms/controls" },
  { group: "Componentes", title: "Botones", text: "Variantes, estados y grupos.", href: "/components/buttons" },
  { group: "App Pack", title: "App Shell", text: "Sidebar, drawer y layout completo.", href: "/app-pack/shell" },
  { group: "Studio", title: "Portadas", text: "Diseños completos hechos solo con clases.", href: "/studio/heroes" },
];
const pad = (n: number) => String(n).padStart(2, "0");
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>';
---

<!doctype html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" id="docThemeColor" />
  <title>dgarz design — Framework CSS monocromo</title>
  <meta name="description" content="Framework CSS monocromo, sin dependencias, con modo oscuro nativo, capas de cascada y escalas completas." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://api.fontshare.com/v2/css?f[]=gambetta@400,401,500,501,600,601&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={cssHref} />
  <script is:inline>
    // Hold the hero entrance until Geist is ready (max 1.5s), so the letters
    // never rise in the fallback face and swap mid-animation.
    (function () {
      var root = document.documentElement;
      if (!document.fonts || !document.fonts.load) return;
      root.classList.add("lp-fonts-pending");
      var done = function () { root.classList.remove("lp-fonts-pending"); };
      Promise.all([document.fonts.load('700 1em "Geist"'), document.fonts.load('300 1em "Geist"')]).then(done, done);
      setTimeout(done, 1500);
    })();
  </script>
  <style is:global>
    html { scroll-behavior: smooth; }
    body { margin: 0; padding-top: 60px; background: var(--doc-page-bg); overflow-x: hidden; }
    *:not([class*="dg-shadow-"], .dg-navbar, .dg-app-header, .dg-dock), *::before, *:not(.dg-switch-track)::after { box-shadow: none !important; text-shadow: none !important; }

    /* ---- the page grid: same 1320px measure and insets as the docs ---- */
    .lp-wrap {
      width: 100%; max-width: 1320px; margin-inline: auto;
      padding-inline: max(var(--dg-space-6), env(safe-area-inset-left, 0px)) max(var(--dg-space-6), env(safe-area-inset-right, 0px));
      box-sizing: border-box;
    }
    .lp-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--doc-gutter); }
    @media (max-width: 860px) { .lp-wrap { padding-inline: var(--dg-space-4); } }

    /* Section head: number + title over a full rule, like the docs' sections. */
    .lp-section { padding-block: var(--dg-space-9, 6rem) 0; }
    .lp-head {
      display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--doc-gutter); align-items: baseline;
      padding-top: var(--dg-space-4); margin-bottom: var(--dg-space-7);
      background: linear-gradient(var(--doc-rule-strong), var(--doc-rule-strong)) top / 100% 2px no-repeat;
    }
    .lp-num { font-family: var(--dg-font-mono); font-size: var(--dg-text-sm); color: var(--doc-accent); }
    /* Item numbers belong to their section (04 → 04.1, 04.2…): gray, so only the section number is red. */
    .lp-num.lp-sub { color: var(--dg-text-faint); }
    .lp-head .lp-num { grid-column: 1 / span 1; }
    .lp-head h2 {
      grid-column: 2 / span 7; margin: 0;
      font-family: var(--dg-font-sans); font-weight: var(--dg-weight-bold);
      font-size: clamp(2rem, 1.2rem + 3vw, 4rem); line-height: 0.98; letter-spacing: -0.045em; text-wrap: balance;
    }
    .lp-head p { grid-column: 9 / -1; margin: 0; color: var(--dg-text-muted); font-size: var(--dg-text-sm); line-height: 1.6; }
    .lp-eyebrow { font-size: var(--dg-text-xs); font-weight: var(--dg-weight-semi); text-transform: uppercase; letter-spacing: 0.12em; }
    @media (max-width: 860px) {
      .lp-head { grid-template-columns: 2.5rem 1fr; row-gap: var(--dg-space-3); }
      .lp-head .lp-num { grid-column: 1; }
      .lp-head h2 { grid-column: 2; }
      .lp-head p { grid-column: 2; }
    }

    /* ================= 00 · HERO: a living Swiss poster ================= */
    .lp-hero { position: relative; min-height: calc(100svh - 60px); display: flex; flex-direction: column; overflow: hidden; }
    /* The 12-column grid draws itself line by line, then stays as a faint guide. */
    .lp-gridlines { position: absolute; inset: 0; pointer-events: none; }
    .lp-gridlines .lp-wrap { height: 100%; }
    .lp-gridlines .lp-grid { height: 100%; }
    .lp-gridlines span {
      height: 100%;
      background: linear-gradient(var(--doc-rule), var(--doc-rule)) left / 1px 100% no-repeat;
      transform-origin: top; animation: lp-line 1.2s var(--dg-ease-motion) backwards;
      animation-delay: calc(var(--i) * 45ms);
    }
    .lp-gridlines span:last-child { background-image: linear-gradient(var(--doc-rule), var(--doc-rule)), linear-gradient(var(--doc-rule), var(--doc-rule)); background-position: left, right; background-size: 1px 100%, 1px 100%; }
    @keyframes lp-line { from { transform: scaleY(0); } to { transform: scaleY(1); } }

    .lp-hero-inner { position: relative; flex: 1; display: flex; flex-direction: column; padding-block: var(--dg-space-6) var(--dg-space-7); container-type: inline-size; }
    .lp-kicker { display: flex; flex-wrap: wrap; gap: var(--dg-space-3) var(--dg-space-6); align-items: baseline; }
    .lp-kicker .lp-num { font-size: var(--dg-text-xs); }
    /* The wordmark fills the width of the grid: sized from the container. */
    .lp-title {
      margin: auto 0 0; padding-top: var(--dg-space-7);
      font-family: var(--dg-font-sans); font-size: 17.84cqi; line-height: 0.82; letter-spacing: -0.065em;
      color: var(--dg-text); white-space: nowrap;
    }
    /* Room for the descender of the g inside the clipping mask. */
    .lp-word { display: inline-flex; overflow: hidden; padding-bottom: 0.22em; margin-bottom: -0.14em; vertical-align: top; }
    .lp-word-a { font-weight: var(--dg-weight-bold); }
    .lp-word-b { font-weight: 300; margin-left: 0.18em; }
    .lp-letter { display: inline-block; animation: lp-rise 1s cubic-bezier(.2, .8, .1, 1) backwards; animation-delay: calc(400ms + var(--i) * 55ms); }
    @keyframes lp-rise { from { transform: translateY(105%); } to { transform: translateY(0); } }
    /* The full stop: a red square that drops in last. */
    .lp-dot {
      display: inline-block; width: 0.16em; height: 0.16em; margin-left: 0.06em; vertical-align: baseline;
      background: var(--doc-accent);
      animation: lp-drop 0.9s cubic-bezier(.3, 1.5, .5, 1) backwards; animation-delay: 1.15s;
    }
    @keyframes lp-drop { from { transform: translateY(-3em) scale(0.4); opacity: 0; } 60% { opacity: 1; } to { transform: none; opacity: 1; } }

    .lp-hero-foot { margin-top: var(--dg-space-7); row-gap: var(--dg-space-6); }
    .lp-lead { grid-column: 1 / span 6; margin: 0; font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem); line-height: 1.3; letter-spacing: -0.02em; text-wrap: pretty; }
    .lp-actions { grid-column: 1 / span 6; display: flex; flex-wrap: wrap; gap: var(--dg-space-3); }
    .lp-spec { grid-column: 8 / -1; grid-row: 1 / span 2; margin: 0; align-self: end; }
    .lp-spec div {
      display: grid; grid-template-columns: 1fr auto; gap: var(--dg-space-3); padding: var(--dg-space-2) 0;
      background: linear-gradient(var(--doc-rule), var(--doc-rule)) top / 100% 1px no-repeat;
    }
    .lp-spec dt { font-size: var(--dg-text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--dg-text-faint); }
    .lp-spec dd { margin: 0; font-family: var(--dg-font-mono); font-size: var(--dg-text-sm); }
    .lp-fade { animation: dg-text-in var(--dg-dur-motion) var(--dg-ease-motion) backwards; animation-delay: calc(900ms + var(--o, 0) * 90ms); }
    @media (max-width: 860px) {
      .lp-lead, .lp-actions, .lp-spec { grid-column: 1 / -1; grid-row: auto; }
    }
    .lp-fonts-pending :is(.lp-letter, .lp-dot, .lp-fade) { animation-play-state: paused; }

    /* Square, flat buttons for the poster. */
    .lp-btn {
      display: inline-flex; align-items: center; gap: var(--dg-space-3);
      min-height: 52px; padding: 0 var(--dg-space-5);
      font-size: var(--dg-text-sm); font-weight: var(--dg-weight-semi); text-transform: uppercase; letter-spacing: 0.1em;
      text-decoration: none; border-radius: 0;
      transition: background var(--dg-dur) var(--dg-ease), color var(--dg-dur) var(--dg-ease);
    }
    .lp-btn svg { width: 16px; height: 16px; transition: translate .5s var(--dg-ease); }
    .lp-btn:hover svg { translate: 3px -3px; }
    .lp-btn-solid { background: var(--dg-text); color: var(--doc-page-bg); }
    .lp-btn-solid:hover { background: var(--doc-accent); color: #fff; }
    .lp-btn-quiet { background: var(--doc-demo-bg); color: var(--dg-text); }
    .lp-btn-quiet:hover { background: color-mix(in oklab, var(--dg-text) 10%, var(--doc-demo-bg)); }

    /* ================= 01 · FIGURES: count up when they enter ================= */
    .lp-figures { row-gap: var(--dg-space-7); }
    .lp-figure { grid-column: span 3; padding-top: var(--dg-space-3); background: linear-gradient(var(--doc-rule), var(--doc-rule)) top / 100% 1px no-repeat; }
    .lp-figure-value { display: block; font-size: clamp(3.25rem, 2rem + 4.5vw, 7rem); font-weight: var(--dg-weight-bold); line-height: 0.9; letter-spacing: -0.06em; font-variant-numeric: tabular-nums; }
    .lp-figure-unit { display: block; margin-top: var(--dg-space-3); }
    .lp-figure p { margin: var(--dg-space-2) 0 0; color: var(--dg-text-muted); font-size: var(--dg-text-sm); line-height: 1.55; max-width: 26ch; }
    @media (max-width: 1000px) { .lp-figure { grid-column: span 6; } }
    @media (max-width: 560px) { .lp-figure { grid-column: 1 / -1; } }

    /* ================= 02 · BAND: the ideas, in motion ================= */
    .lp-band { margin-top: var(--dg-space-9, 6rem); padding-block: var(--dg-space-6); background: var(--dg-text); color: var(--doc-page-bg); }
    .lp-band .dg-marquee-track { --dg-marquee-gap: var(--dg-space-7); align-items: center; }
    .lp-band-item { display: inline-flex; align-items: center; gap: var(--dg-space-7); white-space: nowrap; font-size: clamp(2rem, 1rem + 4vw, 4.5rem); font-weight: var(--dg-weight-bold); letter-spacing: -0.045em; line-height: 1; }
    .lp-band-item::after { content: ""; width: 0.28em; height: 0.28em; background: var(--doc-accent); }

    /* ================= 03 · LIVE COMPONENTS ================= */
    .lp-tiles { row-gap: var(--dg-space-7); }
    .lp-tile { grid-column: span 4; display: flex; flex-direction: column; }
    .lp-tile-stage {
      display: grid; place-items: center; min-height: 248px; padding: var(--dg-space-6);
      background: var(--doc-demo-bg); transition: background var(--dg-dur-motion) var(--dg-ease-motion);
    }
    .lp-tile:hover .lp-tile-stage { background: color-mix(in oklab, var(--dg-text) 6%, var(--doc-demo-bg)); }
    .lp-tile-glass {
      background:
        radial-gradient(circle at 20% 25%, #ff7a1a 0, transparent 40%),
        radial-gradient(circle at 80% 30%, #8e7dff 0, transparent 42%),
        linear-gradient(135deg, #0f1a2e, #247cff);
    }
    .lp-tile:hover .lp-tile-glass { background: radial-gradient(circle at 25% 30%, #ff7a1a 0, transparent 42%), radial-gradient(circle at 75% 25%, #8e7dff 0, transparent 44%), linear-gradient(135deg, #0f1a2e, #247cff); }
    .lp-tile-form { width: min(100%, 260px); }
    .lp-tile-modal { position: relative; inset: auto; transform: none; width: min(100%, 300px); margin: 0; animation: none; }
    .lp-tile-meta {
      display: grid; grid-template-columns: 3rem 1fr auto; align-items: baseline; gap: var(--dg-space-2);
      padding-top: var(--dg-space-3); margin-top: var(--dg-space-3);
      background: linear-gradient(var(--doc-rule-strong), var(--doc-rule-strong)) top / 100% 1px no-repeat;
      color: var(--dg-text); text-decoration: none;
    }
    .lp-tile-meta h3 { margin: 0; font-family: var(--dg-font-sans); font-size: var(--dg-text-lg); font-weight: var(--dg-weight-semi); letter-spacing: -0.02em; }
    .lp-tile-meta span:not(.lp-num) { display: block; color: var(--dg-text-muted); font-size: var(--dg-text-sm); }
    .lp-tile-meta svg { width: 20px; height: 20px; transition: translate .5s var(--dg-ease), color var(--dg-dur) var(--dg-ease); }
    .lp-tile-meta:hover svg { translate: 3px -3px; color: var(--doc-accent); }
    @media (max-width: 1000px) { .lp-tile { grid-column: span 6; } }
    @media (max-width: 640px) { .lp-tile { grid-column: 1 / -1; } }

    /* ================= 04 · SHOWCASE: columns drifting at their own pace ================= */
    .lp-showcase { overflow: hidden; }
    .lp-showcase-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--doc-gutter); }
    .lp-showcase-col { display: grid; gap: var(--doc-gutter); will-change: transform; }
    .lp-showcase-col:nth-child(2) { margin-top: var(--dg-space-9, 6rem); }
    .lp-showcase img { display: block; width: 100%; height: auto; border-radius: 0; background: var(--doc-demo-bg); }
    @media (max-width: 640px) {
      .lp-showcase-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .lp-showcase-col:nth-child(3) { display: none; }
    }

    /* ================= 05 · PRINCIPLES ================= */
    .lp-principles { row-gap: var(--dg-space-7); }
    .lp-principle { grid-column: span 6; display: grid; grid-template-columns: 3.25rem 1fr; padding-top: var(--dg-space-4); background: linear-gradient(var(--doc-rule), var(--doc-rule)) top / 100% 1px no-repeat; }
    .lp-principle h3 { margin: 0 0 var(--dg-space-3); font-family: var(--dg-font-sans); font-size: clamp(1.5rem, 1.1rem + 1.3vw, 2.4rem); font-weight: var(--dg-weight-semi); line-height: 1.05; letter-spacing: -0.035em; }
    .lp-principle p { margin: 0; color: var(--dg-text-muted); line-height: 1.6; max-width: 46ch; }
    @media (max-width: 860px) { .lp-principle { grid-column: 1 / -1; } }

    /* ================= 06 · CODE + RESULT ================= */
    .lp-code { row-gap: var(--dg-space-5); align-items: stretch; }
    .lp-code > .doc-code { grid-column: 1 / span 7; margin: 0; border-radius: 0; }
    .lp-result { grid-column: 8 / -1; display: grid; place-items: center; gap: var(--dg-space-4); padding: var(--dg-space-7); background: var(--doc-demo-bg); align-content: center; }
    .lp-result .lp-eyebrow { color: var(--dg-text-faint); }
    @media (max-width: 860px) { .lp-code > .doc-code, .lp-result { grid-column: 1 / -1; } }

    /* ================= 07 · INDEX of the documentation ================= */
    .lp-index { list-style: none; margin: 0; padding: 0; counter-reset: lp-index; }
    .lp-index a {
      display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--doc-gutter); align-items: baseline;
      padding: var(--dg-space-5) 0; color: var(--dg-text); text-decoration: none;
      background: linear-gradient(var(--doc-rule), var(--doc-rule)) top / 100% 1px no-repeat;
      transition: background-color var(--dg-dur-motion) var(--dg-ease-motion), padding var(--dg-dur-motion) var(--dg-ease-motion);
    }
    .lp-index li:last-child a { background-image: linear-gradient(var(--doc-rule), var(--doc-rule)), linear-gradient(var(--doc-rule), var(--doc-rule)); background-position: top, bottom; background-size: 100% 1px, 100% 1px; }
    .lp-index .lp-num { grid-column: 1; }
    .lp-index .lp-eyebrow { grid-column: 2 / span 2; color: var(--dg-text-faint); }
    .lp-index strong { grid-column: 4 / span 4; font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.6rem); font-weight: var(--dg-weight-semi); letter-spacing: -0.04em; line-height: 1; }
    .lp-index em { grid-column: 8 / span 4; font-style: normal; color: var(--dg-text-muted); font-size: var(--dg-text-sm); }
    .lp-index svg { grid-column: 12; justify-self: end; width: 24px; height: 24px; transition: translate .5s var(--dg-ease), color var(--dg-dur) var(--dg-ease); }
    .lp-index a:hover { background-color: var(--doc-demo-bg); padding-inline: var(--dg-space-4); }
    .lp-index a:hover svg { translate: 4px -4px; color: var(--doc-accent); }
    @media (max-width: 860px) {
      .lp-index a { grid-template-columns: 2.5rem 1fr auto; row-gap: var(--dg-space-1); }
      .lp-index .lp-eyebrow, .lp-index strong, .lp-index em { grid-column: 2; }
      .lp-index svg { grid-column: 3; grid-row: 1 / span 3; align-self: center; }
    }

    /* ================= 08 · CLOSE ================= */
    .lp-close { container-type: inline-size; }
    .lp-close-title { margin: 0; font-family: var(--dg-font-sans); font-size: 25.75cqi; font-weight: var(--dg-weight-bold); line-height: 0.82; letter-spacing: -0.07em; white-space: nowrap; }
    .lp-close-title .lp-dot { animation: none; }
    .lp-install { margin-top: var(--dg-space-7); row-gap: var(--dg-space-4); align-items: center; }
    .lp-install .doc-code { grid-column: 1 / span 7; margin: 0; border-radius: 0; }
    .lp-install .lp-actions { grid-column: 9 / -1; justify-content: flex-end; }
    @media (max-width: 860px) { .lp-install .doc-code, .lp-install .lp-actions { grid-column: 1 / -1; justify-content: flex-start; } }

    .lp-footer { margin-top: var(--dg-space-9, 6rem); padding-block: var(--dg-space-5) var(--dg-space-8); background: linear-gradient(var(--doc-rule-strong), var(--doc-rule-strong)) no-repeat; background-size: 100% 2px; background-origin: content-box; background-position: 0 calc(-1 * var(--dg-space-5)); row-gap: var(--dg-space-5); font-size: var(--dg-text-sm); }
    .lp-footer-brand { grid-column: 1 / span 4; align-self: start; display: inline-flex; align-items: center; gap: 0; font-size: 1.0625rem; font-weight: var(--dg-weight-bold); letter-spacing: -0.035em; }
    .lp-footer-brand::before { content: ""; width: 9px; height: 9px; margin-right: 0.55em; background: var(--doc-accent); }
    .lp-footer-brand span { font-weight: var(--dg-weight-normal); margin-left: 0.24em; }
    .lp-footer nav { grid-column: span 3; display: grid; gap: var(--dg-space-2); align-content: start; }
    .lp-footer nav .lp-eyebrow { color: var(--dg-text-faint); margin-bottom: var(--dg-space-1); }
    .lp-footer a { color: var(--dg-text-muted); text-decoration: none; }
    .lp-footer a:hover { color: var(--dg-text); }
    .lp-footer small { grid-column: 11 / -1; justify-self: end; align-self: end; color: var(--dg-text-faint); font-family: var(--dg-font-mono); }
    @media (max-width: 860px) {
      .lp-footer-brand { grid-column: 1 / -1; }
      .lp-footer nav { grid-column: span 6; }
      .lp-footer small { grid-column: 1 / -1; justify-self: start; }
    }

    @media (prefers-reduced-motion: reduce) {
      .lp-gridlines span, .lp-letter, .lp-dot, .lp-fade { animation: none; }
      .lp-band .dg-marquee-track { animation: none; }
    }
  </style>
</head>
