---
import Layout from "../../layouts/DocsLayout.astro";
const pageContent = `<div class="doc-demo">
        <div class="dg-cluster dg-gap-5 dg-text-2xl">
          <svg class="dg-icon"><use href="#dg-home"/></svg>
          <svg class="dg-icon"><use href="#dg-chart"/></svg>
          <svg class="dg-icon"><use href="#dg-users"/></svg>
          <svg class="dg-icon"><use href="#dg-settings"/></svg>
          <svg class="dg-icon"><use href="#dg-bell"/></svg>
          <svg class="dg-icon"><use href="#dg-search"/></svg>
          <svg class="dg-icon"><use href="#dg-mail"/></svg>
          <svg class="dg-icon"><use href="#dg-folder"/></svg>
          <svg class="dg-icon"><use href="#dg-star"/></svg>
          <svg class="dg-icon"><use href="#dg-inbox"/></svg>
        </div>
      </div>
      <div class="doc-code"><button class="cp">Copiar</button><pre>&lt;svg class="dg-icon"&gt;&lt;use href="dgarz-icons.svg#dg-home"&gt;&lt;/use&gt;&lt;/svg&gt;</pre></div>`;
---

<Layout title="Iconos" lead="Sprite SVG incluido con el framework." currentHref="/app-pack/icons">
  <Fragment set:html={pageContent} />
</Layout>
