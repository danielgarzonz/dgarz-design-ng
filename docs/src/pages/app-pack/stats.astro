---
import Layout from "../../layouts/DocsLayout.astro";
const pageContent = `<div class="doc-sub">Tarjetas de métrica</div>
      <p class="dg-muted dg-text-sm dg-mb-4"><code class="dg-code">.dg-stat</code> muestra una etiqueta, un valor y una variación. <code class="dg-code">.dg-stat-delta</code> con <code class="dg-code">.is-up</code> o <code class="dg-code">.is-down</code> indica si subió o bajó.</p>
      <div class="doc-example">
<div class="doc-demo is-plain">
        <div class="dg-grid dg-grid-3">
          <div class="dg-stat">
            <div class="dg-stat-label">Ingresos mensuales</div>
            <div class="dg-stat-value">$48.2k</div>
            <span class="dg-stat-delta is-up"><svg class="dg-icon dg-icon-sm"><use href="#dg-arrow-up"/></svg>12.4% vs mes anterior</span>
          </div>
          <div class="dg-stat">
            <div class="dg-stat-label">Clientes activos</div>
            <div class="dg-stat-value">612</div>
            <span class="dg-stat-delta is-down">−1.8% esta semana</span>
          </div>
          <div class="dg-stat">
            <div class="dg-stat-label">Tasa de conversión</div>
            <div class="dg-stat-value">3.9%</div>
            <span class="dg-stat-delta is-up"><svg class="dg-icon dg-icon-sm"><use href="#dg-arrow-up"/></svg>+0.6 pts</span>
          </div>
        </div>
      </div>
      <div class="doc-code"><button class="cp">Copiar</button><pre>&lt;div class="dg-stat"&gt;
  &lt;div class="dg-stat-label"&gt;Ingresos&lt;/div&gt;
  &lt;div class="dg-stat-value"&gt;$48.2k&lt;/div&gt;
  &lt;!-- Delta al alza --&gt;
  &lt;span class="dg-stat-delta is-up"&gt;+12.4%&lt;/span&gt;
  &lt;!-- Delta a la baja --&gt;
  &lt;span class="dg-stat-delta is-down"&gt;−1.8%&lt;/span&gt;
&lt;/div&gt;</pre></div>
</div>`;
---

<Layout title="Stat Cards" lead="Tarjetas de métrica con valor, label y delta." currentHref="/app-pack/stats">
  <Fragment set:html={pageContent} />
</Layout>
