---
import Layout from "../../layouts/DocsLayout.astro";
const pageContent = `<div class="doc-sub">Horizontal</div>
      <p class="dg-muted dg-text-sm dg-mb-4">Muestra el avance de un flujo corto en una sola línea. Cada paso usa <code class="dg-code">.is-done</code> si está completado, <code class="dg-code">.is-active</code> si es el actual y ninguna clase si sigue pendiente. Con <code class="dg-code">data-dg-steps-play</code> se reproduce desde el paso 1 al entrar en pantalla.</p>
      <div class="doc-example">
<div class="doc-demo is-plain">
        <div class="dg-steps dg-max-w-xl" data-dg-steps-play>
          <div class="dg-step is-done"><span class="dg-step-dot"><svg class="dg-icon dg-icon-sm"><use href="#dg-check"/></svg></span><span class="dg-step-label">Cuenta</span></div>
          <div class="dg-step is-done"><span class="dg-step-dot"><svg class="dg-icon dg-icon-sm"><use href="#dg-check"/></svg></span><span class="dg-step-label">Perfil</span></div>
          <div class="dg-step is-active"><span class="dg-step-dot">3</span><span class="dg-step-label">Pago</span></div>
          <div class="dg-step"><span class="dg-step-dot">4</span><span class="dg-step-label">Listo</span></div>
        </div>
      </div>
      <div class="doc-code"><button class="cp">Copiar</button><pre>&lt;div class="dg-steps" data-dg-steps-play&gt;
  &lt;div class="dg-step is-done"&gt;
    &lt;span class="dg-step-dot"&gt;
      &lt;svg class="dg-icon dg-icon-sm"&gt;&lt;use href="#dg-check"/&gt;&lt;/svg&gt;
    &lt;/span&gt;
    &lt;span class="dg-step-label"&gt;Cuenta&lt;/span&gt;
  &lt;/div&gt;
  &lt;div class="dg-step is-done"&gt;
    &lt;span class="dg-step-dot"&gt;
      &lt;svg class="dg-icon dg-icon-sm"&gt;&lt;use href="#dg-check"/&gt;&lt;/svg&gt;
    &lt;/span&gt;
    &lt;span class="dg-step-label"&gt;Perfil&lt;/span&gt;
  &lt;/div&gt;
  &lt;div class="dg-step is-active"&gt;
    &lt;span class="dg-step-dot"&gt;3&lt;/span&gt;
    &lt;span class="dg-step-label"&gt;Pago&lt;/span&gt;
  &lt;/div&gt;
  &lt;div class="dg-step"&gt;
    &lt;span class="dg-step-dot"&gt;4&lt;/span&gt;
    &lt;span class="dg-step-label"&gt;Listo&lt;/span&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>
</div>

      <div class="doc-sub">Vertical con descripción</div>
      <p class="dg-muted dg-text-sm dg-mb-4">Añade <code class="dg-code">.dg-steps-vertical</code> cuando cada paso necesita más contexto. El texto va dentro de <code class="dg-code">.dg-step-body</code>, con el título en <code class="dg-code">.dg-step-label</code> y el detalle en <code class="dg-code">.dg-step-desc</code>.</p>
      <div class="doc-example">
<div class="doc-demo is-plain">
        <div class="dg-steps dg-steps-vertical dg-max-w-sm" data-dg-steps-play>
          <div class="dg-step is-done"><span class="dg-step-dot"><svg class="dg-icon dg-icon-sm"><use href="#dg-check"/></svg></span><div class="dg-step-body"><div class="dg-step-label">Crear cuenta</div><div class="dg-step-desc">Email verificado correctamente.</div></div></div>
          <div class="dg-step is-active"><span class="dg-step-dot">2</span><div class="dg-step-body"><div class="dg-step-label">Datos de pago</div><div class="dg-step-desc">Añade un método de pago para continuar.</div></div></div>
          <div class="dg-step"><span class="dg-step-dot">3</span><div class="dg-step-body"><div class="dg-step-label">Confirmación</div><div class="dg-step-desc">Revisa y finaliza tu registro.</div></div></div>
        </div>
      </div>
      <div class="doc-code"><button class="cp">Copiar</button><pre>&lt;div class="dg-steps dg-steps-vertical" data-dg-steps-play&gt;
  &lt;div class="dg-step is-done"&gt;
    &lt;span class="dg-step-dot"&gt;
      &lt;svg class="dg-icon dg-icon-sm"&gt;&lt;use href="#dg-check"/&gt;&lt;/svg&gt;
    &lt;/span&gt;
    &lt;div class="dg-step-body"&gt;
      &lt;div class="dg-step-label"&gt;Crear cuenta&lt;/div&gt;
      &lt;div class="dg-step-desc"&gt;Email verificado correctamente.&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div class="dg-step is-active"&gt;
    &lt;span class="dg-step-dot"&gt;2&lt;/span&gt;
    &lt;div class="dg-step-body"&gt;
      &lt;div class="dg-step-label"&gt;Datos de pago&lt;/div&gt;
      &lt;div class="dg-step-desc"&gt;Añade un método de pago para continuar.&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div class="dg-step"&gt;
    &lt;span class="dg-step-dot"&gt;3&lt;/span&gt;
    &lt;div class="dg-step-body"&gt;
      &lt;div class="dg-step-label"&gt;Confirmación&lt;/div&gt;
      &lt;div class="dg-step-desc"&gt;Revisa y finaliza tu registro.&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>
</div>`;
---

<Layout title="Steps" lead="Indicador de pasos para flujos multi-etapa." currentHref="/app-pack/steps">
  <Fragment set:html={pageContent} />
</Layout>
