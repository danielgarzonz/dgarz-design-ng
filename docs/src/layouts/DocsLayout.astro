---
import { NAV, getPrevNext, type NavItem } from "../data/nav";
import SiteHeader from "../components/SiteHeader.astro";
import iconSpriteRaw from "../../../core/src/icons/dgarz-icons.svg?raw";
import "../styles/doc-patterns.css";
import "../styles/brand.css";
import "../styles/doc-code.css";
import "../styles/swiss.css";

interface Props {
  title: string;
  lead?: string;
  currentHref: string;
}

const { title, lead, currentHref } = Astro.props;
const { prev, next } = getPrevNext(currentHref);

// Sprite único: se incrusta el del core para que docs y framework nunca se desincronicen
const iconSprite = iconSpriteRaw
  .replace(/<\?xml[^>]*\?>/, "")
  .replace("<svg ", '<svg aria-hidden="true" ');

const activeGroup = NAV.find((g) => g.items.some((i) => i.href === currentHref));
// Swiss numbering: group and page position, e.g. Fundamentos › Escalas = 02.15.
const pad = (n: number) => String(n).padStart(2, "0");
const groupNumber = activeGroup ? NAV.indexOf(activeGroup) + 1 : 0;
const pageIndex = activeGroup ? activeGroup.items.findIndex((i) => i.href === currentHref) + 1 : 0;
const pageCode = activeGroup ? `${pad(groupNumber)}.${pad(pageIndex)}` : "";

// Cambiar a CDN después de publicar a npm:
// const CDN = `https://cdn.jsdelivr.net/npm/dgarz-design@1.0.0/dist`;
// const cssHref = `${CDN}/dgarz.full.min.css`;
// const jsHref  = `${CDN}/dgarz.min.js`;
const cssHref = import.meta.env.DEV ? "/__core/dgarz.full.css" : "/dist/dgarz.full.min.css";
const jsHref  = import.meta.env.DEV ? "/__core/dgarz.js" : "/dist/dgarz.js";
---

<!doctype html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" id="docThemeColor" />
  <title>{title} — dgarz design</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://api.fontshare.com/v2/css?f[]=gambetta@400,401,500,501,600,601&display=swap" rel="stylesheet" />
  <!-- Layer order declared before the framework CSS. The framework layers are
       nested under one "dg" layer (dg.reset … dg.flat); a sublayer dg.docs sits
       between components and utilities, so a utility on a docs block (e.g.
       dg-bg-surface-2 on .doc-demo) still wins. -->
  <style is:inline>@layer dg.reset, dg.base, dg.layout, dg.components, dg.docs, dg.utilities, dg.flat;</style>
  <link rel="stylesheet" href={cssHref} />
  <style is:global>
    /* Header (60px) + aire. */
    html { scroll-behavior: smooth; scroll-padding-top: 76px; }
    /* Swiss editorial: one grid, one typeface family, one accent, hairline rules. */
    :root {
      --doc-page-bg: #ffffff;
      --doc-panel-bg: #fff;
      --doc-demo-bg: var(--dg-card-bg, #f8f8f8);
      --doc-accent: #e10600;
      --doc-rule: color-mix(in oklab, var(--dg-text) 14%, transparent);
      --doc-rule-strong: var(--dg-text);
      --doc-gutter: var(--dg-space-5);
    }
    [data-theme="dark"] {
      --doc-page-bg: var(--dg-paper);
      --doc-panel-bg: var(--dg-surface);
      --doc-demo-bg: var(--dg-surface-2);
      --doc-accent: #ff453a;
    }
    body { --doc-header-offset: 60px; overflow-x: hidden; padding-top: 60px; background: var(--doc-page-bg); }
    body:has(.pub-nav.is-hidden) { --doc-header-offset: 0px; }

    /* Flat presentation across the entire docs site, including live examples.
       Top menu bars keep their elevation, same as the framework's flat reset. */
    *:not([class*="dg-shadow-"], .dg-navbar, .dg-app-header, .dg-dock), *::before, *:not(.dg-switch-track)::after {
      box-shadow: none !important;
      text-shadow: none !important;
    }
    :focus-visible {
      outline: 2px solid var(--dg-accent) !important;
      outline-offset: 3px;
    }

    /* ---- shell: 12-column grid (index 3 · content 9) ---- */
    .doc-shell {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--doc-gutter);
      max-width: 1320px;
      margin-inline: auto;
      padding-inline: var(--dg-space-6);
    }
    .doc-sidebar { grid-column: 1 / span 3; }
    .doc-main { grid-column: 4 / -1; }
    @media (max-width: 860px) {
      .doc-shell { display: block; padding-inline: 0; }
    }

    /* ---- index (sidebar): typographic, no panel ---- */
    .doc-sidebar {
      position: sticky; top: var(--doc-header-offset); align-self: start;
      height: calc(100dvh - var(--doc-header-offset)); overflow-y: auto;
      transition: top var(--dg-dur-motion) var(--dg-ease-motion), height var(--dg-dur-motion) var(--dg-ease-motion);
      scroll-behavior: auto; overflow-anchor: none;
      padding: var(--dg-space-7) var(--dg-space-4) var(--dg-space-8) 0;
      scrollbar-width: thin;
    }
    @media (min-width: 861px) {
      .dg-navbar.pub-nav { width: min(100%, 1320px); }
    }
    .doc-nav-label {
      display: flex; align-items: baseline; gap: var(--dg-space-3);
      font-family: var(--dg-font-sans); font-size: var(--dg-text-xs); font-weight: var(--dg-weight-semi);
      text-transform: uppercase; letter-spacing: 0.12em; color: var(--dg-text);
      margin: var(--dg-space-6) 0 var(--dg-space-2);
      padding-top: var(--dg-space-3);
      background: linear-gradient(var(--doc-rule-strong), var(--doc-rule-strong)) top / 100% 1px no-repeat;
    }
    .doc-nav-label:first-child { margin-top: 0; }
    .doc-nav-num { font-family: var(--dg-font-mono); font-weight: var(--dg-weight-normal); letter-spacing: 0; color: var(--doc-accent); }
    .doc-nav a {
      position: relative; display: block;
      padding: 0.32em 0 0.32em calc(2ch + var(--dg-space-3));
      font-size: var(--dg-text-sm); line-height: 1.35;
      color: var(--dg-text-muted); text-decoration: none;
      transition: color var(--dg-dur) var(--dg-ease);
    }
    .doc-nav a:hover { color: var(--dg-text); }
    .doc-nav a.is-active, .doc-nav a[aria-current="page"] { color: var(--dg-text); font-weight: var(--dg-weight-semi); }
    /* Active page: a small red square in the number column. */
    .doc-nav a.is-active::before {
      content: ""; position: absolute; left: 0; top: 50%;
      width: 7px; height: 7px; translate: 0 -50%;
      background: var(--doc-accent);
    }

    /* ---- main ---- */
    .doc-main { padding: 0 0 var(--dg-space-8); min-width: 0; counter-reset: doc-sub; }

    /* ---- page header: kicker rule, display title, lead + metadata ---- */
    .doc-hero {
      display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); column-gap: var(--doc-gutter);
      padding-top: var(--dg-space-7); margin-bottom: var(--dg-space-8);
    }
    .doc-hero > * { grid-column: 1 / -1; }
    .doc-hero-kicker {
      display: flex; align-items: baseline; gap: var(--dg-space-4);
      /* Same top inset as the index labels, so both lines of text align. */
      padding-top: var(--dg-space-3);
      font-size: var(--dg-text-xs); font-weight: var(--dg-weight-semi);
      text-transform: uppercase; letter-spacing: 0.12em; color: var(--dg-text);
    }
    .doc-hero-code { font-family: var(--dg-font-mono); font-weight: var(--dg-weight-normal); letter-spacing: 0; color: var(--doc-accent); }
    .doc-hero-tag { margin: 0; padding: 0; background: none; }
    .doc-hero-title {
      font-family: var(--dg-font-sans);
      font-size: clamp(2.75rem, 1.6rem + 4.2vw, 5.75rem);
      font-weight: var(--dg-weight-bold);
      letter-spacing: -0.045em;
      line-height: 0.95;
      color: var(--dg-text);
      text-wrap: balance;
      margin: var(--dg-space-7) 0 var(--dg-space-7);
    }
    .doc-hero-body { display: grid; grid-template-columns: subgrid; row-gap: var(--dg-space-5); }
    .doc-hero-lead {
      grid-column: 1 / span 6;
      margin: 0; max-width: 46ch;
      font-size: var(--dg-text-xl); line-height: 1.45; letter-spacing: -0.01em;
      color: var(--dg-text); text-wrap: pretty;
    }
    .doc-hero-meta { grid-column: 7 / -1; font-size: var(--dg-text-sm); }
    .doc-hero-meta dl { margin: 0; }
    .doc-hero-meta dl > div {
      display: grid; grid-template-columns: 6.5rem 1fr; gap: var(--dg-space-3);
      padding: var(--dg-space-2) 0;
      background: linear-gradient(var(--doc-rule), var(--doc-rule)) top / 100% 1px no-repeat;
    }
    .doc-hero-meta dt { font-size: var(--dg-text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--dg-text-faint); padding-top: 0.15em; }
    .doc-hero-meta dd { margin: 0; color: var(--dg-text); }
    .doc-hero-meta a { color: inherit; text-decoration: none; }
    .doc-hero-meta a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .doc-toc { margin-top: var(--dg-space-5); }
    .doc-toc-label {
      margin: 0; padding-top: var(--dg-space-2);
      font-size: var(--dg-text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--dg-text-faint);
      background: linear-gradient(var(--doc-rule-strong), var(--doc-rule-strong)) top / 100% 1px no-repeat;
    }
    .doc-toc ol { list-style: none; margin: var(--dg-space-2) 0 0; padding: 0; counter-reset: doc-toc; }
    .doc-toc li { counter-increment: doc-toc; display: grid; grid-template-columns: 2.5ch 1fr; gap: var(--dg-space-2); padding: 0.18em 0; }
    .doc-toc li::before { content: counter(doc-toc, decimal-leading-zero); font-family: var(--dg-font-mono); font-size: var(--dg-text-xs); color: var(--dg-text-faint); padding-top: 0.2em; }
    .doc-toc a { color: var(--dg-text-muted); text-decoration: none; }
    .doc-toc a:hover { color: var(--dg-text); }
    @media (max-width: 1100px) {
      .doc-hero-lead, .doc-hero-meta { grid-column: 1 / -1; }
      .doc-hero-meta { max-width: 32rem; }
    }

    /* ---- page text entrance ---- */
    .doc-hero-kicker, .doc-hero-title, .doc-hero-body { animation: dg-text-in var(--dg-dur-motion) var(--dg-ease-motion) backwards; }
    .doc-hero-title { animation-delay: 60ms; }
    .doc-hero-body { animation-delay: 140ms; }
    @media (prefers-reduced-motion: reduce) {
      .doc-hero-kicker, .doc-hero-title, .doc-hero-body { animation: none; }
    }

    /* ---- section headings: numbered automatically, hairline rule above ---- */
    .doc-sub {
      counter-increment: doc-sub;
      display: grid; grid-template-columns: 3.25rem 1fr; align-items: baseline;
      font-size: clamp(1.4rem, 1.1rem + 0.8vw, 1.9rem); font-weight: var(--dg-weight-semi);
      line-height: 1.15; letter-spacing: -0.025em; text-wrap: balance;
      color: var(--dg-text);
      margin: var(--dg-space-8) 0 var(--dg-space-3);
      padding-top: var(--dg-space-4);
      background: linear-gradient(var(--doc-rule-strong), var(--doc-rule-strong)) top / 100% 1px no-repeat;
      scroll-margin-top: calc(var(--doc-header-offset) + var(--dg-space-5));
    }
    .doc-sub::before {
      content: counter(doc-sub, decimal-leading-zero);
      font-family: var(--dg-font-mono); font-size: var(--dg-text-sm); font-weight: var(--dg-weight-normal);
      letter-spacing: 0; color: var(--doc-accent);
    }
    /* The text right under a heading lines up with the heading text, not the number. */
    .doc-sub + p { padding-left: 3.25rem; }
    @media (max-width: 560px) {
      .doc-sub { grid-template-columns: 2.5rem 1fr; }
      .doc-sub + p { padding-left: 0; }
    }

    .doc-subsection {
      font-size: var(--dg-text-xl); font-weight: var(--dg-weight-semi); line-height: 1.3;
      letter-spacing: -0.015em; color: var(--dg-text); margin: var(--dg-space-6) 0 var(--dg-space-2); text-wrap: balance;
    }
    .doc-main > p, .doc-main > section > p {
      max-width: 72ch; margin-bottom: 16px;
      color: var(--dg-text-muted); line-height: 1.65;
    }
    .doc-main > .doc-hero + .doc-sub, .doc-main > .doc-sub:first-child { margin-top: 0; }
    .doc-main > :is(.doc-sub, .doc-subsection) + .doc-example { margin-top: 12px; }
    .doc-structure { list-style: decimal; margin: 0; padding-left: 1.25rem; max-width: 72ch; color: var(--dg-text-muted); line-height: 1.7; }
    .doc-structure li + li { margin-top: 8px; }

    /* One shared surface: live example above, copyable source below.
       Outline survives the flat border reset (border: none !important). */
    .doc-example {
      margin-block: var(--dg-space-5) var(--dg-space-7);
      border-radius: 0;
      overflow: hidden;
      background: var(--doc-demo-bg);
    }
    .doc-example > .doc-demo { margin: 0; border-radius: 0; outline: none; }
    .doc-example > .doc-code { margin: 0; border-radius: 0; outline: none; }

    /* ---- demo block (docs layer: utilities on it still win) ---- */
    @layer dg.docs {
    /* Swiss: the docs' own headings are set in the grotesque, not the framework's
       serif default. Live examples keep the framework look; an explicit
       dg-font-serif still wins (utilities come after this layer). */
    .doc-main :is(h2, h3):not(.doc-demo *, .doc-example *, .doc-hero *) {
      font-family: var(--dg-font-sans);
      font-weight: var(--dg-weight-semi);
      letter-spacing: -0.025em;
    }
    .doc-demo {
      border-radius: 0;
      padding: var(--dg-space-7) var(--dg-space-6);
      background: var(--doc-demo-bg);
    }
    .doc-demo.is-plain { background-image: none; }
    /* Glass demos: colorful, detailed stand-in for a photo so the blur is visible. */
    .doc-demo.glass-stage {
      padding: 3rem 1.5rem;
      background:
        repeating-linear-gradient(115deg, rgb(255 255 255 / .22) 0 6px, transparent 6px 22px),
        radial-gradient(circle at 18% 30%, #ff7a1a 0, transparent 34%),
        radial-gradient(circle at 78% 22%, #8e7dff 0, transparent 36%),
        radial-gradient(circle at 60% 90%, #22c55e 0, transparent 38%),
        linear-gradient(135deg, #0f1a2e, #247cff);
    }
    }
    .doc-demo:has(+ .doc-code) { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .doc-demo + .doc-code { margin-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; }

    .doc-modal-size-tabs { max-width: 100%; overflow-x: auto; flex-wrap: nowrap; }
    .doc-modal-size-tabs button { flex-shrink: 0; white-space: nowrap; }

    /* ---- prev/next: editorial footer ---- */
    .doc-prevnext {
      display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--doc-gutter);
      margin-top: var(--dg-space-9, 6rem);
      padding-top: var(--dg-space-4);
      background: linear-gradient(var(--doc-rule-strong), var(--doc-rule-strong)) top / 100% 2px no-repeat;
    }
    .doc-prevnext a {
      display: flex; flex-direction: column; gap: var(--dg-space-2);
      padding: var(--dg-space-3) 0 var(--dg-space-5);
      color: var(--dg-text); text-decoration: none; min-width: 0;
    }
    .doc-prevnext a.next { grid-column: 2; text-align: right; align-items: flex-end; }
    .doc-prevnext-dir { font-size: var(--dg-text-xs); text-transform: uppercase; letter-spacing: 0.12em; color: var(--dg-text-faint); transition: color var(--dg-dur) var(--dg-ease); }
    .doc-prevnext .name {
      font-size: clamp(1.4rem, 1rem + 1.4vw, 2.25rem); font-weight: var(--dg-weight-semi);
      letter-spacing: -0.03em; line-height: 1.05; overflow-wrap: anywhere;
    }
    .doc-prevnext a:hover .doc-prevnext-dir { color: var(--doc-accent); }
    .doc-prevnext a:hover .name { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }

    /* ---- theme toggle ---- */
    .doc-theme-btn {
      width: 36px; height: 36px; border-radius: var(--dg-radius-pill);
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--dg-text-muted); background: none; border: none; cursor: pointer;
      transition: background var(--dg-dur) var(--dg-ease), color var(--dg-dur) var(--dg-ease);
    }
    .doc-theme-btn:hover { background: var(--dg-surface-2); color: var(--dg-text); }
    .doc-icon-hidden { display: none; }

    .doc-menu-backdrop { display: none; }
    @media (max-width: 860px) {
      .doc-main { padding-inline: var(--dg-space-4); }
      .doc-hero { padding-top: var(--dg-space-5); margin-bottom: var(--dg-space-7); }
      .doc-hero-title { margin: var(--dg-space-5) 0; }
      .doc-hero-lead { font-size: var(--dg-text-lg); }
      .doc-toc { display: none; }
      .doc-example { margin-inline: calc(var(--dg-space-4) * -1); }
      /* Full-screen index under the top bar: a curtain that drops from the bar. */
      .doc-sidebar {
        display: block;
        position: fixed;
        top: 60px; right: 0; bottom: 0; left: 0;
        z-index: 25;
        height: calc(100dvh - 60px);
        max-height: none;
        padding: var(--dg-space-5) var(--dg-space-4) calc(var(--dg-space-8) + env(safe-area-inset-bottom, 0px));
        padding-left: max(var(--dg-space-4), env(safe-area-inset-left, 0px));
        padding-right: max(var(--dg-space-4), env(safe-area-inset-right, 0px));
        border-radius: 0;
        background: var(--doc-page-bg);
        overscroll-behavior: contain;
        visibility: hidden;
        pointer-events: none;
        clip-path: inset(0 0 100% 0);
        transition: clip-path var(--dg-dur-motion) var(--dg-ease-motion), visibility 0s var(--dg-dur-motion);
      }
      .doc-sidebar.is-open {
        visibility: visible;
        pointer-events: auto;
        clip-path: inset(0 0 0 0);
        transition-delay: 0s;
      }
      .doc-sidebar .doc-nav a { font-size: var(--dg-text-base); padding-block: 0.55em; }
      .doc-sidebar .doc-nav-label { margin-top: var(--dg-space-7); }
      .doc-sidebar > :first-child .doc-nav-label { margin-top: 0; padding-top: 0; background: none; }
      /* The bar stays on screen while the index is open (it holds the close button). */
      body.doc-menu-open .pub-nav.is-hidden { transform: none; }
      .doc-sidebar.is-open :is(.doc-nav-label, a) { animation: dg-text-in var(--dg-dur-motion) var(--dg-ease-motion) 160ms backwards; }

      .doc-menu-backdrop {
        display: block;
        position: fixed; inset: 0; z-index: 24;
        border: 0; padding: 0; cursor: pointer;
        background: transparent;
        -webkit-backdrop-filter: blur(0);
        backdrop-filter: blur(0);
        visibility: hidden;
        pointer-events: none;
        transition:
          background var(--dg-dur-motion) var(--dg-ease-motion),
          backdrop-filter var(--dg-dur-motion) var(--dg-ease-motion),
          -webkit-backdrop-filter var(--dg-dur-motion) var(--dg-ease-motion),
          visibility 0s var(--dg-dur-motion);
      }
      body.doc-menu-open {
        overflow: hidden;
      }
      body.doc-menu-open .doc-menu-backdrop {
        background: color-mix(in oklab, var(--dg-950) 32%, transparent);
        -webkit-backdrop-filter: saturate(1.2) blur(8px);
        backdrop-filter: saturate(1.2) blur(8px);
        visibility: visible;
        pointer-events: auto;
        transition-delay: 0s;
      }
      .doc-demo { padding: var(--dg-space-5) var(--dg-space-4); }
    }

    @media (prefers-reduced-motion: reduce) {
      .doc-sidebar, .doc-menu-backdrop { transition: none; }
    }
    @media (max-width: 860px) and (prefers-reduced-motion: reduce) {
      .doc-sidebar { transition: none; clip-path: none; }
      .doc-sidebar.is-open :is(.doc-nav-label, a) { animation: none; }
    }

    /* ---- color page: neutral chips ---- */
    .doc-color-0   { background: var(--dg-0); }
    .doc-color-50  { background: var(--dg-50); }
    .doc-color-100 { background: var(--dg-100); }
    .doc-color-200 { background: var(--dg-200); }
    .doc-color-300 { background: var(--dg-300); }
    .doc-color-400 { background: var(--dg-400); }
    .doc-color-500 { background: var(--dg-500); }
    .doc-color-600 { background: var(--dg-600); }
    .doc-color-700 { background: var(--dg-700); }
    .doc-color-800 { background: var(--dg-800); }
    .doc-color-900 { background: var(--dg-900); }
    .doc-color-950 { background: var(--dg-950); }

  </style>
</head>
<body>

<!-- SVG sprite -->
<Fragment set:html={iconSprite} />

<SiteHeader currentHref={currentHref} hideOnScroll showMainMenu={false} variant="swiss">
    <button slot="actions" class="pub-theme-btn doc-menu-btn" id="docMenuToggle" aria-label="Abrir índice de documentación" aria-expanded="false" aria-controls="docSidebar">
      <svg class="dg-icon pub-icon-open" viewBox="3 3 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path id="docMenuIcon" d="M4 9h16M4 15h16" /></svg>
      <svg class="dg-icon pub-icon-close" viewBox="3 3 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20" /></svg>
    </button>
</SiteHeader>

<button type="button" class="doc-menu-backdrop" id="docMenuBackdrop" aria-label="Cerrar menú" tabindex="-1" aria-hidden="true"></button>
<div class="doc-shell">
  <!-- Sidebar -->
  <aside class="doc-sidebar dg-scroll" id="docSidebar" aria-label="Navegación de documentación">
    {NAV.map((group, groupIndex) => (
      <div>
        <div class="doc-nav-label">
          <span class="doc-nav-num">{pad(groupIndex + 1)}</span>
          {group.title}
        </div>
        <nav class="doc-nav">
          {group.items.map((item) => (
            <a
              href={item.href}
              class={item.href === currentHref ? "is-active" : ""}
              target={item.href.endsWith('.html') ? "_blank" : undefined}
              rel={item.href.endsWith('.html') ? "noopener" : undefined}
            >
              {item.label}{item.href.endsWith('.html') ? ' ↗' : ''}
            </a>
          ))}
        </nav>
      </div>
    ))}
  </aside>
  <!-- Run while parsing, before the content and deferred modules can paint the menu at the top. -->
  <script is:inline>
    (() => {
      const sidebar = document.getElementById('docSidebar');
      if (!sidebar) return;
      sidebar.inert = window.matchMedia('(max-width: 860px)').matches;
      if (!sidebar.clientHeight) return;
      try {
        const stored = sessionStorage.getItem('dgarz-docs-sidebar-scroll');
        if (stored === null) return;
        const top = Number(stored);
        if (Number.isFinite(top) && top >= 0) sidebar.scrollTop = top;
      } catch { /* Keep the menu visible when storage is unavailable. */ }
    })();
  </script>

  <!-- Main -->
  <main class="doc-main" data-dg-reveal-children>
    <!-- Hero -->
    <header class="doc-hero" data-dg-no-reveal>
      <div class="doc-hero-kicker">
        {pageCode && <span class="doc-hero-code">{pageCode}</span>}
        {activeGroup && <span class="doc-hero-tag">{activeGroup.title}</span>}
      </div>
      <h1 class="doc-hero-title">{title}</h1>
      <div class="doc-hero-body">
        {lead && <p class="doc-hero-lead">{lead}</p>}
        <aside class="doc-hero-meta" aria-label="Sobre esta página">
          <dl>
            {activeGroup && <div><dt>Sección</dt><dd>{activeGroup.title}</dd></div>}
            {activeGroup && <div><dt>Página</dt><dd>{pageIndex} / {activeGroup.items.length}</dd></div>}
            {prev && <div><dt>Anterior</dt><dd><a href={prev.href}>{prev.label}</a></dd></div>}
            {next && <div><dt>Siguiente</dt><dd><a href={next.href}>{next.label}</a></dd></div>}
          </dl>
          <nav class="doc-toc" id="docToc" aria-label="En esta página" hidden>
            <p class="doc-toc-label">En esta página</p>
            <ol></ol>
          </nav>
        </aside>
      </div>
    </header>

    <!-- Page content -->
    <slot />

    <!-- Prev / Next -->
    <nav class="doc-prevnext" data-dg-no-reveal aria-label="Página anterior y siguiente">
      {prev
        ? <a href={prev.href} aria-label={`Anterior: ${prev.label}`}><span class="doc-prevnext-dir">← Anterior</span><span class="name">{prev.label}</span></a>
        : <span></span>
      }
      {next &&
        <a href={next.href} class="next" aria-label={`Siguiente: ${next.label}`}><span class="doc-prevnext-dir">Siguiente →</span><span class="name">{next.label}</span></a>
      }
    </nav>
  </main>
</div>

<!-- "En esta página": built from the numbered section headings of the page. -->
<script is:inline>
  (() => {
    const toc = document.getElementById('docToc');
    const subs = [...document.querySelectorAll('.doc-main > .doc-sub, .doc-main > section > .doc-sub')];
    if (!toc || subs.length < 2) return;
    const list = toc.querySelector('ol');
    const used = new Set();
    subs.forEach((sub, index) => {
      if (!sub.id) {
        let id = sub.textContent.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'seccion';
        while (used.has(id) || document.getElementById(id)) id += '-' + (index + 1);
        sub.id = id;
      }
      used.add(sub.id);
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = '#' + sub.id;
      link.textContent = sub.textContent.trim();
      item.append(link);
      list.append(item);
    });
    toc.hidden = false;
  })();
</script>
<script src={jsHref} is:inline></script>
<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('#docMenuToggle')!;
  const sidebar = document.getElementById('docSidebar')!;
  const menuBackdrop = document.getElementById('docMenuBackdrop')!;
  const mobileMenu = window.matchMedia('(max-width: 860px)');
  const sidebarScrollKey = 'dgarz-docs-sidebar-scroll';
  function saveSidebarScroll() {
    // Ignore sidebar layouts that have no scrollable height.
    if (!sidebar.clientHeight) return;
    try { sessionStorage.setItem(sidebarScrollKey, String(sidebar.scrollTop)); } catch { /* Storage may be unavailable. */ }
  }
  function restoreSidebarScroll() {
    if (!sidebar.clientHeight) return;
    try {
      const stored = sessionStorage.getItem(sidebarScrollKey);
      if (stored === null) return;
      const top = Number(stored);
      if (Number.isFinite(top) && top >= 0) sidebar.scrollTop = top;
    } catch { /* Navigation still works without storage. */ }
  }
  sidebar.addEventListener('scroll', saveSidebarScroll, { passive: true });
  window.addEventListener('pagehide', saveSidebarScroll);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) restoreSidebarScroll();
  });
  function setMenu(open: boolean) {
    if (!open) saveSidebarScroll();
    if (!open && sidebar.contains(document.activeElement)) menuToggle.focus({ preventScroll: true });
    sidebar.inert = mobileMenu.matches && !open;
    document.querySelector<HTMLElement>('.doc-main')!.inert = mobileMenu.matches && open;
    sidebar.classList.toggle('is-open', open);
    document.body.classList.toggle('doc-menu-open', open);
    menuBackdrop.setAttribute('aria-hidden', String(!open));
    menuBackdrop.inert = !open;
    if (open) restoreSidebarScroll();
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Cerrar índice de documentación' : 'Abrir índice de documentación');
  }
  menuToggle.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
  menuBackdrop.addEventListener('click', () => setMenu(false));
  sidebar.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a');
    if (!link || !mobileMenu.matches) return;
    const animateNavigation = !event.defaultPrevented && event.button === 0 &&
      !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey &&
      (!link.target || link.target === '_self') && !link.hasAttribute('download') &&
      link.origin === window.location.origin &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (animateNavigation) {
      event.preventDefault();
      // Let the closing slide finish before loading the selected page.
      window.setTimeout(() => window.location.assign(link.href), 1000);
    }
    setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuToggle.focus();
    }
  });
  mobileMenu.addEventListener('change', () => setMenu(false));

  const VOID_TAGS = new Set([
    'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',
    'link', 'meta', 'param', 'source', 'track', 'wbr'
  ]);

  function serializeDemoNode(node, depth = 0) {
    if (node.nodeType === Node.TEXT_NODE) {
      const text = node.textContent?.replace(/\s+/g, ' ').trim();
      return text ? `${'  '.repeat(depth)}${text}` : '';
    }

    if (node.nodeType !== Node.ELEMENT_NODE) {
      return '';
    }

    const el = node as HTMLElement;
    if (el.hasAttribute('hidden')) {
      return '';
    }

    const indent = '  '.repeat(depth);
    const tag = el.tagName.toLowerCase();
    const attrs = el
      .getAttributeNames()
      .map((name) => {
        const value = el.getAttribute(name);
        return value === '' ? name : `${name}="${value}"`;
      })
      .join(' ');
    const openTag = attrs ? `<${tag} ${attrs}>` : `<${tag}>`;

    if (VOID_TAGS.has(tag)) {
      return `${indent}${openTag.slice(0, -1)} />`;
    }

    const children = Array.from(el.childNodes)
      .map((child) => serializeDemoNode(child, depth + 1))
      .filter(Boolean);

    if (!children.length) {
      return `${indent}${openTag}</${tag}>`;
    }

    if (children.length === 1 && !children[0].includes('\n')) {
      const child = children[0].trim();
      return `${indent}${openTag}${child}</${tag}>`;
    }

    return `${indent}${openTag}\n${children.join('\n')}\n${indent}</${tag}>`;
  }

  function syncExampleCodeBlocks() {
    document.querySelectorAll<HTMLElement>('.doc-demo + .doc-code').forEach((codeBlock) => {
      if (codeBlock.dataset.codeSource === 'manual') return;

      const demo = codeBlock.previousElementSibling as HTMLElement | null;
      const pre = codeBlock.querySelector('pre');
      if (!demo || !pre) return;

      const markup = Array.from(demo.childNodes)
        .map((node) => serializeDemoNode(node, 0))
        .filter(Boolean)
        .join('\n\n');

      if (markup && !pre.textContent.trim()) {
        pre.textContent = markup;
      }
    });
  }

  syncExampleCodeBlocks();

  // Copy buttons. navigator.clipboard only exists on secure origins (HTTPS or
  // localhost); opened from a phone over the LAN (http://192.168.x.x) it is
  // undefined, so fall back to a temporary textarea + execCommand('copy'),
  // which works on iOS Safari inside the click gesture.
  function copyWithTextarea(text: string): boolean {
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;font-size:16px;';
    document.body.appendChild(area);
    area.focus();
    area.setSelectionRange(0, text.length);
    let ok = false;
    try { ok = document.execCommand('copy'); } catch { ok = false; }
    area.remove();
    return ok;
  }
  async function copyText(text: string): Promise<boolean> {
    if (window.isSecureContext && navigator.clipboard?.writeText) {
      try { await navigator.clipboard.writeText(text); return true; } catch { /* fall back below */ }
    }
    return copyWithTextarea(text);
  }
  document.querySelectorAll<HTMLButtonElement>('.cp').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const pre = btn.closest('.doc-code')?.querySelector('pre');
      const ok = await copyText(pre?.textContent ?? '');
      btn.textContent = ok ? '✓ Copiado' : 'No se pudo copiar';
      btn.classList.toggle('is-copied', ok);
      setTimeout(() => {
        btn.textContent = 'Copiar';
        btn.classList.remove('is-copied');
      }, 1800);
    });
  });
</script>

<script>
  import Prism from 'prismjs';
  import 'prismjs/components/prism-markup';
  import 'prismjs/components/prism-css';
  import 'prismjs/components/prism-javascript';
  import 'prismjs/components/prism-bash';

  document.querySelectorAll<HTMLPreElement>('.doc-code pre').forEach((pre) => {
    if (pre.querySelector('code')) return;
    const lang = pre.closest('.doc-code')?.getAttribute('data-lang') ?? 'html';
    const code = document.createElement('code');
    code.className = `language-${lang}`;
    code.innerHTML = pre.innerHTML;
    pre.innerHTML = '';
    pre.appendChild(code);
  });

  Prism.highlightAll();
</script>
</body>
</html>
