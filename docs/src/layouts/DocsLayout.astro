---
import { NAV, TOP_NAV, getPrevNext, type NavItem } from "../data/nav";
import SiteHeader from "../components/SiteHeader.astro";
import iconSpriteRaw from "../../../core/src/icons/dgarz-icons.svg?raw";
import "../styles/doc-patterns.css";
import "../styles/brand.css";

interface Props {
  title: string;
  lead?: string;
  currentHref: string;
}

const { title, lead, currentHref } = Astro.props;
const { prev, next } = getPrevNext(currentHref);

// Sprite único: se incrusta el del core para que docs y framework nunca se desincronicen
const iconSprite = iconSpriteRaw
  .replace(/<\?xml[^>]*\?>/, "")
  .replace("<svg ", '<svg aria-hidden="true" ');

const activeGroup = NAV.find((g) => g.items.some((i) => i.href === currentHref));

// Cambiar a CDN después de publicar a npm:
// const CDN = `https://cdn.jsdelivr.net/npm/dgarz-design@1.0.0/dist`;
// const cssHref = `${CDN}/dgarz.full.min.css`;
// const jsHref  = `${CDN}/dgarz.min.js`;
const cssHref = import.meta.env.DEV ? "/__core/dgarz.full.css" : "/dist/dgarz.full.min.css";
const jsHref  = import.meta.env.DEV ? "/__core/dgarz.js" : "/dist/dgarz.js";
---

<!doctype html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" id="docThemeColor" />
  <title>{title} — dgarz design</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://api.fontshare.com/v2/css?f[]=gambetta@400,401,500,501,600,601&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={cssHref} />
  <style is:global>
    /* Header (60px) + aire. */
    html { scroll-behavior: smooth; scroll-padding-top: 76px; }
    :root {
      --doc-page-bg: #ffffff;
      --doc-panel-bg: #fff;
    }
    [data-theme="dark"] {
      --doc-page-bg: var(--dg-paper);
      --doc-panel-bg: var(--dg-surface);
    }
    body { --doc-header-offset: 60px; overflow-x: hidden; padding-top: 60px; background: var(--doc-page-bg); }
    body:has(.pub-nav.is-hidden) { --doc-header-offset: 0px; }

    /* Flat presentation across the entire docs site, including live examples.
       Top menu bars keep their elevation, same as the framework's flat reset. */
    *:not([class*="dg-shadow-"], .dg-navbar, .dg-app-header, .dg-dock), *::before, *:not(.dg-switch-track)::after {
      box-shadow: none !important;
      text-shadow: none !important;
    }
    :focus-visible {
      outline: 2px solid var(--dg-accent) !important;
      outline-offset: 3px;
    }

    /* ---- shell ---- */
    .doc-shell {
      display: grid;
      grid-template-columns: 248px 1fr;
      max-width: 1320px;
      margin-inline: auto;
    }
    @media (max-width: 860px) {
      .doc-shell { grid-template-columns: 1fr; }
    }

    /* ---- sidebar ---- */
    .doc-sidebar {
      position: sticky; top: var(--doc-header-offset); align-self: start;
      height: calc(100vh - var(--doc-header-offset)); overflow-y: auto;
      transition: top var(--dg-dur-motion) var(--dg-ease-motion), height var(--dg-dur-motion) var(--dg-ease-motion);
      scroll-behavior: auto; overflow-anchor: none;
      background: var(--doc-panel-bg);
      padding: var(--dg-space-6) var(--dg-space-4) var(--dg-space-8) var(--dg-space-5);
      border-right: 1px solid color-mix(in oklab, var(--dg-border) 55%, transparent);
    }
    .doc-nav-label {
      display: flex; align-items: center; gap: 7px;
      font-size: var(--dg-text-xs); text-transform: uppercase;
      letter-spacing: 0.12em; color: var(--dg-text-faint);
      margin: var(--dg-space-6) 0 var(--dg-space-2);
      font-family: var(--dg-font-sans); font-weight: var(--dg-weight-semi);
    }
    .doc-nav-label:first-child { margin-top: 0; }
    .doc-nav-label .dot {
      width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
    }
    .doc-nav-dot-comenzar { background: #6366f1; }
    .doc-nav-dot-fundamentos { background: #ec4899; }
    .doc-nav-dot-formularios { background: #3b82f6; }
    .doc-nav-dot-componentes { background: #06b6d4; }
    .doc-nav-dot-utilidades { background: #f59e0b; }
    .doc-nav-dot-app-pack { background: #22c55e; }
    .doc-nav-dot-studio { background: #ef4444; }
    .doc-nav a {
      display: block; padding: 0.4em 0.7em;
      border-radius: var(--dg-radius); font-size: var(--dg-text-sm);
      color: var(--dg-text-muted);
      transition: color var(--dg-dur) var(--dg-ease), background var(--dg-dur) var(--dg-ease);
      text-decoration: none;
    }
    .doc-nav a:hover { color: var(--dg-text); background: var(--dg-surface-2); }
    .doc-nav a.is-active {
      color: var(--dg-text); background: var(--dg-surface-3);
      font-weight: var(--dg-weight-medium);
    }

    /* ---- main ---- */
    .doc-main { padding: 0 var(--dg-space-7) calc(140px + env(safe-area-inset-bottom, 0px)); min-width: 0; }

    /* ---- hero ---- */
    .doc-hero {
      display: flex; flex-direction: column; align-items: flex-start;
      padding-top: var(--dg-space-6); padding-bottom: var(--dg-space-6);
      border-bottom: 1px solid var(--dg-border); margin-bottom: var(--dg-space-7);
    }
    .doc-hero-tag {
      display: inline-flex; align-items: center;
      margin: 0;
      padding: 0.4em 0.75em;
      font-size: var(--dg-text-sm);
      font-weight: var(--dg-weight-semi);
      letter-spacing: 0.01em;
      line-height: 1.2;
      color: var(--dg-text);
      background: var(--doc-panel-bg);
      border: 1px solid var(--dg-border);
      border-radius: var(--dg-radius-sm);
    }
    .doc-hero-title {
      font-family: var(--dg-font-serif);
      font-size: var(--dg-text-4xl);
      font-weight: var(--dg-weight-normal);
      letter-spacing: -0.02em;
      line-height: 1.1;
      color: var(--dg-text);
      text-wrap: balance;
      /* 6px: entre space-2 (flojo) y el -6px (pegado). */
      margin: 6px 0 var(--dg-space-3);
    }
    .doc-hero > p { margin-top: 0; }
    .doc-hero p { color: var(--dg-text-muted); max-width: 60ch; line-height: var(--dg-leading-normal); }

    /* ---- page text entrance ---- */
    .doc-hero-tag, .doc-hero-title, .doc-hero p { animation: dg-text-in var(--dg-dur-motion) var(--dg-ease-motion) backwards; }
    .doc-hero-title { animation-delay: 40ms; }
    .doc-hero p { animation-delay: 80ms; }
    @media (prefers-reduced-motion: reduce) {
      .doc-hero-tag, .doc-hero-title, .doc-hero p { animation: none; }
    }

    /* ---- section labels ---- */
    .doc-sub {
      font-size: 1.4rem; font-weight: var(--dg-weight-semi); line-height: 1.3;
      letter-spacing: -0.015em; text-wrap: balance;
      color: var(--dg-text); margin: 40px 0 12px;
    }

    .doc-subsection {
      font-size: 1.4rem; font-weight: var(--dg-weight-semi); line-height: 1.4;
      color: var(--dg-text); margin: 28px 0 8px; text-wrap: balance;
    }
    .doc-main > p, .doc-main > section > p {
      max-width: 72ch; margin-bottom: 16px;
      color: var(--dg-text-muted); line-height: 1.65;
    }
    .doc-main > .doc-sub:first-child { margin-top: 0; }
    .doc-main > :is(.doc-sub, .doc-subsection) + .doc-example { margin-top: 12px; }
    .doc-structure { list-style: decimal; margin: 0; padding-left: 1.25rem; max-width: 72ch; color: var(--dg-text-muted); line-height: 1.7; }
    .doc-structure li + li { margin-top: 8px; }

    /* One shared surface: live example above, copyable source below.
       Outline survives the flat border reset (border: none !important). */
    .doc-example {
      margin-block: var(--dg-space-5);
      border-radius: var(--dg-radius-lg);
      overflow: hidden;
      background: var(--doc-panel-bg);
      outline: 1px solid color-mix(in oklab, var(--dg-text) 14%, transparent);
    }
    .doc-example > .doc-demo { margin: 0; border-radius: 0; outline: none; }
    .doc-example > .doc-code { margin: 0; border-radius: 0; outline: none; }

    /* ---- demo block ---- */
    .doc-demo {
      border-radius: var(--dg-radius-lg);
      padding: var(--dg-space-6);
      background: var(--doc-panel-bg);
      outline: 1px solid color-mix(in oklab, var(--dg-text) 14%, transparent);
    }
    .doc-demo.is-plain { background-image: none; }
    /* Glass demos: colorful, detailed stand-in for a photo so the blur is visible. */
    .doc-demo.glass-stage {
      padding: 3rem 1.5rem;
      background:
        repeating-linear-gradient(115deg, rgb(255 255 255 / .22) 0 6px, transparent 6px 22px),
        radial-gradient(circle at 18% 30%, #ff7a1a 0, transparent 34%),
        radial-gradient(circle at 78% 22%, #8e7dff 0, transparent 36%),
        radial-gradient(circle at 60% 90%, #22c55e 0, transparent 38%),
        linear-gradient(135deg, #0f1a2e, #247cff);
    }
    .doc-demo:has(+ .doc-code) { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .doc-demo + .doc-code { margin-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; }

    /* ---- code block — window style, follows the theme ----
       Light by default (soft gray surface, dark text, light syntax palette);
       the previous dark terminal palette applies in dark mode. */
    .doc-code {
      --code-bg: #f6f6f7;
      --code-bar: #ececee;
      --code-bar-line: #dcdce0;
      --code-fg: #24292f;
      --code-muted: #8c8c94;
      --code-btn-bg: #e2e2e6;
      --code-btn-fg: #57606a;
      --code-btn-hover-bg: #d4d4d8;
      --code-btn-hover-fg: #24292f;
      --code-scroll: #c8c8ce;
      --tk-comment: #5f6872; /* 5.2:1 on #f6f6f7 (was 4.2) */ --tk-tag: #116329; --tk-punct: #57606a; --tk-attr: #0550ae;
      --tk-string: #0a3069; --tk-keyword: #cf222e; --tk-selector: #953800; --tk-property: #0550ae;
      --tk-number: #0550ae; --tk-function: #8250df;
      position: relative;
      background: var(--code-bg);
      color: var(--code-fg);
      border-radius: var(--dg-radius-lg);
      margin: var(--dg-space-5) 0;
      font-size: var(--dg-text-xs);
      overflow: hidden;
      box-shadow: none;
      /* Standalone blocks get the same edge as .doc-example (light blocks would
         otherwise blend into the page); outline survives the flat border reset. */
      outline: 1px solid color-mix(in oklab, var(--dg-text) 14%, transparent);
    }
    [data-theme="dark"] .doc-code {
      --code-bg: #0d1117;
      --code-bar: #161b22;
      --code-bar-line: #21262d;
      --code-fg: #e4e4e7;
      --code-muted: #484f58;
      --code-btn-bg: #21262d;
      --code-btn-fg: #8b949e;
      --code-btn-hover-bg: #30363d;
      --code-btn-hover-fg: #e6edf3;
      --code-scroll: #30363d;
      --tk-comment: #848d97; /* 5.6:1 on #0d1117 (was 4.1) */ --tk-tag: #7dd3fc; --tk-punct: #7dd3fc; --tk-attr: #7ee787;
      --tk-string: #a5d6ff; --tk-keyword: #ff7b72; --tk-selector: #ffa657; --tk-property: #79c0ff;
      --tk-number: #f2cc60; --tk-function: #d2a8ff;
    }
    /* macOS chrome bar */
    .doc-code::before {
      content: '';
      display: block;
      height: 40px;
      background-color: var(--code-bar);
      background-image:
        radial-gradient(circle, #ff5f57 5.5px, transparent 5.5px),
        radial-gradient(circle, #febc2e 5.5px, transparent 5.5px),
        radial-gradient(circle, #28c840 5.5px, transparent 5.5px);
      background-size: 11px 11px, 11px 11px, 11px 11px;
      background-position: 14px center, 30px center, 46px center;
      background-repeat: no-repeat;
      border-bottom: 1px solid var(--code-bar-line);
      flex-shrink: 0;
    }
    /* language label centered in bar */
    .doc-code[data-lang]::after {
      content: attr(data-lang);
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--dg-font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      color: var(--code-muted);
      pointer-events: none;
    }
    .doc-modal-size-tabs { max-width: 100%; overflow-x: auto; flex-wrap: nowrap; }
    .doc-modal-size-tabs button { flex-shrink: 0; white-space: nowrap; }
    .doc-code pre {
      padding: var(--dg-space-5);
      margin: 0;
      white-space: pre;
      overflow-x: auto;
      line-height: 1.7;
      font-family: var(--dg-font-mono);
      scrollbar-width: thin;
      scrollbar-color: var(--code-scroll) transparent;
    }
    .doc-code pre::-webkit-scrollbar { height: 5px; }
    .doc-code pre::-webkit-scrollbar-thumb { background: var(--code-scroll); border-radius: 4px; }
    /* copy button — inside chrome bar */
    .doc-code .cp {
      position: absolute;
      top: 8px; right: 12px;
      height: 24px;
      display: inline-flex; align-items: center; gap: 5px;
      background: var(--code-btn-bg);
      border: 0;
      color: var(--code-btn-fg);
      border-radius: var(--dg-radius-sm);
      padding: 0 0.65em;
      font-size: 0.68rem;
      letter-spacing: 0.03em;
      cursor: pointer;
      transition: background .15s, color .15s;
    }
    .doc-code .cp:hover {
      background: var(--code-btn-hover-bg);
      color: var(--code-btn-hover-fg);
    }
    .doc-code .cp.is-copied {
      background: var(--dg-success-subtle);
      color: var(--dg-on-success-subtle);
    }
    /* ---- Prism token colors (theme-aware via --tk-*) ---- */
    .token.comment, .token.prolog, .token.doctype, .token.cdata { color: var(--tk-comment); font-style: italic; }
    .token.tag, .token.punctuation { color: var(--tk-punct); }
    .token.tag .token.tag { color: var(--tk-tag); }
    .token.attr-name { color: var(--tk-attr); }
    .token.attr-value, .token.string { color: var(--tk-string); }
    .token.keyword, .token.boolean, .token.important { color: var(--tk-keyword); }
    .token.selector, .token.class, .token.builtin { color: var(--tk-selector); }
    .token.property { color: var(--tk-property); }
    .token.number { color: var(--tk-number); }
    .token.function { color: var(--tk-function); }
    .token.operator { color: var(--tk-keyword); }
    .token.unit, .token.pseudo-class, .token.pseudo-element { color: var(--tk-selector); }
    .token.atrule { color: var(--tk-selector); }
    .token.url { color: var(--tk-string); text-decoration: underline; }

    /* ---- prev/next ---- */
    .doc-prevnext {
      position: fixed;
      left: calc(50% + 124px);
      bottom: calc(var(--dg-space-4) + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
      z-index: 24;
      display: flex; align-items: center; justify-content: center; gap: 4px;
      width: max-content;
      max-width: calc(min(100vw, 1320px) - 248px - 2 * var(--dg-space-7));
      padding: 4px;
      border-radius: 22px;
      background: color-mix(in oklab, var(--dg-surface-3) 55%, transparent);
      -webkit-backdrop-filter: saturate(1.8) blur(20px);
      backdrop-filter: saturate(1.8) blur(20px);
    }
    .doc-prevnext a {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 6px 12px; min-height: 44px;
      border: 0; border-radius: 18px;
      background: transparent;
      min-width: 0; flex: 1 1 auto;
      text-decoration: none; color: var(--dg-text);
      transition: background var(--dg-dur) var(--dg-ease);
    }
    .doc-prevnext a:hover { background: color-mix(in oklab, var(--dg-text) 8%, transparent); }
    .doc-prevnext .dg-icon { width: 16px; height: 16px; flex-shrink: 0; }
    .doc-prevnext .name { font-size: var(--dg-text-sm); line-height: 1.25; font-weight: var(--dg-weight-medium); white-space: normal; overflow-wrap: anywhere; min-width: 0; }
    .doc-prevnext a.next { text-align: right; }

    /* ---- theme toggle ---- */
    .doc-theme-btn {
      width: 36px; height: 36px; border-radius: var(--dg-radius-pill);
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--dg-text-muted); background: none; border: none; cursor: pointer;
      transition: background var(--dg-dur) var(--dg-ease), color var(--dg-dur) var(--dg-ease);
    }
    .doc-theme-btn:hover { background: var(--dg-surface-2); color: var(--dg-text); }
    .doc-icon-hidden { display: none; }

    .doc-mobile-links { display: none; }
    .doc-menu-backdrop { display: none; }
    @media (max-width: 860px) {
      .doc-main { padding-inline: var(--dg-space-4); }
      .doc-prevnext { left: 50%; max-width: calc(100% - 2 * var(--dg-space-4)); }
      .doc-mobile-links { display: block; margin-bottom: var(--dg-space-5); }
      .doc-sidebar {
        display: block;
        position: fixed;
        /* Float below the top bar with a gap; rounded panel, not flush.
           Extra top inset clears the curved pub-nav bottom radius. */
        --doc-menu-gap: var(--dg-space-5);
        top: calc(60px + var(--doc-menu-gap));
        right: var(--doc-menu-gap);
        bottom: var(--doc-menu-gap);
        left: var(--doc-menu-gap);
        z-index: 25;
        height: calc(100dvh - 60px - 2 * var(--doc-menu-gap));
        max-height: calc(100dvh - 60px - 2 * var(--doc-menu-gap));
        padding: var(--dg-space-5) var(--dg-space-4);
        border-radius: var(--dg-radius-xl);
        border-right: none;
        overscroll-behavior: contain;
        visibility: hidden;
        pointer-events: none;
        transform: translateX(calc(-100% - var(--doc-menu-gap)));
        transition: transform var(--dg-dur-motion) var(--dg-ease-motion), visibility 0s var(--dg-dur-motion);
      }
      .doc-sidebar.is-open {
        visibility: visible;
        pointer-events: auto;
        transform: translateX(0);
        transition-delay: 0s;
      }
      .doc-sidebar.is-open :is(.doc-nav-label, a) { animation: dg-text-in var(--dg-dur-motion) var(--dg-ease-motion) 80ms backwards; }
      .doc-sidebar .doc-nav-label { justify-content: center; }
      .doc-sidebar .doc-nav a { text-align: center; }
      .doc-menu-backdrop {
        display: block;
        position: fixed; inset: 0; z-index: 24;
        border: 0; padding: 0; cursor: pointer;
        background: transparent;
        -webkit-backdrop-filter: blur(0);
        backdrop-filter: blur(0);
        visibility: hidden;
        pointer-events: none;
        transition:
          background var(--dg-dur-motion) var(--dg-ease-motion),
          backdrop-filter var(--dg-dur-motion) var(--dg-ease-motion),
          -webkit-backdrop-filter var(--dg-dur-motion) var(--dg-ease-motion),
          visibility 0s var(--dg-dur-motion);
      }
      body.doc-menu-open {
        overflow: hidden;
      }
      body.doc-menu-open .doc-menu-backdrop {
        background: color-mix(in oklab, var(--dg-950) 32%, transparent);
        -webkit-backdrop-filter: saturate(1.2) blur(8px);
        backdrop-filter: saturate(1.2) blur(8px);
        visibility: visible;
        pointer-events: auto;
        transition-delay: 0s;
      }
      .doc-demo { padding: var(--dg-space-4); }
    }

    @media (prefers-reduced-motion: reduce) {
      .doc-sidebar, .doc-menu-backdrop { transition: none; }
    }
    @media (max-width: 860px) and (prefers-reduced-motion: reduce) {
      .doc-sidebar { transition: none; transform: none; }
      .doc-sidebar.is-open :is(.doc-nav-label, a) { animation: none; }
    }

    /* ---- color page: neutral chips ---- */
    .doc-color-0   { background: var(--dg-0); }
    .doc-color-50  { background: var(--dg-50); }
    .doc-color-100 { background: var(--dg-100); }
    .doc-color-200 { background: var(--dg-200); }
    .doc-color-300 { background: var(--dg-300); }
    .doc-color-400 { background: var(--dg-400); }
    .doc-color-500 { background: var(--dg-500); }
    .doc-color-600 { background: var(--dg-600); }
    .doc-color-700 { background: var(--dg-700); }
    .doc-color-800 { background: var(--dg-800); }
    .doc-color-900 { background: var(--dg-900); }
    .doc-color-950 { background: var(--dg-950); }

  </style>
</head>
<body>

<!-- SVG sprite -->
<Fragment set:html={iconSprite} />

<SiteHeader currentHref={currentHref} hideOnScroll showMainMenu={false}>
    <button slot="actions" class="pub-theme-btn doc-menu-btn" id="docMenuToggle" aria-label="Abrir índice de documentación" aria-expanded="false" aria-controls="docSidebar">
      <svg class="dg-icon pub-icon-open" viewBox="3 3 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path id="docMenuIcon" d="M4 9h16M4 15h16" /></svg>
      <svg class="dg-icon pub-icon-close" viewBox="3 3 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20" /></svg>
    </button>
</SiteHeader>

<button type="button" class="doc-menu-backdrop" id="docMenuBackdrop" aria-label="Cerrar menú" tabindex="-1" aria-hidden="true"></button>
<div class="doc-shell">
  <!-- Sidebar -->
  <aside class="doc-sidebar dg-scroll" id="docSidebar" aria-label="Navegación de documentación">
    <div class="doc-mobile-links">
      <div class="doc-nav-label">Navegación</div>
      <nav class="doc-nav" aria-label="Navegación principal móvil">
        {TOP_NAV.map((item) => (
          <a href={item.href} aria-current={currentHref === item.href ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
    {NAV.map((group) => (
      <div>
        <div class="doc-nav-label">
          <span class={`dot doc-nav-dot-${group.title.toLowerCase().replace(/\s+/g, "-")}`}></span>
          {group.title}
        </div>
        <nav class="doc-nav">
          {group.items.map((item) => (
            <a
              href={item.href}
              class={item.href === currentHref ? "is-active" : ""}
              target={item.href.endsWith('.html') ? "_blank" : undefined}
              rel={item.href.endsWith('.html') ? "noopener" : undefined}
            >
              {item.label}{item.href.endsWith('.html') ? ' ↗' : ''}
            </a>
          ))}
        </nav>
      </div>
    ))}
  </aside>
  <!-- Run while parsing, before the content and deferred modules can paint the menu at the top. -->
  <script is:inline>
    (() => {
      const sidebar = document.getElementById('docSidebar');
      if (!sidebar) return;
      sidebar.inert = window.matchMedia('(max-width: 860px)').matches;
      if (!sidebar.clientHeight) return;
      try {
        const stored = sessionStorage.getItem('dgarz-docs-sidebar-scroll');
        if (stored === null) return;
        const top = Number(stored);
        if (Number.isFinite(top) && top >= 0) sidebar.scrollTop = top;
      } catch { /* Keep the menu visible when storage is unavailable. */ }
    })();
  </script>

  <!-- Main -->
  <main class="doc-main" data-dg-reveal-children>
    <!-- Hero -->
    <div class="doc-hero" data-dg-no-reveal>
      {activeGroup && <span class="doc-hero-tag">{activeGroup.title}</span>}
      <h1 class="doc-hero-title">{title}</h1>
      {lead && <p>{lead}</p>}
    </div>

    <!-- Page content -->
    <slot />

    <!-- Prev / Next -->
    <nav class="doc-prevnext" data-dg-no-reveal aria-label="Página anterior y siguiente">
      {prev
        ? <a href={prev.href} title={prev.label} aria-label={`Anterior: ${prev.label}`}><svg class="dg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7" /></svg><span class="name">{prev.label}</span></a>
        : null
      }
      {next &&
        <a href={next.href} class="next" title={next.label} aria-label={`Siguiente: ${next.label}`}><span class="name">{next.label}</span><svg class="dg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" /></svg></a>
      }
    </nav>
  </main>
</div>

<script src={jsHref} is:inline></script>
<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('#docMenuToggle')!;
  const sidebar = document.getElementById('docSidebar')!;
  const menuBackdrop = document.getElementById('docMenuBackdrop')!;
  const mobileMenu = window.matchMedia('(max-width: 860px)');
  const sidebarScrollKey = 'dgarz-docs-sidebar-scroll';
  function saveSidebarScroll() {
    // Ignore sidebar layouts that have no scrollable height.
    if (!sidebar.clientHeight) return;
    try { sessionStorage.setItem(sidebarScrollKey, String(sidebar.scrollTop)); } catch { /* Storage may be unavailable. */ }
  }
  function restoreSidebarScroll() {
    if (!sidebar.clientHeight) return;
    try {
      const stored = sessionStorage.getItem(sidebarScrollKey);
      if (stored === null) return;
      const top = Number(stored);
      if (Number.isFinite(top) && top >= 0) sidebar.scrollTop = top;
    } catch { /* Navigation still works without storage. */ }
  }
  sidebar.addEventListener('scroll', saveSidebarScroll, { passive: true });
  window.addEventListener('pagehide', saveSidebarScroll);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) restoreSidebarScroll();
  });
  function setMenu(open: boolean) {
    if (!open) saveSidebarScroll();
    if (!open && sidebar.contains(document.activeElement)) menuToggle.focus({ preventScroll: true });
    sidebar.inert = mobileMenu.matches && !open;
    document.querySelector<HTMLElement>('.doc-main')!.inert = mobileMenu.matches && open;
    sidebar.classList.toggle('is-open', open);
    document.body.classList.toggle('doc-menu-open', open);
    menuBackdrop.setAttribute('aria-hidden', String(!open));
    menuBackdrop.inert = !open;
    if (open) restoreSidebarScroll();
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Cerrar índice de documentación' : 'Abrir índice de documentación');
  }
  menuToggle.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
  menuBackdrop.addEventListener('click', () => setMenu(false));
  sidebar.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a');
    if (!link || !mobileMenu.matches) return;
    const animateNavigation = !event.defaultPrevented && event.button === 0 &&
      !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey &&
      (!link.target || link.target === '_self') && !link.hasAttribute('download') &&
      link.origin === window.location.origin &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (animateNavigation) {
      event.preventDefault();
      // Let the closing slide finish before loading the selected page.
      window.setTimeout(() => window.location.assign(link.href), 1000);
    }
    setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuToggle.focus();
    }
  });
  mobileMenu.addEventListener('change', () => setMenu(false));

  const VOID_TAGS = new Set([
    'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',
    'link', 'meta', 'param', 'source', 'track', 'wbr'
  ]);

  function serializeDemoNode(node, depth = 0) {
    if (node.nodeType === Node.TEXT_NODE) {
      const text = node.textContent?.replace(/\s+/g, ' ').trim();
      return text ? `${'  '.repeat(depth)}${text}` : '';
    }

    if (node.nodeType !== Node.ELEMENT_NODE) {
      return '';
    }

    const el = node as HTMLElement;
    if (el.hasAttribute('hidden')) {
      return '';
    }

    const indent = '  '.repeat(depth);
    const tag = el.tagName.toLowerCase();
    const attrs = el
      .getAttributeNames()
      .map((name) => {
        const value = el.getAttribute(name);
        return value === '' ? name : `${name}="${value}"`;
      })
      .join(' ');
    const openTag = attrs ? `<${tag} ${attrs}>` : `<${tag}>`;

    if (VOID_TAGS.has(tag)) {
      return `${indent}${openTag.slice(0, -1)} />`;
    }

    const children = Array.from(el.childNodes)
      .map((child) => serializeDemoNode(child, depth + 1))
      .filter(Boolean);

    if (!children.length) {
      return `${indent}${openTag}</${tag}>`;
    }

    if (children.length === 1 && !children[0].includes('\n')) {
      const child = children[0].trim();
      return `${indent}${openTag}${child}</${tag}>`;
    }

    return `${indent}${openTag}\n${children.join('\n')}\n${indent}</${tag}>`;
  }

  function syncExampleCodeBlocks() {
    document.querySelectorAll<HTMLElement>('.doc-demo + .doc-code').forEach((codeBlock) => {
      if (codeBlock.dataset.codeSource === 'manual') return;

      const demo = codeBlock.previousElementSibling as HTMLElement | null;
      const pre = codeBlock.querySelector('pre');
      if (!demo || !pre) return;

      const markup = Array.from(demo.childNodes)
        .map((node) => serializeDemoNode(node, 0))
        .filter(Boolean)
        .join('\n\n');

      if (markup && !pre.textContent.trim()) {
        pre.textContent = markup;
      }
    });
  }

  syncExampleCodeBlocks();

  // Copy buttons. navigator.clipboard only exists on secure origins (HTTPS or
  // localhost); opened from a phone over the LAN (http://192.168.x.x) it is
  // undefined, so fall back to a temporary textarea + execCommand('copy'),
  // which works on iOS Safari inside the click gesture.
  function copyWithTextarea(text: string): boolean {
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;font-size:16px;';
    document.body.appendChild(area);
    area.focus();
    area.setSelectionRange(0, text.length);
    let ok = false;
    try { ok = document.execCommand('copy'); } catch { ok = false; }
    area.remove();
    return ok;
  }
  async function copyText(text: string): Promise<boolean> {
    if (window.isSecureContext && navigator.clipboard?.writeText) {
      try { await navigator.clipboard.writeText(text); return true; } catch { /* fall back below */ }
    }
    return copyWithTextarea(text);
  }
  document.querySelectorAll<HTMLButtonElement>('.cp').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const pre = btn.closest('.doc-code')?.querySelector('pre');
      const ok = await copyText(pre?.textContent ?? '');
      btn.textContent = ok ? '✓ Copiado' : 'No se pudo copiar';
      btn.classList.toggle('is-copied', ok);
      setTimeout(() => {
        btn.textContent = 'Copiar';
        btn.classList.remove('is-copied');
      }, 1800);
    });
  });
</script>

<script>
  import Prism from 'prismjs';
  import 'prismjs/components/prism-markup';
  import 'prismjs/components/prism-css';
  import 'prismjs/components/prism-javascript';
  import 'prismjs/components/prism-bash';

  document.querySelectorAll<HTMLPreElement>('.doc-code pre').forEach((pre) => {
    if (pre.querySelector('code')) return;
    const lang = pre.closest('.doc-code')?.getAttribute('data-lang') ?? 'html';
    const code = document.createElement('code');
    code.className = `language-${lang}`;
    code.innerHTML = pre.innerHTML;
    pre.innerHTML = '';
    pre.appendChild(code);
  });

  Prism.highlightAll();
</script>
</body>
</html>
