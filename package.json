{
  "name": "dgarz-design-monorepo",
  "private": true,
  "workspaces": [
    "core",
    "docs"
  ],
  "scripts": {
    "dev": "npm run dev:core & npm run dev:docs",
    "dev:core": "npm run dev --workspace=core",
    "dev:docs": "npm run dev --workspace=docs",
    "build": "npm run build --workspace=core",
    "build:docs": "npm run build --workspace=docs"
  }
}
