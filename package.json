{
  "name": "dgarz-design-monorepo",
  "private": true,
  "workspaces": [
    "core",
    "docs",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:core & npm run dev:docs",
    "dev:core": "npm run dev --workspace=core",
    "dev:docs": "npm run dev --workspace=docs",
    "build": "npm run build --workspace=core && npm run build:wrappers",
    "build:docs": "npm run build --workspace=docs",
    "test": "npm run test --workspace=core",
    "typecheck": "npm run typecheck --workspace=core",
    "storybook": "npm run storybook --workspace=core",
    "build:storybook": "npm run build:storybook --workspace=core",
    "verify:package": "npm run verify:package --workspace=core",
    "verify:hydrate": "npm run verify:hydrate --workspace=core",
    "verify:astro-hydrate": "npm run build:docs && npm run verify:hydrate --workspace=docs",
    "verify:next-hydrate": "npm run build --workspace=core && node scripts/verify-next-hydrate.mjs",
    "build:wrappers": "npm run build --workspace=dgarz-design-react && npm run build --workspace=dgarz-design-vue && npm run build --workspace=dgarz-design-angular",
    "verify:wrappers": "npm run build && node scripts/verify-wrappers.mjs",
    "verify:button-classes": "npm run verify:button-classes --workspace=core",
    "verify:glass": "npm run verify:glass --workspace=core",
    "check:size": "node core/scripts/check-size.mjs",
    "verify:classes": "node docs/scripts/verify-classes.mjs",
    "verify:styles": "node docs/scripts/verify-styles.mjs",
    "ci": "npm run build --workspace=core && npm test && npm run check:size && npm run verify:package && npm run verify:hydrate && npm run verify:glass && npm run verify:button-classes && node docs/scripts/copy-core.mjs && npm run build:docs:only && npm run verify:classes",
    "build:docs:only": "npm run build --workspace=docs --ignore-scripts"
  },
  "devDependencies": {
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/compiler-cli": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ng-packagr": "^20.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  }
}
